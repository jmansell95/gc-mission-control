{
  "name": "Daily Auto-Invoice Engine",
  "description": "Scans every job in 'decommissioning' or 'completed' status with approved chargeable work and no existing draft invoice, then auto-assembles a draft Invoice from that work (meterage/units/day-rate/flat-fee + costs/hotels/deliveries/approved timesheets). Emails admins a digest of drafts created. Runs daily at 07:00.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_auto_invoice_engine",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateInvoice",
            "args": {
              "all_ready": true
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateInvoice"
  }
}