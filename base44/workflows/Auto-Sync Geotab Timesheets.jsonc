{
  "name": "Auto-Sync Geotab Timesheets",
  "description": "Automatically generates draft timesheet entries from Geotab GPS vehicle location data every 30 minutes during work hours. Detects arrival/departure at job sites via geofencing and creates travel_to / on_site / travel_from entries for staff to review in their schedule.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-01T12:14:42.179000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_geotab_timesheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGeotabTimesheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
