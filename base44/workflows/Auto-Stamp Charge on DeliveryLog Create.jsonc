{
  "name": "Auto-Stamp Charge on DeliveryLog Create",
  "description": "When a delivery/collection log is created, matches the delivery type against BillingRules and stamps the charge_amount so all site deliveries are auto-priced.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "DeliveryLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_stamp_charge_on_deliverylog_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampBillingCharge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampBillingCharge"
  }
}