{
  "name": "Auto-Stamp Charge on Timesheet Create",
  "description": "When a timesheet is created, automatically matches the task description against BillingRules and stamps charge_amount + billing_rule_id so no billable task has \u00a30 revenue.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Timesheet"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_stamp_charge_on_timesheet_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampBillingCharge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampBillingCharge"
  }
}