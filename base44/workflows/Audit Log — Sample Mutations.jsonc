{
  "name": "Audit Log \u2014 Sample Mutations",
  "description": "Auto-logs every Sample create/update/delete to SystemAuditLog \u2014 chain of custody tracking for ISO 9001",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Sample"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "audit_log_sample_mutations",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logSystemAudit",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "logSystemAudit"
  }
}