{
  "name": "Auto-Stamp Client Charge on DailyCost Create",
  "description": "When a daily cost is logged, auto-calculates client_charge from amount_net \u00d7 (1 + markup%) and stamps amount_gross. Ensures every expense has a client-facing charge attached.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "DailyCost"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_stamp_client_charge_on_dailycost_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampBillingCharge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampBillingCharge"
  }
}