{
  "name": "Milestone Auto-Push on Log Approval",
  "description": "When an investigation log's review status is set to approved, auto-publish a client-visible milestone summary to the job comments and notify the project manager.",
  "trigger": {
    "condition": "${ (.trigger.data.manager_review_status == \"approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "InvestigationLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "milestone_auto_push_on_log_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushMilestoneToClient",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pushMilestoneToClient"
  }
}