{
  "name": "Auto-Stamp Charge on InvestigationLog Create",
  "description": "When an investigation log is created, automatically prices it from the project rate card or matches a BillingRule and stamps charge_amount. Ensures every borehole/sample/pit activity is revenue-captured.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "InvestigationLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_stamp_charge_on_investigationlog_create",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampBillingCharge",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampBillingCharge"
  }
}