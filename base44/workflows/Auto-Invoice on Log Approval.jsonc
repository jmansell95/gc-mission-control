{
  "name": "Auto-Invoice on Log Approval",
  "description": "When a manager approves an InvestigationLog, auto-assemble a draft Invoice for that job from all its approved chargeable work (skipped if a draft already exists). Gives immediate billing without waiting for the daily run.",
  "trigger": {
    "condition": "${ (.trigger.data.manager_review_status == \"approved\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "InvestigationLog"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_invoice_on_log_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGenerateInvoice",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGenerateInvoice"
  }
}