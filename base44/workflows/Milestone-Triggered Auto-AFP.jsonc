{
  "name": "Milestone-Triggered Auto-AFP",
  "description": "Auto-creates and populates the next AFP when a job milestone is marked complete.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "JobMilestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "milestone_triggered_auto_afp",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCreateAFPFromMilestone",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCreateAFPFromMilestone"
  }
}