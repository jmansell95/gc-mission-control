{
  "name": "Real-time Absence Push to Bob HR",
  "description": "When an absence is approved (status \u2192 approved), pushes it to Bob HR immediately instead of waiting for the nightly sync. Respects source=manual and bob_status=pending checks inside the function.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Absence"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "real_time_absence_push_to_bob_hr",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "pushAbsenceToBob",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "pushAbsenceToBob"
  }
}