{
  "name": "Daily Predictive Maintenance Auto-Booking",
  "description": "Scans every vehicle for an MOT or service date due within 14 days (or overdue) and auto-creates a 'requested' VehicleMaintenanceBooking so the office just confirms the slot. De-duplicates against existing open bookings and emails admins a digest. Runs daily at 06:30.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_predictive_maintenance_auto_booking",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoBookMaintenance",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoBookMaintenance"
  }
}