{
  "name": "AFP Auto-Sync: Timesheet (approved)",
  "description": "Real-time: when a timesheet is created/updated, rebuild the grouped labour AFP line item for its date \u2014 only approved timesheets (and approved overtime) are included; rejected/withdrawn ones are removed.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Timesheet"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "afp_auto_sync_timesheet_approved",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBillableItemToAFP",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncBillableItemToAFP"
  }
}