{
  "name": "Auto-extend Permanent Crew",
  "description": "When a job's end date is extended or the permanent crew rule changes, auto-generate rota assignments for the recurring crew's new working days.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"end_date\") != null) or (.trigger.changed_fields | index(\"permanent_crew\") != null) or (.trigger.changed_fields | index(\"start_date\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_extend_permanent_crew",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncPermanentCrew",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncPermanentCrew"
  }
}