{
  "name": "AFP Auto-Sync: JobAssetAssignment",
  "description": "Real-time: when an asset is assigned/updated on a job, rebuild the grouped plant-hire AFP line item for that asset.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "JobAssetAssignment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "afp_auto_sync_jobassetassignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncBillableItemToAFP",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncBillableItemToAFP"
  }
}