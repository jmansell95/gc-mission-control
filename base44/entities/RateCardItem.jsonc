{
  "name": "RateCardItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "labour",
        "plant",
        "materials"
      ],
      "description": "Which rate card section this item belongs to \u2014 labour (crews, mobilisation, supervision), plant (hire equipment), or materials (consumables and installations)."
    },
    "division_id": {
      "type": "string",
      "description": "The division this rate card item belongs to. Set automatically from the active division when the item is created (or when a rate card file is imported). Drives division-scoped filtering \u2014 a division only sees its own rate card / Master Price List. Blank = unassigned (visible to enterprise admins only)."
    },
    "subcategory": {
      "type": "string",
      "description": "Sub-section heading within the rate card (e.g. 'Mobilisation', 'Rotary Crews', 'Coreliner', 'HDPE', 'COVERS'). Used for grouping in the UI."
    },
    "description": {
      "type": "string",
      "description": "Item description as it appears on the schedule of rates."
    },
    "price": {
      "type": "number",
      "description": "Charge-out (sell) price in GBP \u2014 what we bill the client. Null when the price is not a simple number (POA, 'Cost + Fee', 'included in delivery rate'). This is the REVENUE side."
    },
    "price_text": {
      "type": "string",
      "description": "Raw charge-out price text when the price is not a simple number (e.g. 'POA', 'Cost + Fee', 'included in delivery rate', 'x1.5')."
    },
    "cost_price": {
      "type": "number",
      "description": "Internal cost price in GBP \u2014 what it costs US to provide this item (crew wages, equipment running costs, material purchase price). Null when not set. The financial engine uses this for all COST calculations. If blank, the engine falls back to 'price' so existing rate cards keep working."
    },
    "cost_price_text": {
      "type": "string",
      "description": "Raw internal cost text when the cost is not a simple number (e.g. 'TBC', 'varies')."
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (e.g. 'day', 'sum', 'hour', 'mile', 'week', 'each', 'm')."
    },
    "men": {
      "type": "number",
      "description": "Number of men in the crew (labour items only)."
    },
    "size": {
      "type": "string",
      "description": "Size specification (materials only, e.g. '25Kg', '10Mm')."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this rate item (inclusions, conditions, minimum hire periods)."
    },
    "rate_card_source": {
      "type": "string",
      "enum": [
        "our_company",
        "supplier"
      ],
      "default": "our_company",
      "description": "Which rate card this item belongs to. 'our_company' = your own chargeable schedule of rates (everything you supply is billed to the client using this). 'supplier' = a hire supplier's own rate card, ingested from their uploaded file."
    },
    "supplier_id": {
      "type": "string",
      "description": "Linked Supplier \u2014 set when rate_card_source is 'supplier'. Blank for your own company rate card."
    },
    "staff_id": {
      "type": "string",
      "description": "Linked Staff member \u2014 when set, this is a personal rate card for an individual (e.g. a specific driller's day rate). The auto-financials engine matches logged activities to the staff member's own rates first, then the job rate card, then the global Master Price List. Blank for crew/team rates and material/plant items that apply to everyone."
    },
    "job_id": {
      "type": "string",
      "description": "Linked Job \u2014 when set, this rate item belongs to a job-specific rate card (e.g. a particular project's schedule of rates). The linked job bills against these rates in preference to the global Master Price List. Blank for global company rate card items."
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date this rate becomes active. The rate resolver picks the rate that was effective on the job's actual working date, ensuring retrospective billing uses the correct historical rate. Blank = always effective (backward compatible with rates created before this feature)."
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Date this rate expires and is superseded by a newer version. The rate resolver skips rates that expired before the job's working date. Blank = no expiry (rate is current until explicitly superseded)."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the rate card."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rate is current and available for use."
    },
    "price_query_pending": {
      "type": "boolean",
      "default": false,
      "description": "True when a quote upload detected a price discrepancy and the billing team flagged it for query with the supplier. Surfaces as a 'price query pending' badge in the rate card manager so the team can raise it with the supplier before rectifying the stored price."
    },
    "price_query_note": {
      "type": "string",
      "description": "Note explaining the price query \u2014 the quote price that differed, the quote source, and why it's being queried. Set when price_query_pending is true."
    },
    "price_query_quote_price": {
      "type": "number",
      "description": "The unit price from the quote that differed from the stored price, captured when the query was raised so the billing team can see the discrepancy at a glance."
    },
    "price_query_raised_at": {
      "type": "string",
      "description": "ISO timestamp of when the price query was raised."
    },
    "price_query_raised_by": {
      "type": "string",
      "description": "Name of the user who raised the price query."
    }
  },
  "required": [
    "category",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}