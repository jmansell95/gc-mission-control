{
  "name": "Timesheet",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member"
    },
    "division_id": {
      "type": "string",
      "description": "The division this timesheet entry belongs to (inherited from the staff member's division). Drives division-scoped timesheet views."
    },
    "job_id": {
      "type": "string",
      "description": "Job worked on. Empty for break entries."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date worked"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Monday of the week this entry belongs to. Set automatically so entries can be grouped into a weekly timesheet for merging and payroll."
    },
    "task_description": {
      "type": "string",
      "description": "What the staff member was doing (e.g. setting up the rig, putting up heras fencing). 'Break' for break entries."
    },
    "task_duration_minutes": {
      "type": "number",
      "description": "How long the task took in minutes"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM) — optional, used by legacy time-based entries"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM) — optional, used by legacy time-based entries"
    },
    "break_minutes": {
      "type": "number",
      "default": 60,
      "description": "Break duration in minutes"
    },
    "total_hours": {
      "type": "number",
      "description": "Total hours worked (calculated from task duration or start/end times)"
    },
    "meterage": {
      "type": "number",
      "description": "Meters drilled (if applicable)"
    },
    "notes": {
      "type": "string",
      "description": "Timesheet notes"
    },
    "is_break": {
      "type": "boolean",
      "default": false,
      "description": "True for break entries. Breaks count toward the day total but NOT toward any job's time or cost."
    },
    "is_overtime": {
      "type": "boolean",
      "default": false,
      "description": "True when the staff member explicitly logged this task as overtime. The whole entry is paid at the overtime rate for its day, regardless of the weekly threshold."
    },
    "rate_multiplier": {
      "type": "number",
      "description": "Pay multiplier inherited from the rota assignment (e.g. 1.5 = time-and-a-half). Used when is_overtime is true; overrides the default day-of-week rate."
    },
    "task_type": {
      "type": "string",
      "enum": [
        "on_site",
        "travel_to",
        "travel_from",
        "inter_site_travel"
      ],
      "default": "on_site",
      "description": "Type of work entry. 'on_site' = normal task, 'travel_to' = travelling to site, 'travel_from' = travelling home from site, 'inter_site_travel' = travelling between two different job sites during the same day (chargeable to client)."
    },
    "source": {
      "type": "string",
      "enum": [
        "staff",
        "geotab_auto",
        "keylogbook"
      ],
      "default": "staff",
      "description": "How this timesheet entry was created. 'staff' = manually entered by the crew member; 'geotab_auto' = auto-generated from Geotab GPS vehicle location data (arrival/departure detection via geofencing); 'keylogbook' = parsed from the driller's KeyLogBook daily remarks."
    },
    "rota_assignment_id": {
      "type": "string",
      "description": "ID of the RotaAssignment this auto-generated timesheet is linked to. Set when source is 'geotab_auto' — the geofence arrival/departure flow creates a draft timesheet linked to the day's assignment so the two stay in sync. Used for idempotency (prevents duplicate auto-creation on repeated arrival events) and to stamp left_site_at / close the timesheet on departure."
    },
    "linked_delivery_id": {
      "type": "string",
      "description": "ID of the DeliveryLog task this entry was auto-created from. Set when a driver completes a delivery/collection — the system auto-creates a draft Timesheet entry from the delivery's actual start→complete duration. Used for idempotency (prevents duplicate creation on retry) and to render a 'Delivery' badge in the End of Shift wizard. Blank for manually-entered entries."
    },
    "is_summary": {
      "type": "boolean",
      "default": false,
      "description": "True for merged daily summary entries created by submitDailyTimesheet or approveKeyLogBookLogs. These are what managers approve."
    },
    "summary_entry_ids": {
      "type": "string",
      "description": "Comma-separated IDs of the granular entries merged into this daily summary"
    },
    "on_site_minutes": {
      "type": "number",
      "description": "For summary entries: total on-site work minutes (excludes breaks and travel)"
    },
    "travel_to_minutes": {
      "type": "number",
      "description": "For summary entries: total travel-to-site minutes"
    },
    "travel_from_minutes": {
      "type": "number",
      "description": "For summary entries: total travel-from-site minutes"
    },
    "payable_travel_minutes": {
      "type": "number",
      "description": "For summary entries: travel minutes payable after the 1.5h deductible (0 for depot teams or travel under 1.5h)"
    },
    "travel_depart_home": {
      "type": "string",
      "description": "Time departed home (HH:MM) — from the travel_to entry"
    },
    "travel_arrive_site": {
      "type": "string",
      "description": "Time arrived on site (HH:MM) — from the travel_to entry"
    },
    "travel_depart_site": {
      "type": "string",
      "description": "Time departed site (HH:MM) — from the travel_from entry"
    },
    "travel_arrive_home": {
      "type": "string",
      "description": "Time arrived home (HH:MM) — from the travel_from entry"
    },
    "is_weekly_summary": {
      "type": "boolean",
      "default": false,
      "description": "True for the single merged weekly record created by mergeWeeklyTimesheet. One per staff per week — aggregates all approved daily summaries so the week can be downloaded as one payroll document."
    },
    "weekly_entry_ids": {
      "type": "string",
      "description": "For weekly summaries: comma-separated IDs of the daily summary entries merged into this weekly record."
    },
    "weekly_total_minutes": {
      "type": "number",
      "description": "For weekly summaries: total payable minutes across the whole week (on-site + payable travel)."
    },
    "weekly_standard_minutes": {
      "type": "number",
      "description": "For weekly summaries: minutes paid at standard rate (below the overtime threshold)."
    },
    "weekly_overtime_minutes": {
      "type": "number",
      "description": "For weekly summaries: minutes paid at overtime rate (above the weekly threshold or flagged is_overtime)."
    },
    "weekly_meterage": {
      "type": "number",
      "description": "For weekly summaries: total metres drilled across the week."
    },
    "approved_by_name": {
      "type": "string",
      "description": "Name of the manager who approved this timesheet"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "auto_submitted",
        "approved",
        "rejected",
        "deleted",
        "merged"
      ],
      "default": "submitted",
      "description": "Timesheet approval status. 'draft' = still being edited or auto-build couldn't find enough data, 'submitted' = awaiting manager review, 'auto_submitted' = auto-built with high confidence and eligible for green-path auto-approval, 'approved'/'rejected' = manager decision, 'deleted' = withdrawn by staff, 'merged' = daily summary merged into a weekly record (no longer individually approvable)."
    },
    "deletion_reason": {
      "type": "string",
      "description": "Reason given by staff when withdrawing/deleting a submitted timesheet (visible to manager & admin)"
    },
    "deleted_at": {
      "type": "string",
      "description": "ISO timestamp when the timesheet was withdrawn"
    },
    "withdrawal_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether the manager has acknowledged this staff withdrawal"
    },
    "withdrawal_acknowledged_by": {
      "type": "string",
      "description": "Name of the manager who acknowledged the withdrawal"
    },
    "withdrawal_acknowledged_at": {
      "type": "string",
      "description": "ISO timestamp of when the withdrawal was acknowledged"
    },
    "chargeable": {
      "type": "boolean",
      "default": false,
      "description": "Whether this task is chargeable to the client. Set to true by the system when a matching BillingRule is found."
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule that matched this task description — used to calculate the client charge"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated client charge in GBP for this task (set by calculateCharge)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated"
    },
    "payroll_export_id": {
      "type": "string",
      "description": "Payroll batch export ID — set when this timesheet is exported to the payroll provider. Locks the record from re-export."
    },
    "payroll_exported_at": {
      "type": "string",
      "description": "ISO timestamp when this timesheet was exported to payroll."
    },
    "auto_built": {
      "type": "boolean",
      "default": false,
      "description": "True when this daily summary was auto-built by the autoBuildDailyTimesheets function (zero-touch timesheet engine) rather than manually submitted by the staff member. Drives the confidence-sorted manager approval queue."
    },
    "auto_built_sources": {
      "type": "string",
      "description": "Comma-separated data sources used to auto-build this summary (e.g. 'gps,keylogbook,delivery,mitti,rota'). Shown as source badges in the manager confidence queue so they can see at a glance what data backed the auto-built timesheet."
    },
    "confidence_score": {
      "type": "number",
      "description": "Confidence score (0-100) for auto-built timesheets. 80+ = green path (auto-approve eligible), 40-79 = review needed, <40 = missing data (staff nudge). Calculated from how many data sources corroborated the entry: GPS arrival + KeyLogBook logs + Mitti verification = high confidence; GPS only or rota-only = low confidence."
    },
    "auto_approved_at": {
      "type": "string",
      "description": "ISO timestamp when this summary was auto-approved by the green-path engine. Set when the greenPathApproveTimesheet function auto-approves a high-confidence non-overtime summary. Used to populate the 'Auto-approved today' strip and determine undo eligibility."
    },
    "auto_approved_until": {
      "type": "string",
      "description": "ISO timestamp of the undo-window expiry (auto_approved_at + 24h). While now < auto_approved_until, the manager can tap Undo to revert the entry to 'submitted' for manual review. After expiry the entry stays approved."
    },
    "overtime_pending": {
      "type": "boolean",
      "default": false,
      "description": "True when this summary contains overtime hours (is_overtime or weekly_overtime_minutes > 0) and needs explicit line-manager approval before it can be merged for payroll. Green-path auto-approval never fires when this is true."
    },
    "overtime_approved_by": {
      "type": "string",
      "description": "Name of the line manager who explicitly approved the overtime on this summary. Stamped when the manager taps 'Approve Overtime' on the card."
    },
    "overtime_approved_at": {
      "type": "string",
      "description": "ISO timestamp of when the line manager approved the overtime. Audit trail for the overtime sign-off."
    }
  },
  "required": [
    "staff_id",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
