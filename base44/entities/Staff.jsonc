{
  "name": "Staff",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Staff member full name"
    },
    "division_id": {
      "type": "string",
      "description": "The business stream this staff member belongs to. Set from the Business Stream selector in the staff edit form (the single source of truth for division-scoped RLS). Kept as a denormalized cache so RLS rules (which reference data.division_id) continue to work."
    },
    "email": {
      "type": "string",
      "description": "Staff member email address"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Staff member date of birth. Used for training records, age verification, and birthday alerts (the daily birthday automation surfaces a banner on the staff's birthday). Admin-only field \u2014 not shown to the staff member themselves."
    },
    "ni_number": {
      "type": "string",
      "description": "National Insurance Number. Used for CIS verification, payroll, and training compliance. Format: 2 letters, 6 digits, 1 letter (e.g. 'AB123456C'). Admin-only field."
    },
    "phone": {
      "type": "string",
      "description": "Staff member phone number"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL \u2014 uploaded by the staff member via the profile editor or the first-login onboarding screen. Displayed in the admin sidebar and profile header."
    },
    "worker_type": {
      "type": "string",
      "enum": [
        "direct_employee",
        "subcontractor",
        "agency"
      ],
      "description": "Type of worker"
    },
    "agency_id": {
      "type": "string",
      "description": "Linked Contractor (Agency) record \u2014 set when worker_type is 'agency'. Identifies which agency company supplies this labourer so payroll and financials can be grouped by supplier."
    },
    "company": {
      "type": "string",
      "description": "The company this external worker is from (subcontractor firm or agency name). Captured during the minimal Market Dojo onboarding in the Staff Hub Contacts tab. Blank for direct employees."
    },
    "crew_parent_id": {
      "type": "string",
      "description": "For individual subcontractor drillers (Lead Driller / Second Man): the Staff ID of the parent subcontractor company record this person belongs to. When set, this Staff record is an individual crew member \u2014 it is hidden from the Contacts tab list (which shows only parent company records) and appears instead as a crew pairing on the parent's card and the rota sub-line. Blank for parent company records, direct employees, and agency workers."
    },
    "job_title": {
      "type": "string",
      "description": "Staff member's job title / role (e.g. 'Cable Percussion Driller', 'Groundworker'). Derived from the crew section during spreadsheet import."
    },
    "lead_driller_name": {
      "type": "string",
      "description": "Lead Driller name for this subcontractor or agency crew. Captured in the Staff Hub Contacts tab Add/Edit modal. Shown as a sub-line on the rota grid and job details page. Blank for direct employees."
    },
    "lead_driller_phone": {
      "type": "string",
      "description": "Lead Driller mobile phone number. Captured alongside lead_driller_name. Shown on the job details Subcontractors card."
    },
    "second_man_name": {
      "type": "string",
      "description": "Second Man Driller name for this subcontractor or agency crew. Captured in the Staff Hub Contacts tab Add/Edit modal. Shown as a sub-line on the rota grid and job details page. Blank for direct employees."
    },
    "second_man_phone": {
      "type": "string",
      "description": "Second Man Driller mobile phone number. Captured alongside second_man_name. Shown on the job details Subcontractors card."
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Contact person name"
          },
          "role": {
            "type": "string",
            "description": "Contact role/job title (e.g. Operations Director, Site Agent)"
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number"
          },
          "email": {
            "type": "string",
            "description": "Contact email address"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about this contact"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "All contacts for this subcontractor/agency worker \u2014 managed via the address book popup in the Staff Hub Contacts tab. Each entry has name, role, phone, email, notes."
    },
    "team_id": {
      "type": "string",
      "description": "Team/group assignment \u2014 determines which jobs this staff member can be assigned to AND which division they belong to (division is inherited from the team)."
    },
    "training_category_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of TrainingRequirement records assigned to this staff member. This is the single source of truth for which training categories apply to this person \u2014 it replaces the old team-level required_qualifications model. When empty, the person has no training categories assigned (shown as 'not assigned', not as gaps). Add categories via the Training Hub card/drawer/bulk manager."
    },
    "permission_group_id": {
      "type": "string",
      "description": "Direct permission group assignment \u2014 controls this staff member's access to every admin module and settings page. This is the single source of truth for access (no longer inherited from the team). Manage groups in Settings \u2192 Access Levels."
    },
    "default_landing_page": {
      "type": "string",
      "enum": [
        "/admin",
        "/staff-schedule",
        "/staff-profile",
        "/deliveries",
        "/scanner",
        "/subcontractor"
      ],
      "description": "Where this staff member lands after login. When set, this overrides the role-based default. Blank = auto (derived from the permission group / role). Chosen per-staff at creation or edit."
    },
    "default_vehicle_id": {
      "type": "string",
      "description": "Default vehicle assignment"
    },
    "drilling_crew_id": {
      "type": "string",
      "description": "Assigned drilling crew (if applicable)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether staff member is active"
    },
    "user_id": {
      "type": "string",
      "description": "Linked user account ID for login access"
    },
    "manager_id": {
      "type": "string",
      "description": "Staff member who approves this person's timesheets"
    },
    "invite_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether an app invite email has been sent to this staff member"
    },
    "email_notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this staff member receives automated schedule and assignment emails. When false, the system skips sending them weekly schedules, daily reminders, and assignment notifications."
    },
    "delivery_dashboard_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this staff member can access the Delivery Dashboard. When false, the Deliveries button is hidden and the route redirects them back to their schedule."
    },
    "system_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "management",
        "user",
        "field",
        "read_only"
      ],
      "default": "field",
      "description": "Legacy app-level access role. Now derived from the assigned permission group. Kept for backward compatibility \u2014 use permission_group_id instead."
    },
    "last_acknowledged_week": {
      "type": "string",
      "format": "date",
      "description": "Week start (Monday) of the last rota the staff member acknowledged via the schedule splash screen"
    },
    "schedule_acknowledged_at": {
      "type": "string",
      "description": "ISO timestamp of when the staff member last acknowledged their weekly schedule"
    },
    "phone_gps_consent": {
      "type": "boolean",
      "default": false,
      "description": "Legacy consent flag. Kept for backward compatibility. Use tracking_enabled (the master toggle) and tracking_consent_signed_at (the signed consent form) instead."
    },
    "tracking_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for GPS location tracking during working hours. When true (default), the app tracks the crew member's GPS location during their shift \u2014 from the moment they start travelling to site until they arrive home \u2014 covering home\u2192site, on-site, site\u2192home, and inter-site travel. Staff can turn this off in their profile at any time (e.g. of an evening). When false, all GPS tracking stops immediately. Separate from the consent form signature (tracking_consent_signed_at) \u2014 tracking starts on by default but staff must sign the consent form to keep it active; if they explicitly decline, tracking_enabled flips to false."
    },
    "home_lat": {
      "type": "number",
      "description": "Learned home location latitude. Auto-learned from repeated overnight GPS positions after the staff member confirms their home location 3+ times. Used by the zero-touch timesheet engine to calculate travel-from-site duration (home \u2192 site and site \u2192 home) for payable travel time. Blank until the first confirmation is captured."
    },
    "home_lng": {
      "type": "number",
      "description": "Learned home location longitude. Auto-learned alongside home_lat. Used for travel-from-site geofence detection \u2014 when the crew member's phone GPS enters this radius, the system stamps 'arrived home' and closes the travel-from entry."
    },
    "home_geofence_confidence": {
      "type": "number",
      "default": 0,
      "description": "Number of times the home location has been corroborated by the crew member confirming 'I'm home' at roughly the same GPS position. 0 = not yet learned, 1-2 = candidate (still confirming), 3+ = confirmed (high confidence, used for auto travel-from detection). Incremented by the confirmHomeLocation function when a new confirmation is within 200m of the existing home_lat/lng."
    },
    "home_learned_at": {
      "type": "string",
      "description": "ISO timestamp of the last home location confirmation. Set every time the crew member confirms their home position, whether it incremented confidence or established a new candidate."
    },
    "market_dojo_onboarded": {
      "type": "boolean",
      "default": false,
      "description": "True when this subcontractor or agency worker has been onboarded in Market Dojo (the external onboarding/compliance system). Ticked manually by the manager after onboarding is completed outside this system. Shown as a green-tick pill (onboarded) or red-cross pill (not onboarded) on contact cards and the edit modal."
    },
    "market_dojo_onboarded_at": {
      "type": "string",
      "description": "ISO timestamp of when the manager ticked 'Onboarded in Market Dojo' for this worker."
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "True once the staff member has completed the first-login profile setup screen (photo + phone). When false, Home.jsx routes them to /onboarding instead of their landing page so new invitees finish their profile before entering the app. Existing staff are backfilled to true so only genuinely new users see the gate."
    },
    "tracking_consent_signed_at": {
      "type": "string",
      "description": "ISO timestamp of when the staff member signed the GPS tracking consent form, acknowledging that their location is tracked during working hours. Required to keep tracking enabled \u2014 if a staff member explicitly declines, tracking_enabled flips to false."
    },
    "tracking_consent_signature_data_url": {
      "type": "string",
      "description": "Base64 PNG data URL of the staff member's drawn signature on the GPS tracking consent form. Captured via the SignaturePad component so there is a legally defensible audit trail for location tracking."
    },
    "tracking_consent_version": {
      "type": "string",
      "default": "v1_2026",
      "description": "Version of the tracking consent agreement the staff member signed. When the consent text is updated, this version is bumped so staff are re-prompted to sign the new version."
    },
    "tracking_consent_declined_at": {
      "type": "string",
      "description": "ISO timestamp of when the staff member explicitly declined the GPS tracking consent. When set, tracking_enabled is flipped to false and the consent reminders stop. Cleared if the staff member later signs the consent form."
    }
  },
  "required": [
    "name",
    "worker_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}