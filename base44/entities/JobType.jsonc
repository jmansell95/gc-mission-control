{
  "name": "JobType",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Unique slug key stored on jobs (e.g. groundworks, cp_drilling, piling). Auto-generated from the label if not set manually."
    },
    "label": {
      "type": "string",
      "description": "Display name shown on the template chips in the job wizard and on badges across the app."
    },
    "color": {
      "type": "string",
      "enum": [
        "emerald",
        "amber",
        "blue",
        "purple",
        "slate",
        "rose",
        "teal",
        "orange"
      ],
      "default": "slate",
      "description": "Colour theme used for badges, dots and bars across the app."
    },
    "is_drilling": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a drilling job type \u2014 shows meterage fields on jobs and enables drilling cost calculations."
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the wizard chip list (lower = first). Managed via the up/down arrows in the Job Type Manager."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this template appears in the job wizard. Inactive templates are hidden from the picker but can be re-enabled from the manager."
    },
    "division_id": {
      "type": "string",
      "description": "The business stream this template belongs to. Blank = company-wide (visible to all streams in the wizard). Set to a division ID to scope it to that stream only. Managed via the Job Type Manager inside the job wizard."
    },
    "default_revenue_method": {
      "type": "string",
      "enum": [
        "none",
        "day_rate",
        "meterage_rate",
        "unit_rate",
        "flat_fee"
      ],
      "default": "none",
      "description": "Template default \u2014 pre-fills the billing method when a new job is created from this type."
    },
    "default_drilling_method": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "mixed",
        "not_applicable"
      ],
      "default": "not_applicable",
      "description": "Template default \u2014 pre-fills the drilling method when a new job is created from this type."
    },
    "default_markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Template default \u2014 pre-fills the markup % when revenue method is 'none' (markup on cost)."
    },
    "default_budget_amount": {
      "type": "number",
      "description": "Template default \u2014 pre-fills the job budget (GBP) when a new job is created from this type."
    },
    "default_duration_days": {
      "type": "number",
      "description": "Template default \u2014 when set, the job end date is auto-calculated as start date + this many days."
    },
    "default_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Template default \u2014 pre-selects these teams when a new job is created from this type."
    },
    "default_notes": {
      "type": "string",
      "description": "Template default \u2014 pre-fills the job notes field with standard scope or requirements text."
    }
  },
  "required": [
    "key",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}