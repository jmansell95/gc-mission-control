{
  "name": "RotaAssignment",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Assigned job. Blank for non-job assignments (annual_leave, sick, training, yard_depot)."
    },
    "division_id": {
      "type": "string",
      "description": "The division this rota assignment belongs to (inherited from the staff member's division). Drives division-scoped rota views."
    },
    "staff_id": {
      "type": "string",
      "description": "Assigned staff member"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "Date of assignment (working date)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle assignment for this job"
    },
    "rig_asset_id": {
      "type": "string",
      "description": "Drilling rig (SiteAsset) assigned to this shift. For drilling jobs, the crew is formed dynamically by the rig \u2014 not by a static crew number. The Lead Driller and Second Man assigned to the same rig on the same date form the drilling crew. This links the rota assignment to the specific rig for utilisation and cost tracking."
    },
    "crew_pairing_id": {
      "type": "string",
      "description": "Links a 2-man drilling crew (Lead Driller + Second Man) assigned together to the same rig on the same job. Set by the Crew-Rig assignment flow \u2014 both crew members' RotaAssignment entries share the same crew_pairing_id so they move as a unit when the rig is swapped. Blank for non-drilling assignments and legacy single-staff assignments."
    },
    "crew_role": {
      "type": "string",
      "enum": [
        "lead_driller",
        "second_man"
      ],
      "description": "This crew member's role within the crew_pairing. 'lead_driller' = the Lead Driller operating the rig; 'second_man' = the Second Man driller on the same rig. Blank for non-drilling assignments and legacy assignments. Used by the Rig Performance widget to show 'Lead: X \u00b7 Second: Y' per rig."
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the week for this rota entry"
    },
    "assignment_type": {
      "type": "string",
      "enum": [
        "job",
        "annual_leave",
        "sick",
        "training",
        "yard_depot"
      ],
      "default": "job",
      "description": "Type of day. 'job' = normal job assignment (requires job_id), 'annual_leave' = annual leave/holiday/day off (Off, Golf day, Holiday, AL), 'sick' = sick leave, 'training' = training course day, 'yard_depot' = yard/depot duty (non-billable \u2014 staff are on the bench at the depot/yard, available for reassignment to jobs or delivery legs). Non-job types have no job_id."
    },
    "non_job_label": {
      "type": "string",
      "description": "Original cell text from the planner for non-job days (e.g. 'Off', 'Golf day', 'Training course - First Aid', 'Yard', 'Depot'). Stored for audit/display so managers can see exactly what was written in the spreadsheet."
    },
    "has_conflict": {
      "type": "boolean",
      "default": false,
      "description": "True when this assignment conflicts with another assignment on the same date \u2014 the staff member is double-booked (e.g. assigned to a job AND yard/depot on the same day, or two different jobs on the same day). Set by the Global Rota Registry conflict detector during import."
    },
    "conflict_note": {
      "type": "string",
      "description": "Human-readable description of the conflict (e.g. 'Assigned to EWR and Yard/Depot on 2026-08-06'). Shown as a warning in the rota builder and dashboard."
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "started",
        "completed"
      ],
      "default": "assigned",
      "description": "Assignment check-in status"
    },
    "started_at": {
      "type": "string",
      "description": "Timestamp when staff started the job"
    },
    "completed_at": {
      "type": "string",
      "description": "Timestamp when staff completed the job"
    },
    "arrived_on_site_at": {
      "type": "string",
      "description": "Timestamp when staff confirmed arrival on site (travel-to-site logged). The first step of the daily workflow \u2014 set before the briefing/induction can begin."
    },
    "left_site_at": {
      "type": "string",
      "description": "Timestamp when staff recorded that they've left site at the end of work. The job stays open (status 'started') for up to 5 hours so they can enter their travel-home time and review/submit their timesheet when they get home."
    },
    "early_leave_reason": {
      "type": "string",
      "description": "Reason recorded when a staff member leaves site before the end of the shift. One of the predefined quick-select reasons or a custom reason entered by the staff member."
    },
    "early_leave_note": {
      "type": "string",
      "description": "Additional note explaining an early departure (e.g. appointment time, symptoms, client contact who approved it)."
    },
    "early_leave_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Approval status for an early-leave request. 'pending' = staff has requested to leave early (e.g. Friday travel home, client-approved early finish) and is awaiting manager sign-off. 'approved' = manager has approved with signature. 'rejected' = manager rejected the request. Blank/null = no early-leave request submitted."
    },
    "early_leave_approved_by": {
      "type": "string",
      "description": "Name of the manager who approved or rejected the early-leave request."
    },
    "early_leave_approved_at": {
      "type": "string",
      "description": "ISO timestamp of when the manager approved or rejected the early-leave request."
    },
    "early_leave_approval_signature": {
      "type": "string",
      "description": "Base64 PNG data URL of the manager's drawn signature approving the early-leave request. Captured via the SignaturePad component so there is a signed audit trail for the reduced hours."
    },
    "monday_travel_to_site_minutes": {
      "type": "number",
      "default": 0,
      "description": "Travel time in minutes from home to site on Monday (long-distance travel after the weekend). Logged by the field staff member and incorporated into their 9-hour day. Shown on the timesheet as payable travel time."
    },
    "friday_travel_home_minutes": {
      "type": "number",
      "default": 0,
      "description": "Travel time in minutes from site/digs to home on Friday (long-distance travel home for the weekend). Logged by the field staff member and incorporated into their 9-hour day. Shown on the timesheet as payable travel time."
    },
    "briefing_signed": {
      "type": "boolean",
      "default": false,
      "description": "Whether staff signed off on the job briefing"
    },
    "briefing_signed_at": {
      "type": "string",
      "description": "Timestamp when briefing was signed (end of briefing)"
    },
    "briefing_start_at": {
      "type": "string",
      "description": "Timestamp when staff opened the briefing (start of briefing)"
    },
    "start_time": {
      "type": "string",
      "description": "Shift start time (HH:MM format)"
    },
    "end_time": {
      "type": "string",
      "description": "Shift end time (HH:MM format)"
    },
    "shift_status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "declined"
      ],
      "default": "pending",
      "description": "Staff confirmation status for this shift"
    },
    "is_overtime": {
      "type": "boolean",
      "default": false,
      "description": "True when this is an overtime shift (typically a weekend shift). The whole shift is paid at the overtime rate."
    },
    "rate_multiplier": {
      "type": "number",
      "description": "Pay multiplier for this overtime shift (e.g. 1.5 = time-and-a-half, 2.0 = double time). Falls back to the default OvertimeRate for the day when not set."
    },
    "work_weekends": {
      "type": "boolean",
      "default": false,
      "description": "True when this assignment explicitly includes weekend (Sat/Sun) working days. Set per-assignment in the AssignmentModal 'Work weekends' toggle. When false (default), multi-day assignment generation skips Saturdays and Sundays for this crew member. The rota grid still hides weekend columns unless the view-level weekend toggle is on."
    },
    "start_delayed": {
      "type": "boolean",
      "default": false,
      "description": "True when the job started later than its planned start date \u2014 captured during assignment so managers can track delays."
    },
    "actual_start_date": {
      "type": "string",
      "format": "date",
      "description": "Actual date the job started on site \u2014 recorded when the job was delayed from its planned start date"
    },
    "meterage": {
      "type": "number",
      "description": "Meters drilled (for drilling crews, recorded at job completion)"
    },
    "progress_notes": {
      "type": "string",
      "description": "End-of-shift progress notes for multi-day jobs \u2014 visible to management and the next shift"
    },
    "daily_checks_completed": {
      "type": "boolean",
      "default": false,
      "description": "True when the crew member has completed the daily pre-work checklist (vehicle walk-round, plant/power, PPE checks) in the ShiftWizard. Gates the shift \u2014 the Arrive step is blocked until this is true. The checks are completed in Mitti first, then confirmed here."
    },
    "daily_checks_completed_at": {
      "type": "string",
      "description": "ISO timestamp of when the daily pre-work checklist was confirmed complete."
    },
    "mitti_vehicle_check_at": {
      "type": "string",
      "description": "ISO timestamp auto-stamped when a Mitti/SafetyCulture vehicle-check audit is received for this staff member on this assignment's date. When set, the ShiftWizard Checks step shows a live green 'verified by Mitti' badge. When Mitti is connected, this gates the Arrive step \u2014 crew cannot proceed until the vehicle check is verified (or they manually confirm if Mitti is not connected)."
    },
    "mitti_powra_at": {
      "type": "string",
      "description": "ISO timestamp auto-stamped when a Mitti/SafetyCulture POWRA audit is received for this staff member + job on this assignment's date. When set, the Arrive step shows a live green 'POWRA verified by Mitti' badge. When Mitti is connected, this gates the start-work step."
    },
    "mitti_equipment_check_at": {
      "type": "string",
      "description": "ISO timestamp auto-stamped when a Mitti/SafetyCulture equipment/plant-check audit is received for this staff member on this assignment's date. Shown as a verified badge in the briefing step."
    },
    "notes": {
      "type": "string",
      "description": "Staff notes for this assignment"
    },
    "arrived_home_at": {
      "type": "string",
      "description": "ISO timestamp when the crew member arrived home after leaving site. Auto-stamped by the smart GPS geofence when they enter the home geofence (or hotel geofence for away jobs). Used to calculate travel-from-site duration and close the day's tracking window."
    },
    "inter_site_travel_minutes": {
      "type": "number",
      "default": 0,
      "description": "Total minutes spent travelling between different job sites during this assignment's day (e.g. Site A \u2192 Site B). Auto-calculated by the geofence engine from inter-site transitions. Chargeable to the client."
    },
    "end_of_day_signature_data_url": {
      "type": "string",
      "description": "Base64 PNG data URL of the crew member's drawn signature at the end of the shift, confirming their tracked hours, travel times, and tasks are accurate. Captured in the EndOfShiftWizard as the final step before submission."
    },
    "end_of_day_signed_at": {
      "type": "string",
      "description": "ISO timestamp of when the crew member signed the end-of-day declaration. Gates timesheet submission \u2014 the shift cannot be submitted without this signature."
    }
  },
  "required": [
    "staff_id",
    "assigned_date",
    "week_start"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}