{
  "name": "VehicleMaintenanceBooking",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle this booking is for"
    },
    "vehicle_name": {
      "type": "string",
      "description": "Vehicle name/reg (for display)"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "mot",
        "service",
        "windscreen",
        "tyre_repair",
        "breakdown",
        "repair",
        "fuel_card",
        "inspection",
        "risk_master",
        "other"
      ],
      "description": "Type of maintenance booking. 'breakdown' = vehicle broken down / roadside assistance needed. 'fuel_card' = fuel card issue / replacement / query. 'tyre_repair' = tyre replacement or puncture repair. 'risk_master' = Risk Master assistance (Holman risk management service). 'inspection' = general vehicle inspection / audit."
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "booked",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "requested",
      "description": "Booking status. 'requested' = needs to be called in to the provider, 'booked' = confirmed with date/time, 'completed' = work done."
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the booking appointment"
    },
    "booking_time": {
      "type": "string",
      "description": "Time of the booking appointment (HH:MM)"
    },
    "supplier_id": {
      "type": "string",
      "description": "Linked Supplier record for the maintenance provider handling this booking (Holman, tyre specialist, etc.). Set when a provider is picked from the dropdown in the booking modal."
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier/garage name (e.g. Holman)"
    },
    "supplier_phone": {
      "type": "string",
      "description": "Supplier contact phone number"
    },
    "location": {
      "type": "string",
      "description": "Garage/venue address"
    },
    "assigned_staff_id": {
      "type": "string",
      "description": "Staff member assigned to take the vehicle in"
    },
    "assigned_staff_name": {
      "type": "string",
      "description": "Assigned staff name (for display)"
    },
    "reported_by_staff_id": {
      "type": "string",
      "description": "Staff member who reported the breakdown / repair need / called it in. Tracks accountability \u2014 shows who first flagged the issue on the vehicle history."
    },
    "reported_by_staff_name": {
      "type": "string",
      "description": "Name of the staff member who reported this (denormalised for display)"
    },
    "reported_at": {
      "type": "string",
      "description": "ISO timestamp of when the issue was reported / the call was made to the provider."
    },
    "report_source": {
      "type": "string",
      "enum": [
        "phone_call",
        "staff_portal",
        "holman_sync",
        "admin"
      ],
      "default": "admin",
      "description": "How this booking was logged. 'phone_call' = admin logged a call made to the provider over the phone, 'staff_portal' = crew member reported it from their schedule, 'holman_sync' = pulled from Holman automatically, 'admin' = created directly in the dashboard."
    },
    "logged_by_name": {
      "type": "string",
      "description": "Name of the admin user who logged this booking (denormalised from created_by for quick display)."
    },
    "cost": {
      "type": "number",
      "description": "Cost of the maintenance work in GBP"
    },
    "notes": {
      "type": "string",
      "description": "Notes about the booking (e.g. work required, access details)"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp when the booking was completed"
    }
  },
  "required": [
    "vehicle_id",
    "booking_type",
    "booking_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}