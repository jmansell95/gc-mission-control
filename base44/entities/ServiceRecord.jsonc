{
  "name": "ServiceRecord",
  "type": "object",
  "properties": {
    "site_asset_id": {
      "type": "string",
      "description": "SiteAsset this service/inspection record belongs to."
    },
    "record_type": {
      "type": "string",
      "enum": [
        "loler_inspection",
        "puwer_inspection",
        "pat_inspection",
        "service",
        "repair",
        "calibration",
        "pre_use_check",
        "other"
      ],
      "default": "service",
      "description": "Type of record. 'loler_inspection' = statutory LOLER thorough examination (lifting equipment), 'puwer_inspection' = PUWER work equipment inspection, 'pat_inspection' = Portable Appliance Testing (PAT) of portable electrical equipment (110V transformers, power tools, leads), 'service' = routine maintenance, 'repair' = fault repair, 'calibration' = instrument calibration, 'pre_use_check' = daily/pre-use check, 'other'."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the inspection/service/repair was carried out."
    },
    "result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "advisory",
        "n/a"
      ],
      "default": "pass",
      "description": "Outcome of the inspection. 'pass' = safe to use, 'fail' = defective/withdrawn from service, 'advisory' = passed with observations, 'n/a' = not applicable (routine service/repair)."
    },
    "tested_by": {
      "type": "string",
      "description": "Name of the person who carried out the inspection/service."
    },
    "company": {
      "type": "string",
      "description": "Testing/inspection company or workshop (e.g. 'LOLER Inspections Ltd', 'In-house fitter')."
    },
    "certificate_url": {
      "type": "string",
      "description": "URL of the uploaded report of thorough examination / service certificate (LOLER reg 9 report)."
    },
    "certificate_name": {
      "type": "string",
      "description": "Original filename of the uploaded certificate."
    },
    "resulting_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "New compliance expiry date set by this inspection (the date the next LOLER/PAT test is due). The most recent record's resulting_expiry_date drives the asset's compliance_expiry_date."
    },
    "notes": {
      "type": "string",
      "description": "Findings, defects noted, parts replaced, observations."
    },
    "consumables_cost": {
      "type": "number",
      "default": 0,
      "description": "Total cost of consumables (grease, spray cans, parts from warehouse stock) used during this service/repair. Auto-calculated by the commitConsumableUsage function as each consumable is logged."
    },
    "consumables_summary": {
      "type": "string",
      "description": "Human-readable line-by-line summary of consumables used on this repair (e.g. '1\u00d7 Grease Spray @ \u00a34.50/each = \u00a34.50 \u2014 greased bearing'). Appended to by commitConsumableUsage each time a consumable is logged."
    },
    "imported_from_gc": {
      "type": "boolean",
      "default": false,
      "description": "True when this record was seeded from the GC Compliance Manager's last-test data during the one-time import, rather than created directly in this app."
    },
    "pat_appliance_class": {
      "type": "string",
      "enum": [
        "class_I",
        "class_II",
        "class_III",
        "extension_lead",
        "n/a"
      ],
      "default": "n/a",
      "description": "Appliance class for PAT testing. 'class_I' = earthed equipment (metal casing, needs earth continuity), 'class_II' = double-insulated (no earth), 'class_III' = extra-low voltage (110V SELV), 'extension_lead' = IEC lead / extension reel, 'n/a' = not a PAT record."
    },
    "pat_visual_pass": {
      "type": "boolean",
      "default": true,
      "description": "PAT visual inspection result \u2014 plug, fuse, cable, casing checked by eye. False when a visual defect was found (damaged cable, cracked plug, wrong fuse)."
    },
    "pat_earth_continuity": {
      "type": "number",
      "description": "PAT earth continuity test reading in ohms (\u03a9). Class I appliances only \u2014 resistance between earth pin and exposed metal casing. Pass threshold typically <0.1\u03a9 (KEWPAT auto-evaluates). Null for Class II (no earth)."
    },
    "pat_insulation_resistance": {
      "type": "number",
      "description": "PAT insulation resistance test reading in megohms (M\u03a9). Measured at 500V test voltage. Pass threshold typically >1.0 M\u03a9 for Class I, >2.0 M\u03a9 for Class II. Null if not tested."
    },
    "pat_load_current": {
      "type": "number",
      "description": "PAT load / leakage current reading in milliamps (mA). Operational leakage current under load. Pass threshold typically <3.5 mA. Null if not tested."
    },
    "pat_leakage_current": {
      "type": "number",
      "description": "PAT touch leakage current reading in milliamps (mA). Null if not tested."
    },
    "pat_lead_polarity": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "n/a"
      ],
      "default": "n/a",
      "description": "Lead polarity check result for IEC leads / extension reels. 'pass' = wiring correct, 'fail' = crossed/missing conductors, 'n/a' = not a lead."
    },
    "pat_tester_serial": {
      "type": "string",
      "description": "Serial number of the KEWPAT tester used for this test (for calibration traceability)."
    }
  },
  "required": [
    "site_asset_id",
    "record_type",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}