{
  "name": "BriefingSignature",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "description": "The RotaAssignment this signature belongs to"
    },
    "staff_id": {
      "type": "string",
      "description": "Staff member who signed"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (for audit display)"
    },
    "job_id": {
      "type": "string",
      "description": "Job this briefing was for"
    },
    "assigned_date": {
      "type": "string",
      "format": "date",
      "description": "The working date of the assignment"
    },
    "signature_url": {
      "type": "string",
      "description": "URL of the uploaded signature image (PNG)"
    },
    "signed_at": {
      "type": "string",
      "description": "ISO timestamp when the briefing was signed"
    },
    "induction_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the crew member confirmed the site induction was completed (one-time, third-party induction on first day at this site)"
    },
    "induction_completed_at": {
      "type": "string",
      "description": "ISO timestamp when induction confirmation was recorded"
    },
    "induction_completed_by": {
      "type": "string",
      "description": "Name of the third-party person who carried out the site induction (recorded for our records only). Entered by the staff member on their first day at a new site."
    },
    "daily_agenda_notes": {
      "type": "string",
      "description": "Today's daily agenda brief \u2014 what's the plan, any blockers, and what's left to sort out. Recorded each day as part of the daily briefing."
    },
    "document_ids_reviewed": {
      "type": "string",
      "description": "Comma-separated IDs of briefing documents the crew member reviewed before signing"
    },
    "briefing_duration_minutes": {
      "type": "number",
      "description": "Minutes between briefing start and sign-off"
    },
    "synced_from_offline": {
      "type": "boolean",
      "default": false,
      "description": "True if this signature was captured while offline and synced later"
    }
  },
  "required": [
    "assignment_id",
    "staff_id",
    "job_id",
    "signature_url",
    "signed_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}