{
  "name": "JobCostItem",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Associated job"
    },
    "category": {
      "type": "string",
      "enum": [
        "internal_equipment",
        "hired_equipment",
        "purchased_equipment",
        "contractor_supplied",
        "client_supplied",
        "labour"
      ],
      "default": "hired_equipment",
      "description": "How this item reaches site. 'internal_equipment' = owned by you (priced from the Master Price List), 'hired_equipment' = hired from a supplier, 'purchased_equipment' = bought for the job (requires PO number and order slip), 'contractor_supplied' = supplied by the contractor (no cost/logistics), 'client_supplied' = supplied by the client and delivered to site (informational only \u2014 no cost or charge), 'labour' = billable crew member from the Master Price List (creates a rota assignment for the selected staff member)."
    },
    "staff_id": {
      "type": "string",
      "description": "Linked Staff member \u2014 set for labour items to identify which crew member is being billed. Also used to auto-create a RotaAssignment so the person appears on the job schedule."
    },
    "supplier_id": {
      "type": "string",
      "description": "Supplier (for hired or purchased equipment)"
    },
    "contractor_id": {
      "type": "string",
      "description": "Contractor supplying this item (when category is 'contractor_supplied'). The contractor is responsible for delivering it to site \u2014 no collection or delivery task is created for our drivers."
    },
    "client_id": {
      "type": "string",
      "description": "Client supplying this item (when category is 'client_supplied'). The client delivers it directly to site \u2014 no cost, charge, or driver collection is tracked."
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem from the Master Price List \u2014 set automatically when an item is picked from the rate card. Keeps the description, unit cost and unit label in sync with the source rate, and marks the item as chargeable to the client."
    },
    "description": {
      "type": "string",
      "description": "Item description e.g. Transformer, Excavator"
    },
    "reference_number": {
      "type": "string",
      "description": "Reference / asset tag / serial number for tracking"
    },
    "responsible_person": {
      "type": "string",
      "description": "Person responsible for this equipment (carried over from the catalogue / GC Compliance Manager)"
    },
    "site_asset_id": {
      "type": "string",
      "description": "Linked SiteAsset (from GC Compliance Manager / Asset Panda) \u2014 keeps this cost item connected to live compliance status. Used for rigs and owned equipment."
    },
    "po_number": {
      "type": "string",
      "description": "Purchase order number for this hire or purchase. Required when category is 'purchased_equipment'."
    },
    "order_slip_url": {
      "type": "string",
      "description": "URL of the uploaded order slip / purchase document. Required for purchased equipment to evidence the supplier order."
    },
    "order_slip_name": {
      "type": "string",
      "description": "Original filename of the uploaded order slip."
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Hire start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Hire end date"
    },
    "unit_cost": {
      "type": "number",
      "description": "Net cost per unit (excluding VAT). Zero for contractor/client-supplied items. Auto-filled from the linked RateCardItem when picked from the Master Price List."
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of units / days"
    },
    "unit_label": {
      "type": "string",
      "default": "day",
      "description": "Unit label e.g. day, each, m, hour"
    },
    "men": {
      "type": "number",
      "description": "Crew size auto-filled from the linked RateCardItem (labour items only). The total daily cost is calculated as unit_cost \u00d7 men for per-day items. Not manually editable \u2014 sourced from the rate card."
    },
    "vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is exempt from VAT"
    },
    "hire_status": {
      "type": "string",
      "enum": [
        "active",
        "off_hired"
      ],
      "default": "active",
      "description": "Whether hired equipment is still on site or returned to supplier"
    },
    "current_location": {
      "type": "string",
      "enum": [
        "yard",
        "in_transit",
        "site",
        "returned"
      ],
      "default": "yard",
      "description": "Live tracking of where this item physically is: yard (at depot), in_transit (on a vehicle), site (on the job), returned (collected and returned to depot/supplier/contractor). Contractor/client-supplied items default to 'site' since they are delivered directly."
    },
    "return_destination": {
      "type": "string",
      "description": "Where this item was returned to when collected: 'depot', a supplier_id, or a contractor_id. Set when current_location becomes 'returned'."
    },
    "location_updated_at": {
      "type": "string",
      "description": "ISO timestamp of when current_location was last changed"
    },
    "off_hire_date": {
      "type": "string",
      "format": "date",
      "description": "Date the equipment was returned / off-hired"
    },
    "off_hire_note_url": {
      "type": "string",
      "description": "URL of the uploaded off-hire / return note document"
    },
    "off_hire_note_name": {
      "type": "string",
      "description": "Original filename of the off-hire note"
    },
    "on_site_signature_url": {
      "type": "string",
      "description": "URL of the uploaded on-site receipt signature image (PNG). Captured when an item is marked 'Already on site' \u2014 evidences that the item was confirmed as delivered/present on site by the signing person."
    },
    "on_site_signed_at": {
      "type": "string",
      "description": "ISO timestamp of when the on-site receipt signature was captured."
    },
    "on_site_signed_by": {
      "type": "string",
      "description": "Name of the person who signed to confirm the item is on site."
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes for equipment delivery (address, contact, timing)"
    },
    "collection_notes": {
      "type": "string",
      "description": "Notes for equipment collection (date, contact, return condition)"
    },
    "is_poa": {
      "type": "boolean",
      "default": false,
      "description": "True when the source rate card item had no fixed price (POA / Price on Application). These items are added to the job without a unit cost and must be confirmed with a negotiated price before billing."
    },
    "negotiated_unit_cost": {
      "type": "number",
      "description": "The agreed/confirmed unit price for a POA item, entered once the quote or contract price is confirmed. Used in place of unit_cost for all billing calculations when price_confirmed is true."
    },
    "price_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True once a negotiated price has been confirmed for this POA item. Billing calculations use negotiated_unit_cost instead of unit_cost when this is set."
    },
    "quote_document_url": {
      "type": "string",
      "description": "URL of the uploaded quote / contract document evidencing the confirmed price."
    },
    "quote_document_name": {
      "type": "string",
      "description": "Original filename of the uploaded quote / contract document."
    },
    "confirmed_by_name": {
      "type": "string",
      "description": "Name of the person who confirmed the negotiated price."
    },
    "confirmed_at": {
      "type": "string",
      "description": "ISO timestamp of when the negotiated price was confirmed."
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "job_id",
    "category",
    "description",
    "unit_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}