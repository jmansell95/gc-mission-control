{
  "name": "DeliveryLog",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Job this delivery/collection is associated with"
    },
    "division_id": {
      "type": "string",
      "description": "The division this delivery belongs to (inherited from the job's division). Drives division-scoped delivery views and RLS."
    },
    "job_name": {
      "type": "string",
      "description": "Job name (for display)"
    },
    "driver_staff_id": {
      "type": "string",
      "description": "Staff member assigned to drive / carry out the delivery"
    },
    "driver_staff_name": {
      "type": "string",
      "description": "Driver name (for display)"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "site_delivery",
        "supplier_delivery",
        "supplier_collection",
        "item_handover",
        "sample_collection",
        "sample_delivery"
      ],
      "description": "Type of movement: 'site_delivery' = delivering to site, 'supplier_delivery' = receiving a delivery from a supplier into the depot or directly to site, 'supplier_collection' = collecting from supplier, 'item_handover' = internal handover, 'sample_collection' = collecting samples from site, 'sample_delivery' = delivering samples to a laboratory"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Delivery task status"
    },
    "items": {
      "type": "string",
      "description": "Comma-separated or free-text list of items being delivered/collected"
    },
    "linked_cost_item_ids": {
      "type": "string",
      "description": "Comma-separated IDs of JobCostItem groups linked to this delivery — used to auto-populate items and track which material sets are on this load"
    },
    "linked_rig_ids": {
      "type": "string",
      "description": "Comma-separated SiteAsset IDs of rigs being moved by this delivery. Set by the dispatcher when creating a rig delivery/collection so that delivery sign-off stamps the rig on-site (site_delivery) or releases it back to the yard (supplier_collection). When blank on a site delivery, the sign-off falls back to stamping every rig currently assigned to the job."
    },
    "sample_ids": {
      "type": "string",
      "description": "Comma-separated Sample entity IDs linked to this delivery task. Set when a driver is collecting samples from site or delivering them to a laboratory. Drives the sample checklist shown in the sign-off modal — the driver must tick 'all samples accounted' before completing."
    },
    "samples_accounted": {
      "type": "boolean",
      "default": false,
      "description": "True when the driver has confirmed all linked samples are present and accounted for at the point of sign-off. Required to complete a sample_collection or sample_delivery task."
    },
    "pickup_address": {
      "type": "string",
      "description": "Where to collect/pick up the items from (supplier yard, depot, site, etc.)"
    },
    "delivery_address": {
      "type": "string",
      "description": "Where items are being delivered to (site address, supplier return, lab address, etc.)"
    },
    "contact_name": {
      "type": "string",
      "description": "On-site or supplier contact name for handover"
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number for the delivery/collection point"
    },
    "po_number": {
      "type": "string",
      "description": "Purchase order / reference number for this delivery"
    },
    "linked_cost_item_id": {
      "type": "string",
      "description": "Optional linked JobCostItem for automatic cost tracking updates"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the delivery/collection is scheduled for"
    },
    "started_at": {
      "type": "string",
      "description": "ISO timestamp when the driver started the delivery task"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp when the delivery was signed off"
    },
    "signature_url": {
      "type": "string",
      "description": "URL of the uploaded recipient signature image (PNG)"
    },
    "signature_data_url": {
      "type": "string",
      "description": "Base64 data URL of the signature — used for offline storage, cleared after sync"
    },
    "signed_by_name": {
      "type": "string",
      "description": "Name of the person who signed for the delivery"
    },
    "photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of condition/evidence photos"
    },
    "photo_data_urls": {
      "type": "string",
      "description": "Comma-separated base64 data URLs of photos — used for offline storage, cleared after sync"
    },
    "gps_coordinates": {
      "type": "string",
      "description": "Lat/lng captured at time of completion (e.g. '51.5074,-0.1278')"
    },
    "notes": {
      "type": "string",
      "description": "Driver notes about the delivery/collection (damage, delays, access issues)"
    },
    "condition_report": {
      "type": "string",
      "description": "Condition of equipment upon delivery or collection (good, damaged, missing parts, etc.)"
    },
    "synced_from_offline": {
      "type": "boolean",
      "default": false,
      "description": "True if this delivery was signed off while offline and synced later"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle used for this delivery"
    },
    "weight_kg": {
      "type": "number",
      "description": "Weight of this delivery's items in kg — used for vehicle capacity checks. Manager-only field."
    },
    "volume_m3": {
      "type": "number",
      "description": "Volume of this delivery's items in cubic metres — used for vehicle capacity checks. Manager-only field."
    },
    "total_loaded_weight_kg": {
      "type": "number",
      "description": "Total loaded weight (kg) of all items on this delivery run, summed from asset weight_kg values at sign-out. Denormalised so the driver hub can display the safe-to-drive payload status without re-summing."
    },
    "axle_guidance_note": {
      "type": "string",
      "description": "Human-readable axle load distribution recommendation for this delivery's loaded items (front/rear split + heaviest item placement). Denormalised at sign-out so the driver hub and load manifest can display it without recalculating."
    },
    "weight_override": {
      "type": "boolean",
      "default": false,
      "description": "True when the dispatcher/driver explicitly overrode the overweight block (loaded weight exceeded the vehicle's max_weight_kg). Logged to SystemAuditLog for audit traceability."
    },
    "chargeable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this delivery is chargeable to the client. All drives are chargeable by default; toggle off for goodwill/free visits. Internal handovers (item_handover) default to not chargeable."
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule used to calculate the charge for this delivery"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated charge amount in GBP (set by the calculateCharge function)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated (rule name, method, components)"
    },
    "miles": {
      "type": "number",
      "description": "Round-trip miles driven for this delivery — used for per-mile charge calculations"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "auto",
        "no_charge",
        "custom_fee"
      ],
      "default": "auto",
      "description": "How the charge was determined. 'auto' = calculated from rule, 'no_charge' = explicitly not charged, 'custom_fee' = manual override amount."
    },
    "custom_fee": {
      "type": "number",
      "description": "Manual fee override in GBP — used when billing_status is 'custom_fee'"
    },
    "handover_to_staff_id": {
      "type": "string",
      "description": "Staff member the driver handed the items over to (instead of delivering to the site recipient). Set when a driver uses the handover-to-colleague flow. The chained delivery created for this colleague carries parent_delivery_id pointing back here."
    },
    "handover_to_staff_name": {
      "type": "string",
      "description": "Name of the colleague the items were handed over to (denormalised for display)."
    },
    "handover_from_staff_name": {
      "type": "string",
      "description": "Name of the driver who handed the items over. Set on the chained (child) delivery so the receiving colleague can see who handed it to them."
    },
    "parent_delivery_id": {
      "type": "string",
      "description": "ID of the original delivery this was handed over from. Set on chained (child) deliveries created by the handover flow — links the chain so the admin hub can show the full movement history of an item."
    },
    "handover_completed_at": {
      "type": "string",
      "description": "ISO timestamp when the handover was confirmed by the receiving colleague (their sign-off)."
    },
    "optimized_sequence_index": {
      "type": "number",
      "description": "Recommended stop order for the day (1-based). Set by the optimizeDailyRoute function using Google Maps Directions API with waypoint optimisation. Lower = earlier in the day."
    },
    "optimized_eta": {
      "type": "string",
      "description": "ISO timestamp of the estimated arrival time at this stop, calculated from the route optimisation start time plus cumulative leg durations."
    },
    "leg_duration_minutes": {
      "type": "number",
      "description": "Travel time in minutes from the previous stop to this stop (traffic-aware). Set by the optimizeDailyRoute function."
    },
    "leg_distance_miles": {
      "type": "number",
      "description": "Road distance in miles from the previous stop to this stop. Set by the optimizeDailyRoute function."
    },
    "route_optimized_at": {
      "type": "string",
      "description": "ISO timestamp of when the route was last optimised for this delivery."
    },
    "picked_by_name": {
      "type": "string",
      "description": "Name of the warehouse/depot staff member who picked the items from the shelf. Stamped by the in-app digital sign-off flow."
    },
    "picked_at": {
      "type": "string",
      "description": "ISO timestamp when the items were marked as picked in the app."
    },
    "picked_signature_data_url": {
      "type": "string",
      "description": "Base64 PNG data URL of the drawn signature captured when the warehouse picker confirmed the Picked stage. Captured via the in-app SignaturePad so each pick stage has a legally defensible signature audit trail."
    },
    "loaded_by_name": {
      "type": "string",
      "description": "Name of the staff member who loaded the items onto the delivery vehicle. Stamped by the in-app digital sign-off flow."
    },
    "loaded_at": {
      "type": "string",
      "description": "ISO timestamp when the items were marked as loaded onto the vehicle in the app."
    },
    "loaded_signature_data_url": {
      "type": "string",
      "description": "Base64 PNG data URL of the drawn signature captured when the loader confirmed the Loaded stage. Captured via the in-app SignaturePad so each load stage has a legally defensible signature audit trail."
    },
    "driver_checked": {
      "type": "boolean",
      "default": false,
      "description": "True when the driver has confirmed the load is correct and complete before departure. Stamped by the in-app digital sign-off flow."
    },
    "driver_checked_by": {
      "type": "string",
      "description": "Name of the driver who checked and confirmed the load."
    },
    "driver_checked_at": {
      "type": "string",
      "description": "ISO timestamp when the driver confirmed the load check."
    },
    "driver_check_signature_data_url": {
      "type": "string",
      "description": "Base64 PNG data URL of the drawn signature captured when the driver confirmed the Driver Check stage. Captured via the in-app SignaturePad so the pre-departure load check has a legally defensible signature audit trail."
    },
    "trailer_id": {
      "type": "string",
      "description": "Optional SiteAsset (trailer) paired with the vehicle for this delivery. Set when warehouse staff assign a trailer from the asset inventory to a delivery that requires towing."
    },
    "trailer_name": {
      "type": "string",
      "description": "Trailer name (denormalised for display on delivery cards and the driver hub without a join)."
    },
    "towing_checklist_completed": {
      "type": "boolean",
      "default": false,
      "description": "True when the driver has completed the pre-departure towing safety checklist (number plate grabbed, lights checked, toolbox talk opened) for a delivery with a trailer assigned. Gates the Start button on the driver hub — the delivery cannot be started until this is true."
    },
    "towing_checklist_at": {
      "type": "string",
      "description": "ISO timestamp of when the driver confirmed the towing pre-departure checklist."
    }
  },
  "required": [
    "job_id",
    "driver_staff_id",
    "delivery_type",
    "scheduled_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
