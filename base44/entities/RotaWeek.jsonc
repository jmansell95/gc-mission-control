{
  "name": "RotaWeek",
  "type": "object",
  "properties": {
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Start of the week (Monday) this rota covers"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "Whether the week is still being built or has been submitted to staff"
    },
    "published_at": {
      "type": "string",
      "description": "Timestamp when the rota was submitted/emailed to staff"
    },
    "superseded": {
      "type": "boolean",
      "default": false,
      "description": "True when a newer rota week has been created \u2014 hides this week from staff so they only see the latest schedule"
    }
  },
  "required": [
    "week_start",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}