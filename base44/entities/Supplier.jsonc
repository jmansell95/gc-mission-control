{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier company name"
    },
    "division_id": {
      "type": "string",
      "description": "The division this supplier belongs to. Set automatically from the active division when the supplier is created. Drives division-scoped filtering \u2014 a division only sees its own suppliers. Blank = unassigned (visible to enterprise admins only)."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person (legacy single-contact field, kept for backward compatibility). Prefer the 'contacts' array for multiple contacts."
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email address (legacy single-contact field)."
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number (legacy single-contact field)."
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Contact person name"
          },
          "role": {
            "type": "string",
            "description": "Contact role/job title (e.g. Sales, Hire Desk, Accounts)"
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number"
          },
          "email": {
            "type": "string",
            "description": "Contact email address"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about this contact"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "All contacts for this supplier \u2014 unlimited, no primary designation. Each entry has name, role, phone, email, notes. Used for comms and booking request recipient selection."
    },
    "notes": {
      "type": "string",
      "description": "Notes e.g. usual hire terms, account number"
    },
    "rate_card_file_url": {
      "type": "string",
      "description": "URL of the uploaded rate card file (Excel/CSV/PDF) for this supplier. Used to auto-populate their line items into the Master Price List."
    },
    "rate_card_file_name": {
      "type": "string",
      "description": "Original filename of the uploaded supplier rate card."
    },
    "rate_card_synced_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful rate card ingest for this supplier."
    },
    "rate_card_item_count": {
      "type": "number",
      "default": 0,
      "description": "Number of rate card line items currently linked to this supplier (set automatically after ingest)."
    },
    "is_maintenance_provider": {
      "type": "boolean",
      "default": false,
      "description": "True when this supplier is a vehicle maintenance provider (Holman, tyre specialist, windscreen specialist, etc.). Flags them to appear in the Maintenance Hub provider directory and the booking modal supplier picker."
    },
    "emergency_mobile": {
      "type": "string",
      "description": "24/7 emergency mobile number for breakdowns and urgent call-outs. Shown as a click-to-call button in the Maintenance Hub provider directory."
    },
    "technical_email": {
      "type": "string",
      "description": "Email address for sending automated service alert / booking request emails. Used by the maintenance booking workflow to CC the provider when a booking is created or updated."
    },
    "portal_login_url": {
      "type": "string",
      "description": "Direct URL to the provider's repair management / booking portal (e.g. Holman's online portal). Shown as a quick-jump link in the Maintenance Hub."
    },
    "maintenance_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mot",
          "service",
          "breakdown",
          "windscreen",
          "tyre_repair",
          "repair",
          "fuel_card",
          "inspection",
          "risk_master"
        ]
      },
      "default": [],
      "description": "Maintenance services this provider offers. Used to filter the provider directory and auto-suggest the right provider when a booking type is selected."
    },
    "account_number": {
      "type": "string",
      "description": "Account number or reference with this supplier (e.g. Holman fleet account number). Shown on the provider card for quick reference when calling."
    },
    "is_training_provider": {
      "type": "boolean",
      "default": false,
      "description": "True when this supplier is a training provider (delivers courses, certifications, cards). Flags them to appear in the Training Matrix Providers tab and the course/assignment provider picker."
    },
    "training_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cscs_card",
          "cpcs_card",
          "npors_card",
          "first_aid_cert",
          "driver_license",
          "dbs_certificate",
          "forklift",
          "confined_space",
          "asbestos_awareness",
          "manual_handling",
          "working_at_height",
          "sts_triple",
          "nvq",
          "ipaf",
          "pasma",
          "traffic_management",
          "plant_training",
          "other"
        ]
      },
      "default": [],
      "description": "Training categories / qualifications this provider delivers (e.g. CSCS cards, NVQs, first aid, IPAF, confined space). Used to match courses to the right provider and filter the provider directory by what's needed."
    },
    "accreditations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chas",
          "constructionline",
          "smas",
          "safecontractor",
          "iso9001",
          "iso14001",
          "iso45001",
          "achilles",
          "citb",
          "npors_approved",
          "cscs_approved",
          "other"
        ]
      },
      "default": [],
      "description": "Accreditations / approvals this training provider holds (CITB, NPORS approved, CSCS approved, ISO, etc.). Shown on the provider card so managers can verify quality."
    },
    "lat": {
      "type": "number",
      "description": "Supplier yard/depot latitude. Set via the geocode button on the supplier form. Used for geofence detection \u2014 when a vehicle enters the radius around this location, an arrival event is triggered."
    },
    "lng": {
      "type": "number",
      "description": "Supplier yard/depot longitude. Set via the geocode button on the supplier form. Used for geofence detection."
    },
    "geofence_radius_override": {
      "type": "number",
      "description": "Per-supplier geofence radius override (metres). When set, this radius is used instead of the global default from the geofence config. Useful for large yards that need a wider zone."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}