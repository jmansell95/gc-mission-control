{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team or group name"
    },
    "division_id": {
      "type": "string",
      "description": "The division this team belongs to. Set automatically from the active division when the team is created. This is the single source of truth for a staff member's division — staff inherit their division from their team. Drives division-scoped filtering — a division only sees its own teams. Blank = unassigned (visible to enterprise admins only)."
    },
    "description": {
      "type": "string",
      "description": "Team description"
    },
    "parent_team_id": {
      "type": "string",
      "description": "Parent team ID — set when this is a sub-team under a team group (e.g. Coring and Trial Pit crews sit under the Groundworks parent)."
    },
    "job_type": {
      "type": "string",
      "enum": [
        "drilling",
        "groundworks",
        "depot"
      ],
      "description": "Discipline this team handles — staff in this team can only be assigned to matching jobs. 'drilling' covers all drilling crews (CP and Rotary, via the drilling_method sub-choice on the job). 'groundworks' covers all groundworks crews (enabling, coring, trial pit, general). 'depot' for yard-based teams. Blank/absent = flexible (any discipline, e.g. supervisors)."
    },
    "category": {
      "type": "string",
      "enum": [
        "field_ops",
        "depot",
        "management"
      ],
      "description": "Top-level group this team belongs to. 'field_ops' = field crews (drillers, groundworkers) who see their schedule first. 'depot' = depot staff (managers, fitters) who see the admin dashboard first. 'management' = senior leadership with full access."
    },
    "default_landing_page": {
      "type": "string",
      "enum": [
        "/staff-schedule",
        "/admin"
      ],
      "description": "Deprecated — landing pages are now set per-staff (Staff.default_landing_page). Kept for backward compatibility; no longer read by buildMyProfile or resolveRoleLandingPage."
    },
    "allowed_tool_access": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Admin sections this team can access when viewing the admin dashboard."
    },
    "permission_group_id": {
      "type": "string",
      "description": "Deprecated — permission groups are now assigned per-staff (Staff.permission_group_id), not per-team. Kept for backward compatibility; no longer read by buildMyProfile."
    },
    "revenue_stream_type": {
      "type": "string",
      "enum": [
        "none",
        "drilling_meterage",
        "groundworks_unit",
        "coring_unit",
        "trial_pit_unit",
        "day_rate",
        "flat_fee"
      ],
      "default": "none",
      "description": "How revenue is calculated for jobs handled by this crew. 'drilling_meterage' = £/metre drilled, 'groundworks_unit' = £/trial pit or unit, 'coring_unit' = £/core run or metre cored, 'trial_pit_unit' = £/trial pit, 'day_rate' = fixed daily crew rate, 'flat_fee' = single project fee, 'none' = revenue tracked per asset/task only."
    },
    "billing_default_markup": {
      "type": "number",
      "default": 0,
      "description": "Default markup % applied to this crew's jobs when assigned. Used as the starting markup for revenue calculations."
    },
    "compatible_asset_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Asset types this crew is qualified to operate (e.g. ['rig','lifting']). When assigning equipment, only compatible assets are offered to this crew; mismatches show a soft warning."
    },
    "required_qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "cscs_card",
          "cpcs_card",
          "npors_card",
          "first_aid_cert",
          "driver_license",
          "dbs_certificate",
          "forklift",
          "sts_triple",
          "confined_space",
          "asbestos_awareness",
          "manual_handling",
          "working_at_height",
          "other"
        ]
      },
      "default": [],
      "description": "Qualifications/training required for this crew. Staff without these are flagged in the Training Gap Analysis. Includes standard compliance items plus additional site safety training (STS Triple, confined space, etc.)."
    },
    "supervisor_staff_id": {
      "type": "string",
      "description": "Staff member ID of the supervisor who manages this team. The supervisor gets a consolidated view of all crews reporting to them."
    },
    "is_supervisor_team": {
      "type": "boolean",
      "default": false,
      "description": "True when this is a supervisor team that oversees other crews (e.g. a Drilling Supervisor team managing all CP and Rotary crews)."
    },
    "managed_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of teams that this supervisor team oversees."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
