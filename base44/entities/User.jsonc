{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "director",
        "user"
      ],
      "default": "user",
      "description": "Platform access role. 'admin' = Super Admin (full platform bypass \u2014 sees and manages every division, creates directors, assigns divisions). 'director' = Division Director (oversees multiple assigned divisions via managed_division_ids \u2014 can switch between only those divisions). 'user' = standard authenticated user scoped to their single division_id (cannot switch divisions)."
    },
    "division_id": {
      "type": "string",
      "description": "The division this user belongs to. For standard users (role 'user'), this is their single assigned division \u2014 they are locked to it and cannot switch. For directors, this is their primary division (typically the first of their managed_division_ids). Blank for super admins who oversee all divisions."
    },
    "managed_division_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Divisions a Director (role='director') is permitted to manage and switch between. Assigned by a super admin in Settings \u2192 Divisions \u2192 Directors. Ignored for super admins (who see all divisions) and standard users (who see only their division_id). When a director logs in, they land on the Enterprise Selector showing only these divisions."
    },
    "is_enterprise_admin": {
      "type": "boolean",
      "default": false,
      "description": "Legacy flag for users who previously oversaw all divisions. Super admins (role='admin') have full access regardless of this flag. Directors use managed_division_ids for scoped multi-division access instead of this flag."
    },
    "access_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Access gate status. 'pending' = new SSO user waiting for admin approval (shown a pending screen with approver contact info). 'approved' = admin approved or auto-linked via a matching Staff record. 'rejected' = admin denied access (shown a rejection screen). Blank/undefined = existing user from before the gate was introduced (treated as 'approved' so no one is locked out). Admins (role='admin') always bypass this check."
    }
  }
}