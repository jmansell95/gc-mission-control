{
  "name": "AssetPandaConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Config key \u2014 always 'global'. Used together with division_id to fetch the config record for a specific business stream."
    },
    "division_id": {
      "type": "string",
      "description": "The business stream this Asset Panda config belongs to. When set, this record holds the per-stream Asset Panda credentials so each stream can connect its own Asset Panda account. Blank/null = global/shared config (used when no division is active, and as the backend fallback)."
    },
    "api_token": {
      "type": "string",
      "description": "Pre-generated Asset Panda session token. Optional advanced fallback \u2014 if blank, the sync auto-generates a fresh token on each run using the email/password web login. Session tokens expire, so prefer using email + password instead."
    },
    "email": {
      "type": "string",
      "description": "Asset Panda WEB LOGIN email \u2014 the email address you sign into app.assetpanda.com with. Used with password to auto-generate a fresh session token on every sync/push call via POST /v3/session-token, so expired tokens are never an issue. This is the primary authentication method."
    },
    "password": {
      "type": "string",
      "description": "Asset Panda WEB LOGIN password \u2014 the password you sign into app.assetpanda.com with. Used with email to auto-generate a session token. The sync auto-generates a fresh token on every call."
    },
    "client_id": {
      "type": "string",
      "description": "DEPRECATED \u2014 not used for V3 auth. The Client ID issued on the Asset Panda API Configuration page is a UUID that the V3 /v3/session-token endpoint rejects with 'User email not found!'. Use the web-login email + password instead. Kept for backward compatibility only."
    },
    "client_secret": {
      "type": "string",
      "description": "DEPRECATED \u2014 not used for V3 auth. Kept for backward compatibility only. Use the web-login password instead."
    },
    "base_url": {
      "type": "string",
      "default": "https://api.assetpanda.com",
      "description": "Asset Panda REST API base URL."
    },
    "group_id": {
      "type": "string",
      "description": "DEPRECATED \u2014 use groups. Legacy single group ID. Kept for backward compatibility; when groups is empty, the sync treats this as a single-entry group."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "type": "string",
            "description": "Asset Panda group (entity) ID whose objects represent the inventory to sync for this group."
          },
          "label": {
            "type": "string",
            "description": "Friendly label for this group shown in Settings and on asset records (e.g. 'Rigs', 'Lifting Gear', 'PAT Equipment')."
          },
          "asset_type_hint": {
            "type": "string",
            "enum": [
              "rig",
              "machinery",
              "trailer",
              "vehicle",
              "lifting",
              "portable_appliance",
              "auto"
            ],
            "default": "auto",
            "description": "Hint for the asset_type of objects in this group. 'auto' = detect from the object's name/type fields. When set to a specific type, all objects in this group are classified as that type unless the object's own type field overrides it."
          },
          "is_asset_group": {
            "type": "boolean",
            "default": true,
            "description": "Whether this group contains physical assets/equipment to sync into the SiteAsset inventory. Set to false for Asset Panda reference-table groups (Operators, Customers, Locations, Asset Types, etc.) so they are not synced. When false, existing matched records are still updated in place (so previously-synced records get re-mapped with correct field data) but no NEW records are created \u2014 preventing operators/customers/locations from polluting the asset inventory. Auto-detected on first sync: groups whose names contain reference keywords (operator, customer, location, asset type, staff, etc.) default to false."
          },
          "field_map_overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "system_field": {
                  "type": "string",
                  "description": "The SiteAsset system field name to map to."
                },
                "panda_field_key": {
                  "type": "string",
                  "description": "The Asset Panda field key that holds the value for this system field."
                },
                "panda_field_label": {
                  "type": "string",
                  "description": "The human-readable label of the Asset Panda field."
                }
              },
              "required": [
                "system_field",
                "panda_field_key"
              ]
            },
            "default": [],
            "description": "Per-group field-map overrides. When empty, the global field_map is used for this group. When set, these override the global field_map for objects in this group only (merged: global first, then overrides replace matching system_field keys)."
          },
          "last_sync_at": {
            "type": "string",
            "description": "ISO timestamp of the last successful sync run for this group."
          },
          "last_sync_summary": {
            "type": "string",
            "description": "Short human-readable summary of the last sync result for this group."
          }
        },
        "required": [
          "group_id",
          "label"
        ]
      },
      "default": [],
      "description": "Multiple Asset Panda groups within one database. Each entry syncs its objects into SiteAsset records, tagged with the group label (panda_group_label) so the Assets Hub can filter by source group. When empty, the legacy group_id is used as a single group (backward compatible)."
    },
    "field_name": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the asset name field key. Kept for backward compatibility; the custom field_map takes precedence."
    },
    "field_serial": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the serial / asset tag field key."
    },
    "field_daily_rate": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the daily billing rate field key."
    },
    "field_stock_status": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the stock / condition status field key."
    },
    "field_asset_type": {
      "type": "string",
      "description": "DEPRECATED \u2014 use field_map. Legacy fixed mapping for the asset type / category field key."
    },
    "field_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "system_field": {
            "type": "string",
            "description": "The SiteAsset system field name to map to (e.g. 'name', 'serial_number', 'storage_location', 'compliance_expiry_date', 'cost_price')."
          },
          "panda_field_key": {
            "type": "string",
            "description": "The Asset Panda field key (e.g. 'field_1') that holds the value for this system field."
          },
          "panda_field_label": {
            "type": "string",
            "description": "The human-readable label of the Asset Panda field (denormalised for display in the mapping UI)."
          }
        },
        "required": [
          "system_field",
          "panda_field_key"
        ]
      },
      "default": [],
      "description": "Full custom field map \u2014 maps any Asset Panda field to any SiteAsset system field. Configured visually in Settings \u2192 Asset Panda \u2192 Field Mapping. Takes precedence over the legacy fixed field_* mappings. The sync applies core fields (name, serial, type, stock, cost) with their specialised parsing, and applies all other mapped fields as direct copies. Map an Asset Panda field to 'cost_price' to pull each asset's cost into the system for the billable-items catalogue."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret used to authenticate inbound webhooks from Asset Panda flows. Appended as the 'secret' query parameter on the webhook URL. When set, the assetPandaWebhook endpoint verifies every request carries this secret."
    },
    "auto_deactivate": {
      "type": "boolean",
      "default": true,
      "description": "When true, assets reported by Asset Panda as out of stock or needing service are automatically deactivated (is_active = false) so they can't be added to jobs."
    },
    "last_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful sync run."
    },
    "last_sync_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last sync result (counts, errors)."
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last sync attempt."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}