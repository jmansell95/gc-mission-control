{
  "name": "EquipmentCatalogue",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Item description (e.g. 'Excavator 5-ton', 'CP Rig 1', 'Casing hire')"
    },
    "category": {
      "type": "string",
      "enum": [
        "hired_equipment",
        "purchased_equipment",
        "internal_equipment",
        "contractor_supplied"
      ],
      "default": "hired_equipment",
      "description": "Default category for this catalogue item \u2014 auto-fills when added to a job"
    },
    "default_supplier_id": {
      "type": "string",
      "description": "Default supplier for this item (optional)"
    },
    "default_unit_cost": {
      "type": "number",
      "description": "Default net cost per unit in GBP"
    },
    "default_unit_label": {
      "type": "string",
      "default": "day",
      "description": "Default unit label (day, hour, m, each)"
    },
    "default_vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is VAT exempt by default"
    },
    "reference_number": {
      "type": "string",
      "description": "Default reference / serial number (optional). Auto-filled from linked SiteAsset."
    },
    "responsible_person": {
      "type": "string",
      "description": "Person responsible for this equipment (auto-filled from linked SiteAsset / GC Compliance Manager)"
    },
    "site_asset_id": {
      "type": "string",
      "description": "Linked SiteAsset (rig, machinery, trailer, lifting gear) from GC Compliance Manager \u2014 auto-fills description and reference_number, and shows live compliance status"
    },
    "linked_catalogue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of other EquipmentCatalogue items linked to this rig (lifting gear, trailers, machinery) \u2014 shown when adding to a job for quick bulk assignment as a set"
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem from the Master Price List \u2014 for rigs this pulls the crew day rate automatically when the rig is added to a job. If blank, the system auto-matches by rig model number against the rate card crew entries."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this catalogue item is available for selection on jobs"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order (lower = first in dropdown)"
    }
  },
  "required": [
    "description",
    "default_unit_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}