{
  "name": "ComplianceItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "staff",
        "vehicle",
        "job",
        "company",
        "equipment"
      ],
      "description": "What this compliance item relates to"
    },
    "title": {
      "type": "string",
      "description": "Name of the compliance item (e.g. CSCS Card, CPCS Card, Vehicle MOT, Public Liability Insurance, RAMS)"
    },
    "division_id": {
      "type": "string",
      "description": "The division this compliance item belongs to. Set automatically from the active division (or the linked staff/vehicle/job's division) when the item is created. Drives division-scoped filtering — a division only sees its own compliance items. Blank = unassigned (visible to enterprise admins only)."
    },
    "qualification_type": {
      "type": "string",
      "enum": [
        "cscs_card",
        "cpcs_card",
        "npors_card",
        "first_aid_cert",
        "driver_license",
        "dbs_certificate",
        "forklift",
        "other"
      ],
      "default": "other",
      "description": "Standardised qualification type for filtering, badges, and special UI (e.g. CSCS front/back card display)"
    },
    "reference_name": {
      "type": "string",
      "description": "Name of the person, vehicle, job or entity this item belongs to"
    },
    "reference_id": {
      "type": "string",
      "description": "Optional linked entity ID (staff, vehicle, job)"
    },
    "card_number": {
      "type": "string",
      "description": "Card or registration number (e.g. CSCS registration number)"
    },
    "issue_date": {
      "type": "string",
      "description": "Date issued or last renewed. Staff compliance uses YYYY-MM (month/year) format; other categories use YYYY-MM-DD."
    },
    "expiry_date": {
      "type": "string",
      "description": "When this compliance item expires. Staff compliance uses YYYY-MM (month/year) format; other categories use YYYY-MM-DD."
    },
    "document_url": {
      "type": "string",
      "description": "URL of the uploaded certificate or front of card"
    },
    "document_name": {
      "type": "string",
      "description": "Original filename of the uploaded document"
    },
    "back_document_url": {
      "type": "string",
      "description": "URL of the back of the card (e.g. CSCS card back side)"
    },
    "back_document_name": {
      "type": "string",
      "description": "Original filename of the back document"
    },
    "responsible_person": {
      "type": "string",
      "description": "Who is responsible for maintaining this compliance item"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    },
    "status_override": {
      "type": "string",
      "enum": [
        "auto",
        "missing",
        "not_required"
      ],
      "default": "auto",
      "description": "Override the auto-calculated status. 'auto' derives from expiry_date, 'missing' marks it as not yet provided, 'not_required' exempts it."
    },
    "review_status": {
      "type": "string",
      "enum": [
        "approved",
        "pending_review",
        "rejected"
      ],
      "default": "approved",
      "description": "Manager review state for staff-submitted documents. 'approved' = manager confirmed the document is valid (counts toward compliance); 'pending_review' = staff uploaded via self-service, awaiting manager confirmation (shows a 'Pending Review' badge, NOT counted as valid until approved); 'rejected' = manager rejected the upload (document removed from compliance, staff notified). Defaults to 'approved' so manager-created items are immediately valid."
    },
    "submitter_location": {
      "type": "string",
      "description": "Location the staff member entered when they submitted/uploaded this document — where they are now (e.g. 'Cambridge North site', 'Home'). Helps the manager context-check the submission."
    },
    "reviewed_by": {
      "type": "string",
      "description": "Name of the manager who approved or rejected this staff-submitted document."
    },
    "reviewed_at": {
      "type": "string",
      "description": "ISO timestamp when the manager reviewed this document."
    },
    "review_note": {
      "type": "string",
      "description": "Note from the manager when approving or rejecting the document (e.g. reason for rejection)."
    }
  },
  "required": [
    "category",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
