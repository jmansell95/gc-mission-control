{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Vehicle name or description"
    },
    "division_id": {
      "type": "string",
      "description": "The division this vehicle belongs to. Blank = shared pool (available to all divisions)."
    },
    "registration_number": {
      "type": "string",
      "description": "Vehicle registration/license plate"
    },
    "assigned_staff_id": {
      "type": "string",
      "description": "Staff member ID assigned to this vehicle"
    },
    "team_id": {
      "type": "string",
      "description": "Team this vehicle belongs to"
    },
    "mot_expiry": {
      "type": "string",
      "format": "date",
      "description": "MOT expiry date"
    },
    "mot_status": {
      "type": "string",
      "enum": [
        "valid",
        "not_valid",
        "no_details",
        "not_found",
        "unknown"
      ],
      "default": "unknown",
      "description": "Current MOT status pulled from DVLA. 'valid' = MOT is valid and in date, 'not_valid' = MOT expired or failed, 'no_details' = DVLA holds no MOT details, 'not_found' = vehicle not found in DVLA, 'unknown' = not yet checked."
    },
    "tax_due_date": {
      "type": "string",
      "format": "date",
      "description": "Vehicle tax (VED) due date, pulled from the DVLA Vehicle Enquiry Service."
    },
    "tax_status": {
      "type": "string",
      "enum": [
        "taxed",
        "untaxed",
        "sorn",
        "not_found",
        "unknown"
      ],
      "default": "unknown",
      "description": "Current tax (VED) status pulled from DVLA. 'taxed' = tax valid and in date, 'untaxed' = tax expired, 'sorn' = declared off-road, 'not_found' = vehicle not found in DVLA, 'unknown' = not yet checked."
    },
    "service_due_date": {
      "type": "string",
      "format": "date",
      "description": "Next service due date"
    },
    "last_service_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last service"
    },
    "max_weight_kg": {
      "type": "number",
      "description": "Maximum payload weight in kg this vehicle can safely carry"
    },
    "max_volume_m3": {
      "type": "number",
      "description": "Maximum cargo volume in cubic metres this vehicle can hold"
    },
    "height_m": {
      "type": "number",
      "description": "Vehicle height in metres \u2014 used for low-bridge clearance warnings on load manifests and displayed on vehicle cards. Preferred source is Asset Panda (mapped 'Height' field); falls back to manual entry when no Panda height is available."
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number (chassis number). Used to match vehicles when syncing from Holman or Geotab."
    },
    "make": {
      "type": "string",
      "description": "Vehicle manufacturer (e.g. Ford, Mercedes, Iveco). Authoritative source is the DVLA Vehicle Enquiry Service; Geotab is used as a fallback during sync."
    },
    "model": {
      "type": "string",
      "description": "Vehicle model (e.g. Transit, Sprinter, Daily). DVLA VES does not return model \u2014 it is pulled from the DVLA MOT History API when available, or from Geotab/manual entry as a fallback."
    },
    "year": {
      "type": "number",
      "description": "Vehicle model year. Pulled from the DVLA Vehicle Enquiry Service (yearOfManufacture) during sync."
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "petrol",
        "hybrid",
        "electric",
        "lpg",
        "cng",
        "unknown"
      ],
      "default": "unknown",
      "description": "Fuel type. Authoritative source is the DVLA Vehicle Enquiry Service; Geotab is used as a fallback during sync."
    },
    "vehicle_type": {
      "type": "string",
      "description": "Vehicle category (e.g. Van, Truck, Car, Plant). Pulled from Geotab VehicleType name during sync."
    },
    "color": {
      "type": "string",
      "description": "Vehicle colour for quick visual identification in the yard. Pulled from the DVLA Vehicle Enquiry Service during sync."
    },
    "engine_capacity_cc": {
      "type": "number",
      "description": "Engine capacity in cubic centimetres, pulled from the DVLA Vehicle Enquiry Service during sync."
    },
    "co2_emissions_g_km": {
      "type": "number",
      "description": "CO2 emissions in g/km, pulled from the DVLA Vehicle Enquiry Service during sync. Used for VED tax band and environmental reporting."
    },
    "first_used_date": {
      "type": "string",
      "format": "date",
      "description": "Date the vehicle was first used on the road, pulled from the DVLA MOT History API during sync."
    },
    "geotab_device_id": {
      "type": "string",
      "description": "Geotab's internal device ID for this vehicle. Set automatically when a vehicle is matched or created during Geotab sync."
    },
    "geotab_device_serial": {
      "type": "string",
      "description": "Geotab GO device serial number (the tracker hardware serial, not the VIN)."
    },
    "geotab_sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Last Geotab sync outcome. 'synced' = latest data pulled, 'pending' = queued, 'failed' = last sync errored, 'never' = not yet synced."
    },
    "last_geotab_sync": {
      "type": "string",
      "description": "ISO timestamp of the last successful Geotab sync for this vehicle."
    },
    "holman_vehicle_id": {
      "type": "string",
      "description": "Holman fleet management system's internal vehicle ID. Set automatically when a vehicle is matched during Holman sync."
    },
    "current_mileage": {
      "type": "number",
      "description": "Latest odometer reading in miles, pulled from Holman fleet data, Geotab odometer readings, or the latest DVLA MOT test."
    },
    "engine_hours": {
      "type": "number",
      "description": "Total engine operating hours, pulled from Geotab DeviceStatusInfo during sync. Shows how long the vehicle's engine has been running \u2014 used for utilisation tracking and service scheduling."
    },
    "holman_sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Last Holman sync outcome. 'synced' = latest data pulled, 'pending' = queued, 'failed' = last sync errored, 'never' = not yet synced."
    },
    "last_holman_sync": {
      "type": "string",
      "description": "ISO timestamp of the last successful Holman sync for this vehicle."
    },
    "last_dvla_sync": {
      "type": "string",
      "description": "ISO timestamp of the last successful DVLA spec + MOT history sync for this vehicle."
    },
    "spec_lookup_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ],
      "default": "none",
      "description": "Confidence level of the last DVLA spec lookup. 'high' = DVLA VES returned full data, 'medium' = partial data returned, 'low' = vehicle not found / errors, 'none' = no lookup performed."
    },
    "geotab_driver_name": {
      "type": "string",
      "description": "Name of the driver currently/last detected by Geotab for this vehicle. Pulled from Geotab Exception events (safety telemetry) and DeviceStatusInfo. Shown on the Job Detail page so managers can see who is driving the vehicle assigned to a job."
    },
    "geotab_keeper_name": {
      "type": "string",
      "description": "Name of the vehicle's assigned keeper/primary driver from Geotab (the Driver entity's defaultDevice link). This is the FIXED assignment \u2014 who the vehicle belongs to. Updated automatically during Geotab sync. Shown as the 'Assigned' badge on vehicle cards."
    },
    "geotab_keeper_staff_id": {
      "type": "string",
      "description": "Linked Staff record matching the Geotab keeper name (best-effort name match). Blank when no Staff record matches the Geotab driver name."
    },
    "current_operator_id": {
      "type": "string",
      "description": "Staff ID of the driver currently driving this vehicle (LIVE). Set automatically when a DeliveryLog task moves to 'in_progress' and cleared when the task completes. This is the dynamic 'Driving Now' status \u2014 reflects who is actually behind the wheel right now, driven by delivery/collection/handover activity rather than hardware."
    },
    "current_operator_name": {
      "type": "string",
      "description": "Name of the live driver (denormalised for display). Shown as the 'Driving Now' badge on vehicle cards and the live map."
    },
    "current_delivery_id": {
      "type": "string",
      "description": "ID of the active DeliveryLog task the live driver is performing. Cleared when the task completes."
    },
    "current_job_id": {
      "type": "string",
      "description": "Job ID of the active delivery task (denormalised for display)."
    },
    "current_job_name": {
      "type": "string",
      "description": "Job name of the active delivery task (denormalised for display on the live map and vehicle card)."
    },
    "current_delivery_type": {
      "type": "string",
      "enum": [
        "site_delivery",
        "supplier_delivery",
        "supplier_collection",
        "item_handover",
        "sample_collection",
        "sample_delivery"
      ],
      "description": "Type of the active delivery task the live driver is performing."
    },
    "current_delivery_items": {
      "type": "string",
      "description": "Items being delivered/collected in the active task (denormalised for the 'Driving Now' badge context)."
    },
    "operator_updated_at": {
      "type": "string",
      "description": "ISO timestamp of when the live operator status was last updated."
    },
    "safety_harsh_braking_count": {
      "type": "number",
      "default": 0,
      "description": "Number of harsh braking events recorded by Geotab in the last 30 days. Pulled from Geotab Exception events matching braking rules. Used for the driver risk score and safety alerts."
    },
    "safety_speeding_count": {
      "type": "number",
      "default": 0,
      "description": "Number of speeding events recorded by Geotab in the last 30 days. Pulled from Geotab Exception events matching speeding rules."
    },
    "safety_harsh_accel_count": {
      "type": "number",
      "default": 0,
      "description": "Number of harsh acceleration events recorded by Geotab in the last 30 days."
    },
    "safety_harsh_cornering_count": {
      "type": "number",
      "default": 0,
      "description": "Number of harsh cornering events recorded by Geotab in the last 30 days."
    },
    "safety_event_count": {
      "type": "number",
      "default": 0,
      "description": "Total safety events (harsh braking + speeding + harsh acceleration + harsh cornering) recorded by Geotab in the last 30 days. Drives the driver risk score and safety alert threshold."
    },
    "driver_risk_score": {
      "type": "number",
      "description": "Driver safety risk score from 0 to 100. 100 = safest (no events), 0 = worst (20+ events in 30 days). Calculated as max(0, 100 - (total_events / 20) * 100). Displayed on vehicle cards and the fleet dashboard."
    },
    "safety_events_last_sync": {
      "type": "string",
      "description": "ISO timestamp of the last Geotab safety events sync (Exception events pull)."
    }
  },
  "required": [
    "name",
    "registration_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}