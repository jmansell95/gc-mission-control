{
  "name": "PermissionGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of this access level (e.g. 'Super Admin', 'Field Team', 'Office Staff')."
    },
    "description": {
      "type": "string",
      "description": "What this permission group lets its members do."
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for built-in groups (Super Admin, Field Staff, Read Only). System groups can't be deleted."
    },
    "is_read_only": {
      "type": "boolean",
      "default": false,
      "description": "Master read-only toggle. When true, every module is forced to read-only access regardless of the per-module level below \u2014 used for the strict 'Read Only' lockdown."
    },
    "staff_type": {
      "type": "string",
      "enum": [
        "office",
        "field",
        "flexible"
      ],
      "default": "flexible",
      "description": "Classifies this group as office staff or field team staff. Drives the default landing page after onboarding (office \u2192 Admin Dashboard, field \u2192 My Schedule) and filters which groups are offered when creating staff in a business stream. 'flexible' = no classification (landing page falls back to the role-based default)."
    },
    "landing_page": {
      "type": "string",
      "enum": [
        "auto",
        "/admin",
        "/staff-schedule",
        "/staff-profile",
        "/deliveries",
        "/scanner",
        "/subcontractor"
      ],
      "default": "auto",
      "description": "Where members of this group land after login / onboarding. 'auto' = derive from staff_type (office \u2192 /admin, field \u2192 /staff-schedule) or the role-based fallback. Set to a concrete route to force a specific landing page for everyone in this group. A staff member's own default_landing_page still overrides this when set."
    },
    "permissions": {
      "type": "object",
      "description": "Per-hub access level: 'none' (hidden), 'read' (view only, no edits), or 'write' (full create/update/delete). The 12 keys below map 1:1 to the top-level navigation hubs in the admin sidebar. Staff assigned this group inherit these levels for every admin hub.",
      "properties": {
        "overview": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "read",
          "description": "Dashboard \u2014 the main command centre overview."
        },
        "jobs": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Projects Hub \u2014 all project management, job details and project financials."
        },
        "scheduling": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Scheduling Hub \u2014 rota builder, calendar, shift planning and crew scheduling."
        },
        "staff": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Staff Hub \u2014 staff directory, crew types, timesheets and cost analytics."
        },
        "logistics": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Logistics Hub \u2014 delivery dashboard, route optimisation, goods in, driver day planner."
        },
        "assets": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Assets Hub \u2014 rigs, plant, lifting gear, PAT testing, compliance passports."
        },
        "fleet": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Fleet Hub \u2014 vehicles, live tracking, maintenance bookings, MOT history."
        },
        "investigation": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Investigation Hub \u2014 borehole data, site logs, geotech QC, AGS / KeyLogBook review."
        },
        "compliance": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Compliance Hub \u2014 audits, incidents, toolbox talks, environmental, safety, audit trail."
        },
        "billing": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Financial Hub \u2014 billing, AFP, CVR, invoicing, cost tracking, project financials."
        },
        "reports": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Reports Hub \u2014 custom report builder, scheduled reports, Power BI exports."
        },
        "settings": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Settings \u2014 all system configuration, integrations, AGS / KeyLogBook webhook config, access levels."
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}