{
  "name": "PermissionGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of this access level (e.g. 'Super Admin', 'Field Team', 'Office Staff')."
    },
    "description": {
      "type": "string",
      "description": "What this permission group lets its members do."
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "True for built-in groups (Super Admin, Field Staff, Read Only). System groups can't be deleted."
    },
    "is_read_only": {
      "type": "boolean",
      "default": false,
      "description": "Master read-only toggle. When true, every module is forced to read-only access regardless of the per-module level below \u2014 used for the strict 'Read Only' lockdown."
    },
    "staff_type": {
      "type": "string",
      "enum": [
        "office",
        "field",
        "flexible"
      ],
      "default": "flexible",
      "description": "Classifies this group as office staff or field team staff. Drives the default landing page after onboarding (office \u2192 Admin Dashboard, field \u2192 My Schedule) and filters which groups are offered when creating staff in a business stream. 'flexible' = no classification (landing page falls back to the role-based default)."
    },
    "landing_page": {
      "type": "string",
      "enum": [
        "auto",
        "/admin",
        "/staff-schedule",
        "/staff-profile",
        "/deliveries",
        "/scanner",
        "/subcontractor"
      ],
      "default": "auto",
      "description": "Where members of this group land after login / onboarding. 'auto' = derive from staff_type (office \u2192 /admin, field \u2192 /staff-schedule) or the role-based fallback. Set to a concrete route to force a specific landing page for everyone in this group. A staff member's own default_landing_page still overrides this when set."
    },
    "permissions": {
      "type": "object",
      "description": "Per-module access level: 'none' (hidden), 'read' (view only, no edits), or 'write' (full create/update/delete). Teams assigned this group inherit these levels for every admin section.",
      "properties": {
        "overview": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "read"
        },
        "jobs": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "rota": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "calendar": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "read"
        },
        "scheduling": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "timesheets": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "compliance": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "safety": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Safety & Compliance Hub \u2014 audits, incidents, toolbox talks, environmental. Write = can report incidents and manage toolbox talks."
        },
        "log-qc": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "audit-trail": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "teams": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "staff": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Staff Management \u2014 directory, cost analytics, permission group assignments. Write = can add/edit staff and assign permission groups."
        },
        "billing": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "assets": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Asset Hub \u2014 rigs, plant, vehicles, lifting gear, PAT testing, compliance passports. Write = can add/edit assets and log services."
        },
        "logistics": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "Logistics & Deliveries \u2014 delivery dashboard, route optimisation, goods in, driver day planner. Write = can create/edit delivery tasks and routes."
        },
        "settings": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none"
        },
        "ags_import": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write"
          ],
          "default": "none",
          "description": "AGS / KeyLogBook upload & sync. Write = can upload AGS files and edit webhook config."
        }
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}