{
  "name": "HelpTopic",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Help topic title (shown as heading)"
    },
    "category": {
      "type": "string",
      "enum": [
        "delivery",
        "compliance",
        "safety",
        "general",
        "app_usage",
        "logistics",
        "financial"
      ],
      "default": "general",
      "description": "Category for filtering and grouping topics. 'financial' covers AFP, CVR, subcontractor margin and other billing/financial workflows."
    },
    "audience": {
      "type": "string",
      "enum": [
        "office",
        "field",
        "both"
      ],
      "default": "both",
      "description": "Which audience this help topic is for. 'office' = office/admin staff only (shows in the Office Help Guide at /help), 'field' = field crew only (shows in the Field Crew Help Guide at /help-field), 'both' = shown in both guides. Default is 'both' so existing topics appear in both until re-categorised."
    },
    "content": {
      "type": "string",
      "description": "Markdown content of the help topic"
    },
    "summary": {
      "type": "string",
      "description": "Short summary shown in search results and topic lists"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Display order within a category (lower = first)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this topic is visible to users"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated keywords for search (e.g. 'signature, offline, delivery')"
    }
  },
  "required": [
    "title",
    "category",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}