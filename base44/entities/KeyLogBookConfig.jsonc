{
  "name": "KeyLogBookConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret that KeyLogBook sends with each real-time log webhook payload to authenticate it. Enter this same value in your KeyLogBook webhook configuration. The receiveKeyLogBookData webhook receiver validates every incoming request against this secret."
    },
    "api_base_url": {
      "type": "string",
      "description": "KeyLogBook REST API base URL (for pull-based synchronisation). Used by the syncKeyLogBook backend function to fetch all projects, boreholes, and driller remarks. Leave blank if using webhooks only."
    },
    "api_key": {
      "type": "string",
      "description": "KeyLogBook API key / bearer token (for pull-based synchronisation). Sent as Authorization: Bearer <token> with each API request. Leave blank if using webhooks only."
    },
    "auto_generate_timesheets": {
      "type": "boolean",
      "default": true,
      "description": "When true, incoming KeyLogBook webhook data automatically creates draft timesheet entries for the lead driller and second man assigned to the job that day. The crew then reviews and submits them at the end of their shift."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the KeyLogBook real-time log sync. When false, incoming real-time log webhooks are rejected even if the secret matches."
    },
    "last_webhook_at": {
      "type": "string",
      "description": "ISO timestamp of the last real-time log webhook payload received from KeyLogBook."
    },
    "last_webhook_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last real-time log webhook received \u2014 'success' = payload processed, 'failed' = validation or processing error, 'never' = no webhook received yet."
    },
    "last_webhook_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last real-time log webhook result (e.g. 'Processed 14 log entries \u00b7 2 timesheets drafted for BH-01 job')."
    },
    "ags_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the KeyLogBook AGS webhook sync. When true, KeyLogBook can push AGS files via event-based webhooks (hole_created, hole_updated, hole_deleted). All auth methods and HMAC signing are validated against the stored credentials when enabled."
    },
    "ags_sync_secret": {
      "type": "string",
      "description": "Bearer token that KeyLogBook sends in the Authorization header (Authorization: Bearer <token>) with each AGS webhook request. Enter this same value in your KeyLogBook webhook authentication settings when using Bearer Token auth."
    },
    "ags_webhook_auth_method": {
      "type": "string",
      "enum": [
        "bearer",
        "basic",
        "custom_header",
        "off"
      ],
      "default": "bearer",
      "description": "Authentication method KeyLogBook uses for AGS webhooks. 'bearer' = Bearer token in Authorization header (uses ags_sync_secret), 'basic' = Basic Auth (uses ags_webhook_basic_user/pass), 'custom_header' = custom HTTP header (uses ags_webhook_custom_header_name/value), 'off' = no authentication (not recommended)."
    },
    "ags_webhook_basic_user": {
      "type": "string",
      "description": "Username for Basic Auth authentication (only used when ags_webhook_auth_method is 'basic')."
    },
    "ags_webhook_basic_pass": {
      "type": "string",
      "description": "Password for Basic Auth authentication (only used when ags_webhook_auth_method is 'basic')."
    },
    "ags_webhook_custom_header_name": {
      "type": "string",
      "description": "Custom HTTP header name that KeyLogBook sends for authentication (only used when ags_webhook_auth_method is 'custom_header'). e.g. 'x-api-key'."
    },
    "ags_webhook_custom_header_value": {
      "type": "string",
      "description": "Custom HTTP header value that KeyLogBook sends for authentication (only used when ags_webhook_auth_method is 'custom_header')."
    },
    "ags_webhook_signing_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the importAGS receiver verifies the HMAC-SHA256 request signature in the X-Hole-Signature header against ags_webhook_signing_secret. This confirms the request genuinely came from KeyLogBook and the payload was not tampered with. Recommended for security."
    },
    "ags_webhook_signing_secret": {
      "type": "string",
      "description": "Secret key used to verify HMAC-SHA256 request signing. KeyLogBook generates this when you enable request signing in their webhook configuration. Enter the same value here. The receiver independently calculates the signature and rejects mismatches."
    },
    "ags_sync_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "How often KeyLogBook pushes an AGS file (in minutes) for the legacy scheduled-push model. Displayed in the UI so the builder knows the expected cadence. Set by the KeyLogBook developer. The new event-based webhook model sends data on hole changes instead of on a fixed schedule."
    },
    "last_ags_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last AGS webhook received from KeyLogBook (either event-based or scheduled push)."
    },
    "last_ags_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last AGS webhook \u2014 'success' = file processed, 'failed' = auth or processing error, 'never' = no webhook received yet."
    },
    "last_ags_sync_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last AGS webhook result (e.g. 'Imported 42 log entries into Cambridge North job' or 'Hole BH-03 deleted \u2014 removed 12 log entries')."
    },
    "last_pull_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful pull-based sync from the KeyLogBook API. Used by the incremental sync to fetch only records modified since this timestamp. Set by the syncKeyLogBook backend function on each run (manual or scheduled)."
    },
    "last_pull_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last pull sync \u2014 'success' = API reached and data processed, 'failed' = API unreachable, invalid credentials, or processing error, 'never' = no pull sync run yet. Shown in the Pull Sync status panel in Settings."
    },
    "last_pull_sync_summary": {
      "type": "string",
      "description": "Human-readable summary of the last pull sync result (e.g. 'Pulled 5 project(s) \u00b7 42 borehole record(s) \u00b7 18 remark activit(ies) \u00b7 3 timesheet(s) generated'). Shown in the Pull Sync status panel."
    },
    "pull_sync_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "How often the scheduled pull sync runs (in minutes). The automation is created with this interval. Defaults to 30 minutes."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}