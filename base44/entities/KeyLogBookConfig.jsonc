{
  "name": "KeyLogBookConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "ags_sync_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the single KeyLogBook webhook (the AGS event endpoint, importAGS). When true, KeyLogBook can push AGS files via event-based webhooks (hole_created, hole_updated, hole_deleted). This one endpoint handles borehole data AND driller remarks/diary. All auth methods and HMAC signing are validated against the stored credentials when enabled."
    },
    "ags_sync_secret": {
      "type": "string",
      "description": "Bearer token that KeyLogBook sends in the Authorization header (Authorization: Bearer <token>) with each webhook request. Enter this same value in your KeyLogBook webhook authentication settings when using Bearer Token auth."
    },
    "ags_webhook_auth_method": {
      "type": "string",
      "enum": [
        "bearer",
        "basic",
        "custom_header",
        "off"
      ],
      "default": "bearer",
      "description": "Authentication method KeyLogBook uses for webhooks. 'bearer' = Bearer token in Authorization header (uses ags_sync_secret), 'basic' = Basic Auth (uses ags_webhook_basic_user/pass), 'custom_header' = custom HTTP header (uses ags_webhook_custom_header_name/value), 'off' = no authentication (not recommended)."
    },
    "ags_webhook_basic_user": {
      "type": "string",
      "description": "Username for Basic Auth authentication (only used when ags_webhook_auth_method is 'basic')."
    },
    "ags_webhook_basic_pass": {
      "type": "string",
      "description": "Password for Basic Auth authentication (only used when ags_webhook_auth_method is 'basic')."
    },
    "ags_webhook_custom_header_name": {
      "type": "string",
      "description": "Custom HTTP header name that KeyLogBook sends for authentication (only used when ags_webhook_auth_method is 'custom_header'). e.g. 'x-api-key'."
    },
    "ags_webhook_custom_header_value": {
      "type": "string",
      "description": "Custom HTTP header value that KeyLogBook sends for authentication (only used when ags_webhook_auth_method is 'custom_header')."
    },
    "ags_webhook_signing_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, the importAGS receiver verifies the HMAC-SHA256 request signature in the X-Hole-Signature header against ags_webhook_signing_secret. This confirms the request genuinely came from KeyLogBook and the payload was not tampered with. Recommended for security."
    },
    "ags_webhook_signing_secret": {
      "type": "string",
      "description": "Secret key used to verify HMAC-SHA256 request signing. KeyLogBook generates this when you enable request signing in their webhook configuration. Enter the same value here. The receiver independently calculates the signature and rejects mismatches."
    },
    "ags_sync_interval_minutes": {
      "type": "number",
      "default": 30,
      "description": "How often KeyLogBook pushes an AGS file (in minutes) for the legacy scheduled-push model. Displayed in the UI so the builder knows the expected cadence. Set by the KeyLogBook developer. The new event-based webhook model sends data on hole changes instead of on a fixed schedule."
    },
    "last_ags_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last webhook received from KeyLogBook (either event-based or scheduled push)."
    },
    "last_ags_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last webhook \u2014 'success' = file processed, 'failed' = auth or processing error, 'never' = no webhook received yet."
    },
    "last_ags_sync_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last webhook result (e.g. 'Imported 42 log entries into Cambridge North job \u00b7 1 timesheet auto-generated' or 'Hole BH-03 deleted \u2014 removed 12 log entries')."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}