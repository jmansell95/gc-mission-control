{
  "name": "EmailAlertSetting",
  "type": "object",
  "properties": {
    "alert_key": {
      "type": "string",
      "description": "Unique key for this email template. System templates use predefined keys (vehicle_maintenance, compliance_expiry, etc.). Custom templates use user-defined keys prefixed with 'custom_'."
    },
    "is_custom": {
      "type": "boolean",
      "default": false,
      "description": "True for user-created custom templates. System templates cannot be deleted; custom templates can."
    },
    "custom_name": {
      "type": "string",
      "description": "Display name for custom templates (shown in the template selector)"
    },
    "custom_description": {
      "type": "string",
      "description": "Description of when this custom template is sent"
    },
    "custom_tokens": {
      "type": "string",
      "description": "Comma-separated list of tokens available in this custom template (e.g. '{staff_name},{job_name}')"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this alert is active"
    },
    "recipient_emails": {
      "type": "string",
      "description": "Comma-separated recipient emails (blank = all admins)"
    },
    "days_before_warning": {
      "type": "number",
      "description": "Days before due date to warn (vehicle maintenance, compliance expiry)"
    },
    "subject": {
      "type": "string",
      "description": "Custom email subject line"
    },
    "intro_message": {
      "type": "string",
      "description": "Custom intro paragraph prepended to the default email body"
    },
    "template": {
      "type": "string",
      "description": "Full custom email body template with placeholders. Blank uses the default template."
    },
    "accent_color": {
      "type": "string",
      "default": "#0e7a4f",
      "description": "Hex colour used for the email banner and accents"
    },
    "banner_title": {
      "type": "string",
      "default": "GC Mission Control",
      "description": "Title shown in the email banner header"
    },
    "show_banner": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the coloured banner at the top of the email"
    },
    "footer_text": {
      "type": "string",
      "default": "GC Mission Control",
      "description": "Text shown in the email footer"
    }
  },
  "required": [
    "alert_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}