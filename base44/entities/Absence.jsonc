{
  "name": "Absence",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "Staff member"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Absence start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Absence end date"
    },
    "reason": {
      "type": "string",
      "enum": [
        "holiday",
        "sick",
        "personal",
        "training",
        "other"
      ],
      "description": "Reason for absence"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval status"
    },
    "bob_request_id": {
      "type": "string",
      "description": "Bob HR (Hibob) time-off request ID \u2014 set when this absence is synced to/from Bob HR. Used to prevent duplicate sync and to link reconciliation."
    },
    "bob_status": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "error"
      ],
      "default": "pending",
      "description": "Bob HR sync status. 'pending' = not yet pushed to Bob, 'synced' = confirmed in Bob HR, 'error' = last push failed."
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "bob_hr"
      ],
      "default": "manual",
      "description": "Where this absence originated. 'manual' = created in this app, 'bob_hr' = pulled from Bob HR via sync."
    }
  },
  "required": [
    "staff_id",
    "start_date",
    "end_date",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}