{
  "name": "SitePhoto",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Associated job"
    },
    "job_name": {
      "type": "string",
      "description": "Job name (denormalised for display)"
    },
    "photo_url": {
      "type": "string",
      "description": "URL of the uploaded photo"
    },
    "caption": {
      "type": "string",
      "description": "Photo caption/description \u2014 auto-generated by AI vision when auto-tagging is enabled, or manually entered by the uploader"
    },
    "tags": {
      "type": "string",
      "description": "AI-generated equipment tags (comma-separated, e.g. 'rig, van, power tools'). Set by the auto-tagging engine using InvokeLLM vision analysis."
    },
    "activity": {
      "type": "string",
      "description": "AI-detected work activity (e.g. 'drilling', 'groundworks', 'coring'). Set by the auto-tagging engine."
    },
    "conditions": {
      "type": "string",
      "description": "AI-detected site conditions (e.g. 'mud, overcast', 'dry, clear'). Set by the auto-tagging engine."
    },
    "gps_lat": {
      "type": "number",
      "description": "GPS latitude captured at upload time (when auto-tagging is enabled and geolocation is available)"
    },
    "gps_lng": {
      "type": "number",
      "description": "GPS longitude captured at upload time (when auto-tagging is enabled and geolocation is available)"
    },
    "captured_at": {
      "type": "string",
      "description": "ISO timestamp when the photo was captured/uploaded"
    },
    "uploaded_by_name": {
      "type": "string",
      "description": "Name of staff member who uploaded"
    }
  },
  "required": [
    "job_id",
    "photo_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}