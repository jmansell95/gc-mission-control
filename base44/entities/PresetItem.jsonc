{
  "name": "PresetItem",
  "type": "object",
  "properties": {
    "preset_id": {
      "type": "string",
      "description": "CostPreset this item belongs to"
    },
    "site_asset_id": {
      "type": "string",
      "description": "Linked SiteAsset (rig, machinery, lifting gear) from GC Compliance Manager \u2014 auto-fills description and reference_number when selected"
    },
    "description": {
      "type": "string",
      "description": "Item description (e.g. 'Casing hire', 'Excavator'). Auto-filled from the linked asset name if one is selected."
    },
    "reference_number": {
      "type": "string",
      "description": "Serial number / asset tag. Auto-filled from the linked SiteAsset when selected."
    },
    "category": {
      "type": "string",
      "enum": [
        "internal_equipment",
        "hired_equipment",
        "purchased_equipment"
      ],
      "default": "hired_equipment",
      "description": "Equipment category \u2014 matches JobCostItem so items copy across cleanly"
    },
    "supplier_id": {
      "type": "string",
      "description": "Default supplier for this item (optional)"
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem from the Master Price List \u2014 set automatically when an item is picked from the rate card. Keeps the description, unit cost and unit label in sync with the source rate, and marks the item as chargeable to the client."
    },
    "unit_cost": {
      "type": "number",
      "description": "Default net cost per unit in GBP"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Default quantity"
    },
    "unit_label": {
      "type": "string",
      "default": "day",
      "description": "Unit label (day, hour, m, each)"
    },
    "men": {
      "type": "number",
      "description": "Number of men in the crew (labour items only). Used to calculate the total daily cost: unit_cost \u00d7 men for per-day items."
    },
    "vat_exempt": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item is VAT exempt"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the preset"
    }
  },
  "required": [
    "preset_id",
    "description",
    "unit_cost"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}