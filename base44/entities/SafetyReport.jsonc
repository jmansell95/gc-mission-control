{
  "name": "SafetyReport",
  "type": "object",
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "safetyculture_audit",
        "incident"
      ],
      "default": "safetyculture_audit",
      "description": "How this report was created. 'safetyculture_audit' = synced from a SafetyCulture (iAuditor) webhook. 'incident' = manually reported by staff via the in-app incident form."
    },
    "safetyculture_audit_id": {
      "type": "string",
      "description": "Unique audit ID from SafetyCulture (iAuditor). Used to de-duplicate incoming webhooks."
    },
    "audit_category": {
      "type": "string",
      "enum": [
        "vehicle_check",
        "powra",
        "equipment",
        "general"
      ],
      "default": "general",
      "description": "Auto-classified audit type. 'vehicle_check' = daily vehicle walk-round (gates the pre-departure Checks step). 'powra' = Point of Work Risk Assessment (gates the start-work step on arrival). 'equipment' = plant/equipment check. 'general' = any other audit. Classification is inferred from the audit template name by keyword matching in receiveMittiData."
    },
    "audit_template_name": {
      "type": "string",
      "description": "Name of the SafetyCulture template the audit was built from (e.g. 'Site Risk Assessment', 'Daily Plant Inspection', 'Permit to Dig')."
    },
    "audit_title": {
      "type": "string",
      "description": "Title of the individual audit instance"
    },
    "auditor_name": {
      "type": "string",
      "description": "Name of the person who conducted the audit (from SafetyCulture) or reported the incident (manual)."
    },
    "auditor_email": {
      "type": "string",
      "description": "Email of the auditor \u2014 used to auto-link the report to a sub-contractor record and to match the staff member's RotaAssignment for check verification."
    },
    "auditor_staff_id": {
      "type": "string",
      "description": "The Staff record matched by the auditor's email. Used to stamp the matching RotaAssignment's Mitti check timestamps so the ShiftWizard shows live verification."
    },
    "job_id": {
      "type": "string",
      "description": "Linked Job \u2014 auto-matched by site name / job reference when the audit metadata contains one, or selected manually for incident reports."
    },
    "job_name": {
      "type": "string",
      "description": "Job name (denormalised for display)"
    },
    "contractor_id": {
      "type": "string",
      "description": "Linked Contractor when the auditor's email matches a sub-contractor's safetyculture_email."
    },
    "site_name": {
      "type": "string",
      "description": "Site / location recorded on the audit or where the incident occurred"
    },
    "conducted_at": {
      "type": "string",
      "description": "ISO timestamp the audit was conducted (started) or the incident occurred"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp the audit was completed / submitted"
    },
    "overall_score": {
      "type": "number",
      "description": "Total score achieved on the audit"
    },
    "max_score": {
      "type": "number",
      "description": "Maximum possible score for this audit template"
    },
    "score_percentage": {
      "type": "number",
      "description": "Overall score as a percentage (overall_score / max_score \u00d7 100)"
    },
    "pass_fail": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "pending"
      ],
      "default": "pending",
      "description": "Pass/fail outcome. 'pending' = the audit doesn't use pass/fail scoring."
    },
    "audit_report_url": {
      "type": "string",
      "description": "Direct URL to the PDF audit report in SafetyCulture (opens the branded report for the client pack)."
    },
    "items_failed": {
      "type": "number",
      "default": 0,
      "description": "Count of failed / non-conformant items in the audit"
    },
    "items_passed": {
      "type": "number",
      "default": 0,
      "description": "Count of passed items in the audit"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "assignee": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "default": [],
      "description": "Corrective actions raised by the audit or incident, extracted from the SafetyCulture payload or entered manually."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "actioned",
        "closed"
      ],
      "default": "open",
      "description": "Internal follow-up status. 'open' = new report with unresolved actions; 'actioned' = actions assigned/in progress; 'closed' = all actions resolved and verified."
    },
    "raw_payload": {
      "type": "string",
      "description": "JSON snapshot of the original SafetyCulture webhook payload, kept for audit traceability."
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "near_miss",
        "incident",
        "accident",
        "dangerous_occurrence",
        "environmental",
        "other"
      ],
      "description": "Classification of the incident. 'near_miss' = no injury/damage but could have; 'incident' = injury or damage occurred; 'accident' = serious injury or major damage; 'dangerous_occurrence' = RIDDOR-reportable dangerous occurrence; 'environmental' = spill, pollution, or environmental damage."
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Severity rating. 'low' = minor/first aid only; 'medium' = medical treatment needed; 'high' = lost time injury or major damage; 'critical' = life-threatening or fatality."
    },
    "description": {
      "type": "string",
      "description": "What happened \u2014 a factual account of the incident including what was being done, what went wrong, and what happened next."
    },
    "immediate_action": {
      "type": "string",
      "description": "What immediate action was taken at the scene (first aid, area secured, equipment isolated, etc.)"
    },
    "root_cause": {
      "type": "string",
      "description": "Root cause analysis \u2014 the underlying reason the incident occurred (equipment failure, procedural, human factors, etc.)"
    },
    "reported_by_id": {
      "type": "string",
      "description": "Staff member who reported the incident (manual reports only)"
    },
    "photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of evidence photos uploaded with the incident report"
    },
    "riddor_reportable": {
      "type": "boolean",
      "default": false,
      "description": "True when this incident is RIDDOR-reportable (over-7-day injury, specified dangerous occurrence, occupational disease, or fatality)."
    },
    "riddor_reference": {
      "type": "string",
      "description": "RIDDOR report reference number once submitted to the HSE."
    },
    "riddor_submitted_at": {
      "type": "string",
      "description": "ISO timestamp when the RIDDOR report was submitted to the HSE."
    }
  },
  "required": [
    "safetyculture_audit_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}