{
  "name": "MittiConfig",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key \u2014 always 'global'. Used to fetch the single config record."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret that Mitti sends with each webhook payload to authenticate it. Enter this same value in your Mitti webhook configuration. The webhook receiver validates every incoming request against this secret."
    },
    "api_token": {
      "type": "string",
      "description": "Mitti API bearer token (optional, for future pull-based synchronisation of audit reports). Leave blank if using webhooks only."
    },
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master toggle for the Mitti webhook receiver. When false, incoming webhooks are rejected even if the secret matches."
    },
    "auto_link_to_jobs": {
      "type": "boolean",
      "default": true,
      "description": "When true, incoming audit reports are automatically matched to a job by site name / job reference found in the audit metadata."
    },
    "vehicle_check_url": {
      "type": "string",
      "description": "Direct SafetyCulture/Mitti inspection link for the daily vehicle walk-round check. Shown to crew in the ShiftWizard Checks step (before they leave for site). When blank, falls back to the built-in default SafetyCulture audit link."
    },
    "powra_url": {
      "type": "string",
      "description": "Direct SafetyCulture/Mitti inspection link for the Point of Work Risk Assessment (POWRA). Shown to crew on arrival at site. When blank, falls back to the built-in default SafetyCulture audit link."
    },
    "equipment_check_url": {
      "type": "string",
      "description": "Direct SafetyCulture/Mitti inspection link for the equipment/plant check. Shown during the site briefing. When blank, falls back to the built-in default SafetyCulture audit link."
    },
    "safety_forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique stable id for this form entry (used as the React key)."
          },
          "step": {
            "type": "string",
            "enum": [
              "checks",
              "arrive",
              "briefing"
            ],
            "default": "checks",
            "description": "Which Shift Wizard step this form button appears on. 'checks' = Daily Checks (pre-departure), 'arrive' = Arrive on Site, 'briefing' = Site Briefing."
          },
          "category": {
            "type": "string",
            "enum": [
              "vehicle",
              "powra",
              "equipment",
              "general"
            ],
            "default": "general",
            "description": "Form category \u2014 controls the icon and the live Mitti verification badge shown next to the button."
          },
          "label": {
            "type": "string",
            "description": "Button label shown to crew (e.g. 'Daily Vehicle Check', 'POWRA', 'Permit to Dig')."
          },
          "url": {
            "type": "string",
            "description": "SafetyCulture/Mitti inspection URL opened in a new tab when the crew tap the button."
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "Whether this form must be completed before the crew can advance past the step. When true and Mitti is connected, the step gates until the matching audit webhook is received."
          }
        },
        "required": [
          "id",
          "step",
          "label",
          "url"
        ]
      },
      "default": [],
      "description": "Admin-configurable list of safety/Mitti form URLs surfaced as big tappable buttons in the Shift Wizard. Each entry appears at the matching step (checks/arrive/briefing) so crew complete the right form at the right moment. When empty, the fixed vehicle_check_url / powra_url / equipment_check_url fields are used as before."
    },
    "synced_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string",
            "description": "Mitti template ID (the form number/reference, e.g. 'template_BB29F82814B64F559A33BF7CAA519787')."
          },
          "name": {
            "type": "string",
            "description": "Template/form name (e.g. 'Daily Vehicle Check', 'Site Risk Assessment')."
          },
          "modified_at": {
            "type": "string",
            "description": "ISO timestamp of when the template was last modified in Mitti."
          },
          "created_at": {
            "type": "string",
            "description": "ISO timestamp of when the template was created in Mitti."
          }
        },
        "required": [
          "template_id"
        ]
      },
      "default": [],
      "description": "All audit templates/forms synced from the Mitti API (GET /templates/search). Refreshed on every syncMitti run so the form list stays current. Each entry has the template ID (form number), name, and timestamps. Used by the compliance UI to show the full list of available Mitti forms."
    },
    "hidden_templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Template IDs that are explicitly hidden from the Audit Dashboard template grid. These templates never appear in the Compliance Hub regardless of whether they have audits. Managed via the 'Manage Templates' panel in the Audit Dashboard. Use this to hide the hundreds of sample/unused templates that come from the Mitti API."
    },
    "pinned_templates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Template IDs that are always shown in the Audit Dashboard template grid, even when they have zero audits. These are the templates your business actively uses and wants to see at a glance. Managed via the 'Manage Templates' panel. Pinned templates sort to the top of the grid."
    },
    "pinned_template_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "GC reference codes (e.g. 'GC03EXT29') that filter the Audit Dashboard template grid. When non-empty, ONLY templates whose name contains one of these codes are shown \u2014 all other templates are hidden regardless of whether they have audits. This takes precedence over the pinned_templates / hidden_templates / has-audits filters. Add or remove codes via the 'Manage Templates' panel. When empty, the grid falls back to showing all templates that have audits from known staff."
    },
    "last_templates_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last time templates were pulled from the Mitti API."
    },
    "sync_window_days": {
      "type": "number",
      "default": 90,
      "description": "How many days back to pull audits on the initial sync (when no last_pull_sync_at exists). Default 90 days. Subsequent runs use incremental sync (modified_after = last_pull_sync_at) so only new/modified audits are fetched."
    },
    "last_pull_sync_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful pull sync. Used as the modified_after cursor for incremental sync \u2014 each run fetches only audits modified after this timestamp. Set to the newest modified_at from the fetched batch. Blank on first run (falls back to now - sync_window_days)."
    },
    "last_webhook_at": {
      "type": "string",
      "description": "ISO timestamp of the last webhook payload received from Mitti."
    },
    "last_webhook_status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Outcome of the last webhook received \u2014 'success' = audit stored, 'failed' = validation or processing error, 'never' = no webhook received yet."
    },
    "last_webhook_summary": {
      "type": "string",
      "description": "Short human-readable summary of the last webhook result (e.g. 'Stored audit \"Site RAMS Inspection\" \u00b7 2 action items')."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}