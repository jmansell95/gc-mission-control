{
  "name": "Job",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "division_id": {
      "type": "string",
      "description": "The division this project belongs to. Set automatically from the active division when the project is created, or assigned via the migration. Drives division-scoped filtering on the dashboard and hubs."
    },
    "job_reference": {
      "type": "string",
      "description": "Project reference or PO number. New projects are auto-prefixed with 'PRJ-' on creation."
    },
    "depends_on_job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of prerequisite projects that must be completed (or cancelled) before this project can start. Used for project sequencing \u2014 the Dependency Manager shows a warning banner on the project detail when any dependency is not yet complete."
    },
    "location": {
      "type": "string",
      "description": "Site location/address"
    },
    "site_lat": {
      "type": "number",
      "description": "Project site latitude (for Geotab GPS geofencing \u2014 auto-detects arrival/departure times for timesheets). Set manually or via the geocode button on the project form."
    },
    "site_lng": {
      "type": "number",
      "description": "Project site longitude (for Geotab GPS geofencing \u2014 auto-detects arrival/departure times for timesheets). Set manually or via the geocode button on the project form."
    },
    "geofence_radius_override": {
      "type": "number",
      "description": "Per-project geofence radius override (metres). When set, this radius is used instead of the global default from the geofence config. Useful for large sites that need a wider zone, or compact sites that need a tighter one."
    },
    "what3words": {
      "type": "string",
      "description": "what3words address for the site location (e.g. 'filled.count.soap'). A 3-word address separated by dots that pinpoints a 3m \u00d7 3m square. Used heavily by field crews for precise site finding \u2014 shown on project cards and the project detail hero."
    },
    "weather_temp_min": {
      "type": "number",
      "description": "Per-project override for the minimum safe working temperature (\u00b0C). When blank, the global default from Settings \u2192 Weather Thresholds applies. The project detail weather card flags 'do not work' when the live temperature drops below this."
    },
    "weather_temp_max": {
      "type": "number",
      "description": "Per-project override for the maximum safe working temperature (\u00b0C). When blank, the global default applies. The project detail weather card flags 'do not work' when the live temperature exceeds this."
    },
    "weather_wind_max_mph": {
      "type": "number",
      "description": "Per-project override for the maximum safe wind gust speed (mph). When blank, the global default applies. The project detail weather card flags 'do not work' when live gusts exceed this."
    },
    "weather_rain_max_mm": {
      "type": "number",
      "description": "Per-project override for the maximum safe rainfall (mm). When blank, the global default applies. The project detail weather card flags 'do not work' when live precipitation exceeds this."
    },
    "weather_lightning_block": {
      "type": "boolean",
      "description": "Per-project override for whether thunderstorms block work. When blank, the global default applies. When true, any thunderstorm (weather code \u2265 95) flags 'do not work' due to lightning risk."
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "drilling",
              "groundworks",
              "depot"
            ],
            "description": "Discipline type key. Simplified to three tracks: 'drilling' (with a CP/Rotary/Window Sampling sub-choice via drilling_method), 'groundworks' (covers all groundworks crews \u2014 enabling, coring, trial pit, etc.), and 'depot' (for projects based at the yard). Legacy types (enabling, enabling_works, supervisor, coring, trial_pit) are migrated to drilling or groundworks."
          },
          "status": {
            "type": "string",
            "enum": [
              "planning",
              "active",
              "completed",
              "on_hold"
            ],
            "default": "planning",
            "description": "Per-discipline status. Each discipline tracks its own lifecycle independently \u2014 groundworks may be completed while drilling is still active."
          },
          "drilling_method": {
            "type": "string",
            "enum": [
              "cp",
              "rotary",
              "window_sampling",
              "mixed",
              "not_applicable"
            ],
            "default": "not_applicable",
            "description": "Drilling method for drilling disciplines only. 'cp' = cable percussion, 'rotary' = rotary drilling, 'window_sampling' = window sampler, 'mixed' = multiple methods, 'not_applicable' = non-drilling."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Discipline-specific start date. Allows staggered starts (e.g. groundworks starts week 1, drilling starts week 3)."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Discipline-specific end date."
          },
          "revenue_method": {
            "type": "string",
            "enum": [
              "none",
              "day_rate",
              "meterage_rate",
              "unit_rate",
              "flat_fee"
            ],
            "default": "none",
            "description": "How revenue is calculated for this discipline. Each discipline can be billed differently (e.g. drilling = meterage, groundworks = day rate)."
          },
          "unit_price": {
            "type": "number",
            "description": "Price per unit for unit-rate billing (this discipline only)."
          },
          "meterage_rate": {
            "type": "number",
            "description": "Per-metre drilling rate for this discipline (drilling only)."
          },
          "meterage_target": {
            "type": "number",
            "description": "Target total metres for this discipline."
          },
          "required_team_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Teams required for this discipline. Staff outside these teams see a soft warning when assigned."
          }
        }
      },
      "default": [],
      "description": "Multi-discipline array \u2014 tracks each discipline (drilling, groundworks, depot) as a separate entry with its own status, dates, revenue method, and required teams. A project with both drilling and groundworks will have two entries here, each independently managed. The legacy single-type fields (job_type, drilling_method, required_team_ids, revenue_method) are kept for backward compatibility and mirror the primary discipline."
    },
    "primary_discipline": {
      "type": "string",
      "description": "The key of the primary discipline (the main driver of the project). Points to a discipline type in the disciplines array. Used for dashboard color-coding and default filtering."
    },
    "job_type": {
      "type": "string",
      "description": "Legacy primary project type key \u2014 mirrors the primary discipline's type for backward compatibility. Managed via Settings \u2192 Project Types. Falls back to the first discipline's type when not set."
    },
    "required_team_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy teams required \u2014 mirrors the primary discipline's required_team_ids for backward compatibility."
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "in_progress",
        "decommissioning",
        "completed",
        "on_hold",
        "cancelled"
      ],
      "default": "planning",
      "description": "Project status. New projects start in 'planning', automatically move to 'in_progress' when the rota is published, then to 'decommissioning' when work finishes and equipment is being collected, and finally 'completed' once all items are returned and the site is cleared."
    },
    "decommissioning_started_at": {
      "type": "string",
      "description": "ISO timestamp when the project was moved to 'decommissioning' status. Set when the 'Finish Project' action is triggered \u2014 kicks off the logistics collection sweep."
    },
    "decommissioning_completed_at": {
      "type": "string",
      "description": "ISO timestamp when all assets were confirmed returned and the project moved to 'completed'."
    },
    "decommissioning_checklist": {
      "type": "object",
      "description": "Final inspection checklist completed during the decommissioning phase before the project can be marked completed.",
      "properties": {
        "photos_uploaded": {
          "type": "boolean",
          "default": false
        },
        "final_meters_recorded": {
          "type": "boolean",
          "default": false
        },
        "site_handback_confirmed": {
          "type": "boolean",
          "default": false
        },
        "all_assets_returned": {
          "type": "boolean",
          "default": false
        },
        "final_notes": {
          "type": "string"
        },
        "handback_contact_name": {
          "type": "string"
        },
        "completed_by_name": {
          "type": "string"
        },
        "completed_at": {
          "type": "string"
        }
      }
    },
    "status_reason": {
      "type": "string",
      "description": "Reason recorded when a project is put on hold or cancelled"
    },
    "status_changed_at": {
      "type": "string",
      "description": "ISO timestamp of the last manual status change (on hold, cancelled, completed, or reactivated)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Project start date (overall \u2014 earliest of all discipline start dates)"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Project end date (overall \u2014 latest of all discipline end dates)"
    },
    "client_id": {
      "type": "string",
      "description": "Associated client"
    },
    "contractor_id": {
      "type": "string",
      "description": "Associated contractor"
    },
    "project_manager": {
      "type": "string",
      "description": "Project manager responsible for the project"
    },
    "site_contact_name": {
      "type": "string",
      "description": "On-site contact name"
    },
    "site_contact_phone": {
      "type": "string",
      "description": "On-site contact phone number"
    },
    "notes": {
      "type": "string",
      "description": "Project notes and details"
    },
    "requisition_list_url": {
      "type": "string",
      "description": "URL of the uploaded requisition/equipment list file"
    },
    "requisition_list_name": {
      "type": "string",
      "description": "Original filename of the requisition list"
    },
    "portal_token": {
      "type": "string",
      "description": "Unique token for client portal access"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether client portal access is enabled for this project"
    },
    "portal_sections": {
      "type": "object",
      "description": "Visibility flags for each section shown on the client portal",
      "properties": {
        "progress": {
          "type": "boolean",
          "default": true
        },
        "client_info": {
          "type": "boolean",
          "default": true
        },
        "schedule": {
          "type": "boolean",
          "default": true
        },
        "notes": {
          "type": "boolean",
          "default": true
        },
        "photos": {
          "type": "boolean",
          "default": true
        },
        "milestones": {
          "type": "boolean",
          "default": true
        },
        "documents": {
          "type": "boolean",
          "default": true
        },
        "comments": {
          "type": "boolean",
          "default": true
        },
        "team": {
          "type": "boolean",
          "default": true
        },
        "client_charge": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "portal_invite_sent_at": {
      "type": "string",
      "description": "ISO timestamp when the last portal invitation email was sent to the client"
    },
    "portal_invite_sent_to": {
      "type": "string",
      "description": "Email address the last portal invitation was sent to (denormalised for display)"
    },
    "budget_amount": {
      "type": "number",
      "description": "Project budget in GBP for cost tracking"
    },
    "actual_cost": {
      "type": "number",
      "description": "Manually recorded actual cost in GBP; overrides the auto-calculated labour cost when set"
    },
    "meterage": {
      "type": "number",
      "description": "Total meters drilled for drilling projects (CP / rotary); overrides shift-level meterage for costing when set"
    },
    "meterage_rate": {
      "type": "number",
      "description": "Legacy per-metre charge rate \u2014 mirrors the primary drilling discipline's meterage_rate for backward compatibility."
    },
    "meterage_target": {
      "type": "number",
      "description": "Legacy target total metres \u2014 mirrors the primary drilling discipline's meterage_target."
    },
    "drilling_method": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "window_sampling",
        "mixed",
        "not_applicable"
      ],
      "default": "not_applicable",
      "description": "Legacy primary drilling method \u2014 mirrors the primary drilling discipline's drilling_method for backward compatibility."
    },
    "revenue_method": {
      "type": "string",
      "enum": [
        "none",
        "day_rate",
        "meterage_rate",
        "unit_rate",
        "flat_fee"
      ],
      "default": "none",
      "description": "Legacy revenue method \u2014 mirrors the primary discipline's revenue_method for backward compatibility."
    },
    "unit_price": {
      "type": "number",
      "description": "Legacy unit price \u2014 mirrors the primary discipline's unit_price."
    },
    "markup_percentage": {
      "type": "number",
      "default": 0,
      "description": "Markup percentage applied to total internal net cost to derive the client price (used when revenue_method is 'none' or as a fallback)."
    },
    "vat_rate": {
      "type": "number",
      "default": 20,
      "description": "VAT rate (%) applied for billing calculations. UK standard rate is 20."
    },
    "client_charge": {
      "type": "number",
      "description": "Legacy manual client charge. Superseded by the calculated billing when cost items/markup are used. Also used as the flat fee when revenue_method is 'flat_fee'."
    },
    "client_charge_description": {
      "type": "string",
      "description": "Label shown alongside the client billing total on the portal (e.g. 'Agreed quote', 'Project Investment')"
    },
    "permanent_crew": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "staff_id": {
            "type": "string",
            "description": "Staff member assigned to the permanent crew."
          },
          "staff_name": {
            "type": "string",
            "description": "Staff name (denormalised for display)."
          },
          "working_days": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Days of week this crew member works (1=Mon \u2026 7=Sun). Drives the recurring pattern."
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "Date the recurring assignment starts."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "Date the recurring assignment ends. Blank = until the project ends."
          }
        },
        "required": [
          "staff_id",
          "working_days"
        ]
      },
      "default": [],
      "description": "Permanent recurring crew \u2014 staff assigned to repeat on a weekly pattern (e.g. Mon\u2013Fri) for the project's duration. When the project's end date is extended, the syncPermanentCrew automation auto-generates RotaAssignment rows for any new working days in the pattern so the crew stays assigned without re-assigning each week."
    }
  },
  "required": [
    "name",
    "location",
    "start_date",
    "end_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}