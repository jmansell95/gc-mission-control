{
  "name": "BillingRule",
  "type": "object",
  "properties": {
    "rule_type": {
      "type": "string",
      "enum": [
        "delivery",
        "task",
        "consumable",
        "site_visit"
      ],
      "description": "Type of chargeable activity this rule applies to. 'delivery' = site deliveries/collections, 'task' = daily tasks staff log, 'consumable' = cable ties/sprays/small equipment, 'site_visit' = ad-hoc site visits."
    },
    "name": {
      "type": "string",
      "description": "Rule name. For task rules, this must match the task description staff enter (e.g. 'Setting up the rig'). For consumables, this is the item name (e.g. 'Cable Ties (bag)')."
    },
    "division_id": {
      "type": "string",
      "description": "The division this billing rule belongs to. Set automatically from the active division when the rule is created. Drives division-scoped filtering \u2014 a division only sees its own billing rules. Blank = unassigned (visible to enterprise admins only)."
    },
    "description": {
      "type": "string",
      "description": "Optional description or internal notes about this billing rule"
    },
    "charge_method": {
      "type": "string",
      "enum": [
        "flat_fee",
        "per_mile",
        "per_hour",
        "per_unit",
        "flat_plus_mileage",
        "flat_plus_time",
        "flat_plus_mileage_plus_time"
      ],
      "default": "flat_fee",
      "description": "How the charge is calculated."
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem \u2014 when set, this rule pulls its rate dynamically from the rate card item's 'price' field. Auto-set by the fuzzy matcher. When locked_rate_card_item_id is also set, that takes precedence."
    },
    "locked_rate_card_item_id": {
      "type": "string",
      "description": "Manual override \u2014 when set, this rule is permanently pinned to this specific RateCardItem. The rate resolver uses this ID directly without fuzzy matching, so wording changes in the rate card never break the link. Managers use this to lock fragile matches. Takes precedence over rate_card_item_id. Shown with a 'Match Locked' badge in the Billing Rules UI."
    },
    "rate_card_item_description": {
      "type": "string",
      "description": "Denormalised description of the linked RateCardItem (for display without joining). Updated when the rule is saved."
    },
    "match_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "locked",
        "unmatched"
      ],
      "description": "Confidence of the rate-card match. 'high' = strong tokenised match, 'medium' = partial match, 'low' = weak match (review recommended), 'locked' = manually pinned via locked_rate_card_item_id, 'unmatched' = no match found. Shown as a badge in the Billing Rules UI."
    },
    "flat_fee": {
      "type": "number",
      "description": "Base flat fee in GBP. Ignored when rate_card_item_id or locked_rate_card_item_id is set."
    },
    "per_mile_rate": {
      "type": "number",
      "description": "Rate per mile in GBP. Ignored when rate_card_item_id or locked_rate_card_item_id is set."
    },
    "per_hour_rate": {
      "type": "number",
      "description": "Rate per hour in GBP. Ignored when rate_card_item_id or locked_rate_card_item_id is set."
    },
    "per_unit_rate": {
      "type": "number",
      "description": "Rate per unit in GBP. Ignored when rate_card_item_id or locked_rate_card_item_id is set."
    },
    "unit_label": {
      "type": "string",
      "default": "each",
      "description": "Unit label for per_unit charges"
    },
    "is_chargeable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rule produces a charge."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rule is available for new charges."
    },
    "category": {
      "type": "string",
      "description": "Sub-category for grouping (e.g. 'drilling', 'groundworks', 'deliveries')."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "rule_type",
    "name",
    "charge_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}