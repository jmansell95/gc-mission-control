{
  "name": "JobDocument",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Associated job"
    },
    "document_url": {
      "type": "string",
      "description": "URL of the uploaded document"
    },
    "document_name": {
      "type": "string",
      "description": "Original filename"
    },
    "category": {
      "type": "string",
      "enum": [
        "site_map",
        "scope_of_work",
        "rams",
        "method_statement",
        "risk_assessment",
        "completion_cert",
        "other"
      ],
      "default": "other",
      "description": "Document category. Site maps and scope of work documents are shown to field staff on their assignment cards so they can review them before and during the job."
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number for RAMS and method statements. Increments when a new revision is uploaded. The highest version is the current/approved one."
    },
    "superseded_by_version": {
      "type": "number",
      "description": "Version number that superseded this document. Null/blank for the current version."
    },
    "is_current_version": {
      "type": "boolean",
      "default": true,
      "description": "True for the latest version of this document. Previous versions are set to false when a new revision is uploaded."
    },
    "signed_off_by": {
      "type": "string",
      "description": "Name of the person who signed off this RAMS/method statement as approved for use."
    },
    "signed_off_at": {
      "type": "string",
      "description": "ISO timestamp when the RAMS was signed off as approved for use."
    },
    "signed_off_by_id": {
      "type": "string",
      "description": "Staff/user ID of the person who signed off this RAMS."
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "description": "Date this RAMS version is valid until. Blank = no expiry. Used to flag RAMS that need review."
    },
    "uploaded_by_name": {
      "type": "string",
      "description": "Who uploaded this document"
    },
    "linked_cost_item_id": {
      "type": "string",
      "description": "Linked equipment/cost item for tracking delivery & collection"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes for equipment delivery (address, contact, timing)"
    },
    "collection_notes": {
      "type": "string",
      "description": "Notes for equipment collection (date, contact, return condition)"
    },
    "client_visible": {
      "type": "boolean",
      "default": false,
      "description": "Whether this document is shown to the client on the client portal"
    },
    "client_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether the client has acknowledged/approved this document via the portal"
    },
    "client_approved_at": {
      "type": "string",
      "description": "ISO timestamp when the client approved this document"
    },
    "client_approved_by_name": {
      "type": "string",
      "description": "Name of the client representative who approved this document"
    }
  },
  "required": [
    "job_id",
    "document_url",
    "document_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}