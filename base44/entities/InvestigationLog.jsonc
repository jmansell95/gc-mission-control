{
  "name": "InvestigationLog",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "description": "Job this log entry belongs to"
    },
    "division_id": {
      "type": "string",
      "description": "The division this log belongs to (inherited from the job's division). Drives division-scoped RLS."
    },
    "assignment_id": {
      "type": "string",
      "description": "RotaAssignment this log was recorded from (optional)"
    },
    "staff_id": {
      "type": "string",
      "description": "Staff member who recorded the log"
    },
    "staff_name": {
      "type": "string",
      "description": "Staff member name (for display)"
    },
    "logged_by_role": {
      "type": "string",
      "enum": [
        "driller",
        "engineer",
        "groundworker",
        "enabling_crew",
        "supervisor",
        "subcontractor",
        "client",
        "contractor",
        "ags_import",
        "unspecified"
      ],
      "default": "unspecified",
      "description": "The role of the person who logged this entry (driller, engineer, groundworker, etc.). Populated from the AGS file's name fields or from the staff member's team job_type. 'unspecified' is shown with a 'No name entered' alert in the UI so managers know attribution is missing. 'ags_import' = no human name was found in the file at all."
    },
    "source": {
      "type": "string",
      "enum": [
        "staff",
        "ags_import",
        "keylogbook_remarks"
      ],
      "default": "staff",
      "description": "Where this log originated. 'staff' = manually entered by a crew member in the app; 'ags_import' = ingested from a KeyLogBook AGS file (borehole/strata/SPT/sample data, read-only); 'keylogbook_remarks' = parsed from the driller's time-stamped daily remarks via the KeyLogBook webhook. These are the professionalised Site Logs that feed the timesheet on manager approval."
    },
    "external_klb_id": {
      "type": "string",
      "description": "External KeyLogBook record ID used for idempotent upsert during pull sync. Set to 'klb_bh_<id>' for borehole records and 'klb_rem_<id>_<index>' for parsed remark activities. When present, re-running the pull sync updates the existing record in place instead of creating a duplicate. Blank for manually-entered logs and webhook-imported logs (webhook data uses overwrite mode via job+date+source deletion instead)."
    },
    "raw_remarks": {
      "type": "string",
      "description": "The original verbatim driller remark text exactly as entered in KeyLogBook, before AI professionalisation. Preserved so managers can audit what the driller actually wrote versus the cleaned report-ready description stored in 'description'. Only set on source='keylogbook_remarks' logs; blank for staff-entered and ags_import technical logs."
    },
    "start_time": {
      "type": "string",
      "description": "Start time of this activity in HH:MM format"
    },
    "end_time": {
      "type": "string",
      "description": "End time of this activity in HH:MM format"
    },
    "crew_type": {
      "type": "string",
      "enum": [
        "internal",
        "enabling",
        "subcontractor"
      ],
      "default": "internal",
      "description": "Which type of crew recorded this log."
    },
    "subcontractor_id": {
      "type": "string",
      "description": "Linked Contractor record when crew_type is 'subcontractor'."
    },
    "completed_by_type": {
      "type": "string",
      "enum": [
        "internal_staff",
        "client",
        "contractor"
      ],
      "default": "internal_staff",
      "description": "Who performed the logged activity."
    },
    "completed_by_name": {
      "type": "string",
      "description": "Name of the client/contractor representative who performed the work."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the work was carried out"
    },
    "log_type": {
      "type": "string",
      "enum": [
        "borehole_progress",
        "sample_collection",
        "window_sampling",
        "pit_excavation",
        "inspection_pit",
        "installation",
        "grouting_works",
        "site_setup",
        "reinstatement",
        "standpipe_reading",
        "geophysical_probing",
        "borehole_decommissioning",
        "core_inspection",
        "other"
      ],
      "description": "Type of investigation activity."
    },
    "borehole_ref": {
      "type": "string",
      "description": "Borehole or pit reference (e.g. BH-01, CP-03, TP-02)"
    },
    "borehole_status": {
      "type": "string",
      "enum": [
        "complete",
        "in_progress",
        "unchecked"
      ],
      "description": "Borehole completion status from the AGS LOCA_STAT field. 'complete' = borehole finished (LOCA_STAT=COMPLETE), 'in_progress' = still being drilled (LOCA_STAT=INPROG), 'unchecked' = status not yet confirmed (LOCA_STAT=UNCHECKED or blank). Only set on borehole_progress logs (source='ags_import'); blank for other log types. Drives the in-progress/completed badges on borehole cards and the dashboard widget."
    },
    "drilling_method": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "mixed",
        "unknown"
      ],
      "description": "Drilling method used for this borehole, parsed from the AGS LOCA_TYPE field. 'cp' = Cable Percussion, 'rotary' = Rotary drilling (including rotary core), 'mixed' = both methods used, 'unknown' = method not specified in the AGS file. Only set on borehole_progress logs (source='ags_import'). Displayed as a badge on borehole cards so managers can see at a glance whether a hole was CP or Rotary."
    },
    "project_engineer": {
      "type": "string",
      "description": "Project engineer from the AGS PROJ_ENG field \u2014 the engineer who designed/specified the borehole. Stored separately from staff_name (the driller) so both the engineer and the driller are visible on the borehole card."
    },
    "device_name": {
      "type": "string",
      "description": "Rig/device name from the AGS HDPH_EXC field (e.g. 'Dando 2000'). The specific drilling rig or device used for this borehole, parsed per-shift from the HDPH group so the correct device is shown for each drilling phase."
    },
    "crew_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Full list of ALL crew member names who worked on this borehole/activity, parsed from HDPH_LOG and HDPH_CREW. Every name is kept (not just the first comma-separated one) so multi-person crews are fully attributed. For per-shift activities (DLOG/PTIM/HDIA), only the crew for that specific shift is listed; for borehole-level technical logs, all crew across all shifts are aggregated."
    },
    "shift_id": {
      "type": "string",
      "description": "KeyLogBook shift ID (SHFT_ID) linking this log to a specific drilling shift. Used to attribute the correct crew to each activity \u2014 activities from different shifts on the same borehole show different drillers."
    },
    "shift_start_time": {
      "type": "string",
      "description": "Shift start time (HH:MM) from SHFT_STAR for the shift this activity belongs to."
    },
    "shift_end_time": {
      "type": "string",
      "description": "Shift end time (HH:MM) from SHFT_ENDD for the shift this activity belongs to."
    },
    "borehole_start_date": {
      "type": "string",
      "format": "date",
      "description": "Borehole drilling start date from AGS LOCA_STAR (when drilling began on this hole)."
    },
    "borehole_end_date": {
      "type": "string",
      "format": "date",
      "description": "Borehole drilling end date from AGS LOCA_ENDD (when drilling was completed on this hole)."
    },
    "depth_from": {
      "type": "number",
      "description": "Start depth in metres"
    },
    "depth_to": {
      "type": "number",
      "description": "End depth in metres"
    },
    "sample_id": {
      "type": "string",
      "description": "Sample reference number"
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "disturbed",
        "undisturbed",
        "water",
        "none"
      ],
      "default": "none",
      "description": "Type of sample collected"
    },
    "units_completed": {
      "type": "number",
      "description": "Number of units completed"
    },
    "units_label": {
      "type": "string",
      "description": "Unit label (e.g. 'chargers', 'pits', 'metres')"
    },
    "dimensions": {
      "type": "string",
      "description": "Dimensions"
    },
    "description": {
      "type": "string",
      "description": "Description of the work carried out or observations. For keylogbook_remarks logs this holds the AI-professionalised, report-ready English; the original verbatim driller text is preserved separately in raw_remarks."
    },
    "duration_minutes": {
      "type": "number",
      "description": "How long this activity took in minutes"
    },
    "photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of evidence photos"
    },
    "created_at": {
      "type": "string",
      "description": "ISO timestamp when this log was created"
    },
    "spt_blows": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "SPT blow counts at each 75mm increment"
    },
    "spt_n_value": {
      "type": "number",
      "description": "Calculated SPT N-value"
    },
    "groundwater_strike_depth": {
      "type": "number",
      "description": "Depth in metres at which groundwater was first encountered"
    },
    "groundwater_static_level": {
      "type": "number",
      "description": "Depth in metres to the stabilised groundwater level"
    },
    "drilling_fluid_loss": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "total"
      ],
      "default": "none",
      "description": "Drilling fluid loss during drilling."
    },
    "fluid_return_quality": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "lost"
      ],
      "default": "full",
      "description": "Quality of drilling fluid return to surface."
    },
    "refusal_encountered": {
      "type": "boolean",
      "default": false,
      "description": "Whether drilling or probing refusal was encountered."
    },
    "obstruction_type": {
      "type": "string",
      "enum": [
        "none",
        "boulder",
        "concrete",
        "utilities",
        "void",
        "other"
      ],
      "default": "none",
      "description": "Type of obstruction encountered."
    },
    "standpipe_ref": {
      "type": "string",
      "description": "Standpipe piezometer reference"
    },
    "standpipe_reading_m": {
      "type": "number",
      "description": "Standpipe water level reading in metres below ground level (mBGL)."
    },
    "standpipe_dip_depth_m": {
      "type": "number",
      "description": "Depth to water measured from the top of the standpipe casing (m below TOC)."
    },
    "strata_descriptor": {
      "type": "string",
      "enum": [
        "topsoil",
        "made_ground",
        "clay_soft",
        "clay_firm",
        "clay_stiff",
        "sand_loose",
        "sand_medium_dense",
        "sand_dense",
        "gravel",
        "silt",
        "peat",
        "chalk",
        "mudstone",
        "sandstone",
        "limestone",
        "granite",
        "concrete",
        "tarmac",
        "other"
      ],
      "default": "other",
      "description": "Standardised strata classification per BS 5930"
    },
    "strata_description_detail": {
      "type": "string",
      "description": "Free-text detail supplementing the standardised strata descriptor"
    },
    "coring_rqd": {
      "type": "number",
      "description": "Rock Quality Designation percentage"
    },
    "coring_recovery": {
      "type": "number",
      "description": "Core recovery percentage"
    },
    "core_run_number": {
      "type": "string",
      "description": "Core run reference (e.g. C1, C2)"
    },
    "core_box_number": {
      "type": "string",
      "description": "Core box number for core_inspection logs"
    },
    "pit_stability_rating": {
      "type": "string",
      "enum": [
        "stable",
        "minor_slumping",
        "collapse",
        "not_assessed"
      ],
      "default": "not_assessed",
      "description": "Wall stability assessment for trial pits"
    },
    "service_encounter_type": {
      "type": "string",
      "enum": [
        "none",
        "gas",
        "water",
        "electric",
        "telecom",
        "drainage",
        "unknown"
      ],
      "default": "none",
      "description": "Type of underground service encountered during excavation."
    },
    "service_encounter_gps": {
      "type": "string",
      "description": "GPS coordinates (lat,lng) of any service encountered"
    },
    "service_check_by_type": {
      "type": "string",
      "enum": [
        "internal_staff",
        "client",
        "contractor"
      ],
      "default": "internal_staff",
      "description": "Who performed the service check / verification."
    },
    "service_check_by_name": {
      "type": "string",
      "description": "Name of the person who performed the service check."
    },
    "service_check_at": {
      "type": "string",
      "description": "ISO timestamp of when the service check was carried out."
    },
    "cbr_value": {
      "type": "number",
      "description": "California Bearing Ratio test result (%)"
    },
    "vane_strength": {
      "type": "number",
      "description": "Hand vane shear strength test result (kPa)"
    },
    "verification_photo_urls": {
      "type": "string",
      "description": "Comma-separated URLs of pre-dig and post-dig verification photos"
    },
    "reinstatement_type": {
      "type": "string",
      "enum": [
        "none",
        "backfilled",
        "granular_fill",
        "concrete",
        "tarmac",
        "left_open",
        "other"
      ],
      "default": "none",
      "description": "Type of reinstatement carried out after the investigation"
    },
    "backfill_material": {
      "type": "string",
      "description": "Material used for backfilling"
    },
    "grout_volume": {
      "type": "number",
      "description": "Volume of grout mixed/placed in litres"
    },
    "mixer_type": {
      "type": "string",
      "enum": [
        "machine_mixer",
        "hand_mix",
        "ready_mixed",
        "none"
      ],
      "default": "none",
      "description": "Mixing method used for grouting."
    },
    "grout_mix_ratio": {
      "type": "string",
      "description": "Grout mix ratio"
    },
    "seal_depth": {
      "type": "number",
      "description": "Depth in metres to which a borehole was sealed/backfilled during decommissioning."
    },
    "probe_depth": {
      "type": "number",
      "description": "Depth reached by geophysical probing (m)."
    },
    "sensor_type": {
      "type": "string",
      "description": "Type of sensor/probe used for geophysical probing."
    },
    "site_passport_id": {
      "type": "string",
      "description": "Links this log to the Site Passport / Permit to Dig record."
    },
    "manager_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "queried"
      ],
      "default": "pending",
      "description": "Manager review status."
    },
    "manager_review_note": {
      "type": "string",
      "description": "Note from the manager when querying or approving this log entry"
    },
    "manager_reviewed_by": {
      "type": "string",
      "description": "Name of the manager who reviewed this log entry"
    },
    "manager_reviewed_at": {
      "type": "string",
      "description": "ISO timestamp of when the manager reviewed this log entry"
    },
    "chargeable": {
      "type": "boolean",
      "default": true,
      "description": "Whether this investigation activity is chargeable to the client"
    },
    "billing_rule_id": {
      "type": "string",
      "description": "BillingRule used to calculate the charge for this activity"
    },
    "charge_amount": {
      "type": "number",
      "description": "Calculated charge amount in GBP (set by calculateCharge)"
    },
    "charge_breakdown": {
      "type": "string",
      "description": "JSON breakdown of how the charge was calculated"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "auto",
        "no_charge",
        "custom_fee"
      ],
      "default": "auto",
      "description": "How the charge was determined."
    },
    "custom_fee": {
      "type": "number",
      "description": "Manual fee override in GBP"
    },
    "pricing_review_status": {
      "type": "string",
      "enum": [
        "auto_matched",
        "pending_review",
        "reviewed",
        "rejected"
      ],
      "default": "auto_matched",
      "description": "Hybrid keyword-matching review state. 'auto_matched' = high-confidence dictionary match, priced instantly, no review needed; 'pending_review' = low-confidence or unknown keyword, awaiting billing team confirmation; 'reviewed' = billing team confirmed/corrected the match (teaches the dictionary); 'rejected' = billing team rejected the charge (item not billable)."
    },
    "suggested_rate_card_item_id": {
      "type": "string",
      "description": "When pricing_review_status is 'pending_review', the rate card item the fuzzy matcher proposed. The billing team confirms or replaces this in the review queue."
    },
    "pricing_reviewed_at": {
      "type": "string",
      "description": "ISO timestamp of when the billing team reviewed the pricing match."
    },
    "pricing_reviewed_by": {
      "type": "string",
      "description": "Name of the billing team member who reviewed the pricing match."
    }
  },
  "required": [
    "job_id",
    "staff_id",
    "date",
    "log_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}