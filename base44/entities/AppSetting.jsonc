{
  "name": "AppSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. 'global', 'gl_code_mapping', 'concur_config'). For integration configs, multiple records may share the same key \u2014 one per business stream, distinguished by division_id."
    },
    "division_id": {
      "type": "string",
      "description": "The business stream this config record belongs to. When set, this record holds the per-stream integration credentials (so each stream can connect its own Geotab/Holman/Asset Panda accounts). Blank/null = global/shared config (used when no division is active, and as the backend fallback). Most existing records have this blank."
    },
    "app_base_url": {
      "type": "string",
      "description": "Public base URL of the app, used to build links inside automated email alerts"
    },
    "company_name": {
      "type": "string",
      "description": "Company name shown in email banners and footers by default"
    },
    "default_accent_color": {
      "type": "string",
      "description": "Default accent colour for all automated emails (hex)"
    },
    "default_banner_title": {
      "type": "string",
      "description": "Default banner title for all automated emails"
    },
    "default_show_banner": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the email banner by default"
    },
    "default_footer_text": {
      "type": "string",
      "description": "Default footer text for all automated emails"
    },
    "label": {
      "type": "string",
      "description": "Human-readable label for this setting (used when this record stores a generic config value)"
    },
    "value": {
      "type": "object",
      "description": "Generic JSON value for this setting key \u2014 used by the Financial Control Hub to store GL code mappings, Concur API config, and sub-con markup rules. Stores any structured config that doesn't warrant its own entity."
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}