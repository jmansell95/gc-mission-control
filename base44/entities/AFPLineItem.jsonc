{
  "name": "AFPLineItem",
  "type": "object",
  "properties": {
    "afp_id": {
      "type": "string",
      "description": "The AFP this line item belongs to."
    },
    "job_id": {
      "type": "string",
      "description": "The job this line item belongs to (denormalised for direct job-level queries)."
    },
    "sheet_name": {
      "type": "string",
      "enum": [
        "drilling",
        "plant_hire",
        "rates",
        "measured_works",
        "variations",
        "materials",
        "compensation_item",
        "ewr_rotary_drilling",
        "ewr_cp_drilling",
        "ewr_rotary_dayworks",
        "ewr_cp_dayworks",
        "ewr_enabling_crew",
        "ewr_accommodation",
        "ewr_misc",
        "ewr_hires",
        "ewr_mileage"
      ],
      "default": "measured_works",
      "description": "Which AFP sheet this line item belongs to. Lump Sum format: 'measured_works' = Measured Works sheet (main line items), 'variations' = Variation Summary sheet, 'materials' = Materials On site sheet, 'compensation_item' = CI01-03 compensation item sheets. EWR format: 'ewr_rotary_drilling'/'ewr_cp_drilling' = Rotary/CP Drilling sheets (per-borehole meterage), 'ewr_rotary_dayworks'/'ewr_cp_dayworks' = Rotary/CP Dayworks-Standing Time sheets (time-based entries), 'ewr_enabling_crew' = Enabling Crew sheet, 'ewr_accommodation' = Accommodation sheet, 'ewr_misc' = Misc sheet, 'ewr_hires' = Hires sheet, 'ewr_mileage' = Mileage sheet. Legacy format (kept for backward compat): 'drilling', 'plant_hire', 'rates'."
    },
    "category": {
      "type": "string",
      "enum": [
        "drilling",
        "plant_hire",
        "labour",
        "subcontractor",
        "materials",
        "mobilisation",
        "delivery",
        "other"
      ],
      "default": "other",
      "description": "Billing category for this line item. Used to group items in the AFP Builder and for rate card matching. 'drilling' = meterage/rig items, 'plant_hire' = equipment hire, 'labour' = crew/time, 'subcontractor' = sub-contracted work, 'materials' = consumables, 'mobilisation' = site setup, 'delivery' = transport."
    },
    "item_ref": {
      "type": "string",
      "description": "The original Item Ref from the AFP Excel (e.g. 'MW-01', 'VO-03'). Separate from the item description so both the reference and the description are preserved exactly as they appear in the spreadsheet."
    },
    "item": {
      "type": "string",
      "description": "Item description (e.g. 'Mobilise cable Percussion Rig to site - GC', 'Coreliners')."
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (e.g. 'Sum', 'nr', 'Day', 'm', 'hour')."
    },
    "unit_price": {
      "type": "number",
      "description": "Unit price / rate per unit. Matched from the rate card / Master Price List during population."
    },
    "qty": {
      "type": "number",
      "description": "Contracted quantity for this line item (the total agreed qty from the BOQ / Measured Works sheet). For dual-side AFPs this is the contracted total; applied quantities are tracked in qty_complete / gross_applied / previous_applied / applied_in_period."
    },
    "rate": {
      "type": "number",
      "description": "Rate applied to this line item. Matched from the rate card or manually set by the billing team."
    },
    "amount": {
      "type": "number",
      "description": "Contracted total amount for this line item = qty \u00d7 rate (the full contract value of the line). For dual-side AFPs, the per-period claimed amount is tracked in applied_in_period."
    },
    "qty_complete": {
      "type": "number",
      "description": "Our claim side \u2014 total quantity completed to date (cumulative across all AFPs). Equals gross_applied for quantity. Pulled from the Measured Works 'Qty Complete' column."
    },
    "gross_applied": {
      "type": "number",
      "description": "Our claim side \u2014 cumulative gross amount applied to date across all AFPs (including this period). Pulled from the Measured Works 'Gross Applied' column."
    },
    "previous_applied": {
      "type": "number",
      "description": "Our claim side \u2014 cumulative amount applied in all PRIOR AFPs (excludes this period). Pulled from the Measured Works 'Previous Applied' column. applied_in_period = gross_applied - previous_applied."
    },
    "applied_in_period": {
      "type": "number",
      "description": "Our claim side \u2014 the amount being claimed in THIS AFP period. Auto-calculated as gross_applied - previous_applied, or summed from the Field Sheet's daily quantity for this period. This is the value that rolls up into the AFP's total_claimed."
    },
    "assessed_qty": {
      "type": "number",
      "description": "Client assessment side \u2014 total quantity the client has assessed/agreed to date (cumulative). Pulled from the Measured Works 'Assessed Measure' column."
    },
    "gross_assessed": {
      "type": "number",
      "description": "Client assessment side \u2014 cumulative gross amount the client has assessed to date (including this period). Pulled from the Measured Works 'Gross Assessed' column."
    },
    "previous_assessed": {
      "type": "number",
      "description": "Client assessment side \u2014 cumulative amount the client assessed in all PRIOR AFPs (excludes this period). Pulled from the Measured Works 'Previous Assessed' column."
    },
    "assessed_in_period": {
      "type": "number",
      "description": "Client assessment side \u2014 the amount the client has agreed to pay for THIS AFP period. Entered by the billing team when the client responds. Rolls up into the AFP's agreed_total."
    },
    "balance_qty": {
      "type": "number",
      "description": "Balance Remaining \u2014 quantity still to be applied on this line = contracted qty - qty_complete (or gross_applied qty). Auto-calculated."
    },
    "balance_value": {
      "type": "number",
      "description": "Balance Remaining \u2014 value still to be claimed on this line = contracted amount - gross_applied (or contracted amount - gross_assessed). Auto-calculated. Shown in the Balance Remaining column group."
    },
    "vo_ref": {
      "type": "string",
      "description": "Variation order reference (e.g. 'VO-01'). Only set on variation line items (sheet_name='variations'). Pulled from the Variation Summary 'VO Ref' column."
    },
    "vo_date": {
      "type": "string",
      "format": "date",
      "description": "The date the variation was instructed/raised. Only set on variation line items. Pulled from the Variation Summary 'Date' column. Used to assign the VO to the correct AFP period."
    },
    "time_impact": {
      "type": "boolean",
      "default": false,
      "description": "Whether this variation has a programme/time impact. Pulled from the Variation Summary 'Time Impact (Yes/No)' column."
    },
    "time_impact_days": {
      "type": "number",
      "description": "Number of programme days impacted by this variation. Pulled from the Variation Summary 'Days' column."
    },
    "budget_cost_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Variation cost-agreement lifecycle \u2014 the date the budget cost was issued to the client. Stage 1 of 4 in the VO cost-agreement workflow."
    },
    "firm_cost_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Variation cost-agreement lifecycle \u2014 the date the firm cost was issued. Stage 2 of 4."
    },
    "client_assessment_issue_date": {
      "type": "string",
      "format": "date",
      "description": "Variation cost-agreement lifecycle \u2014 the date the client issued their assessment. Stage 3 of 4."
    },
    "cost_agreed_date": {
      "type": "string",
      "format": "date",
      "description": "Variation cost-agreement lifecycle \u2014 the date the cost was formally agreed. Stage 4 of 4. When set, the VO is fully agreed."
    },
    "source": {
      "type": "string",
      "enum": [
        "driller_log",
        "delivery",
        "subcontractor",
        "timesheet",
        "cost",
        "job_cost_item",
        "template",
        "manual",
        "afp_upload"
      ],
      "default": "manual",
      "description": "Where this line item came from. 'driller_log' = from InvestigationLog, 'delivery' = from DeliveryLog or JobAssetAssignment, 'subcontractor' = from SubcontractorLog, 'timesheet' = from Timesheet (approved only), 'cost' = from DailyCost, 'job_cost_item' = from JobCostItem (equipment/labour added to the job), 'template' = from the AFP template, 'manual' = manually added by the billing team, 'afp_upload' = imported from an AFP Excel upload."
    },
    "source_date": {
      "type": "string",
      "format": "date",
      "description": "The date of the underlying field record. Used for Day/Week/Month grouping in the AFP Builder. For grouped items (e.g. weekly labour), this is the week-commencing date."
    },
    "source_id": {
      "type": "string",
      "description": "ID of the source record (InvestigationLog ID, SubcontractorLog ID, etc.). Used to prevent duplicate line items when re-populating, and as the upsert key for real-time auto-population. For grouped timesheet lines this is 'ts_<date>'."
    },
    "is_manual": {
      "type": "boolean",
      "default": false,
      "description": "True when this line item was manually added by the billing team (not auto-populated from field data). Manual items are preserved when 'Refresh from Field Data' is run."
    },
    "dispute_status": {
      "type": "string",
      "enum": [
        "none",
        "disputed",
        "counter_offered",
        "agreed",
        "rejected"
      ],
      "default": "none",
      "description": "Client dispute status for this line item. 'none' = undisputed (counts toward agreed total); 'disputed' = client pushed back, awaiting our response; 'counter_offered' = we've made a counter-offer, awaiting client response; 'agreed' = both parties agreed on the adjusted amount; 'rejected' = client rejected and we've accepted the rejection (item removed from agreed total)."
    },
    "dispute_note": {
      "type": "string",
      "description": "Latest dispute note from the billing team or client. Summarises the current state of the negotiation for this item."
    },
    "original_amount": {
      "type": "number",
      "description": "The original amount before any dispute adjustment. Captured when the AFP is submitted to the client. Used to show original vs agreed in the dispute UI."
    },
    "agreed_amount": {
      "type": "number",
      "description": "The final agreed amount after dispute resolution. Equals 'amount' for undisputed items. For dual-side AFPs, this mirrors assessed_in_period. Used to calculate the AFP's agreed_total."
    },
    "dispute_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "ISO timestamp of the dispute action."
          },
          "user_name": {
            "type": "string",
            "description": "Name of the user who performed the action."
          },
          "action": {
            "type": "string",
            "enum": [
              "disputed",
              "counter_offered",
              "agreed",
              "rejected",
              "note_added",
              "amount_adjusted"
            ],
            "description": "The type of dispute action."
          },
          "note": {
            "type": "string",
            "description": "Note accompanying the action."
          },
          "amount": {
            "type": "number",
            "description": "The amount at the time of this action (for counter-offers and adjustments)."
          }
        },
        "required": [
          "timestamp",
          "action"
        ]
      },
      "default": [],
      "description": "Full back-and-forth negotiation history for this line item. Each entry records a dispute action (disputed, counter-offered, agreed, rejected) with timestamp, user, note, and amount at the time."
    },
    "week_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week_date": {
            "type": "string",
            "description": "Week commencing date (ISO date string). For EWR drilling lines, this stores the borehole reference (e.g. 'BH746') instead of a date."
          },
          "qty": {
            "type": "number",
            "description": "Quantity for this specific week. For EWR drilling lines, this is the per-borehole quantity."
          }
        },
        "required": [
          "week_date"
        ]
      },
      "default": [],
      "description": "Week-by-week breakdown for drilling line items. Each entry maps a week-commencing date to the quantity drilled that week. For EWR drilling lines, this stores per-borehole quantities (week_date = borehole ref, qty = borehole qty)."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order within the AFP."
    }
  },
  "required": [
    "afp_id",
    "job_id",
    "sheet_name",
    "item"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}