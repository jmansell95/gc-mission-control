{
  "name": "HotelBooking",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string",
      "description": "DEPRECATED \u2014 legacy single-staff field. Use assigned_staff_ids instead."
    },
    "staff_name": {
      "type": "string",
      "description": "DEPRECATED \u2014 legacy single-staff display name. Use assigned_staff_names instead."
    },
    "assigned_staff_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff member IDs assigned to this booking for the job. A crew member can appear in multiple bookings on the same job (e.g. Hotel A for week 1, Air B&B for week 2)."
    },
    "assigned_staff_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Staff member names (for display), parallel to assigned_staff_ids."
    },
    "job_id": {
      "type": "string",
      "description": "Job this booking is associated with"
    },
    "job_name": {
      "type": "string",
      "description": "Job name (for display)"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "hotel",
        "airbnb"
      ],
      "default": "hotel",
      "description": "Type of accommodation. 'hotel' = cost is per-room-per-night (total = cost_per_night \u00d7 room_count \u00d7 nights). 'airbnb' = cost is a single total for the entire stay, split evenly across all assigned crew (per-person day rate = total_cost \u00f7 crew_count \u00f7 nights). Existing bookings without this field default to 'hotel'."
    },
    "hotel_name": {
      "type": "string",
      "description": "Name of the hotel or Air B&B property"
    },
    "address": {
      "type": "string",
      "description": "Property address"
    },
    "check_in_date": {
      "type": "string",
      "format": "date",
      "description": "Check-in date"
    },
    "check_out_date": {
      "type": "string",
      "format": "date",
      "description": "Check-out date"
    },
    "booking_reference": {
      "type": "string",
      "description": "Booking confirmation / reference number"
    },
    "po_number": {
      "type": "string",
      "description": "DEPRECATED \u2014 kept for backward compatibility. No longer shown in the editor UI."
    },
    "room_type": {
      "type": "string",
      "description": "DEPRECATED \u2014 kept for backward compatibility. No longer shown in the editor UI."
    },
    "room_count": {
      "type": "number",
      "default": 1,
      "description": "Number of rooms booked (hotel only). Total hotel cost = cost_per_night \u00d7 room_count \u00d7 nights. Not used for Air B&B bookings."
    },
    "cost_per_night": {
      "type": "number",
      "description": "Cost per room per night in GBP (hotel only). Not used for Air B&B bookings."
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost for the entire stay in GBP (Air B&B only). The per-person share = total_cost \u00f7 assigned_staff_count, and the per-person day rate = share \u00f7 nights. Not used for hotel bookings."
    },
    "contact_phone": {
      "type": "string",
      "description": "Property contact phone number"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes (e.g. parking, breakfast included)"
    }
  },
  "required": [
    "job_id",
    "hotel_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}