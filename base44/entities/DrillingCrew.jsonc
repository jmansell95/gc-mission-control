{
  "name": "DrillingCrew",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Drilling crew name (e.g. 'Crew 1', 'Crew A'). For subcontractor 2-man crews, auto-generated as 'Lead Name + Second Name' when not set."
    },
    "crew_type": {
      "type": "string",
      "enum": [
        "cp",
        "rotary"
      ],
      "description": "Type of drilling crew (legacy field \u2014 kept for backward compatibility with the original DrillingCrew entity used in team management)."
    },
    "supervisor_id": {
      "type": "string",
      "description": "Supervisor/team leader staff ID (legacy field \u2014 kept for backward compatibility)."
    },
    "team_id": {
      "type": "string",
      "description": "Team this crew belongs to (legacy field \u2014 kept for backward compatibility)."
    },
    "lead_driller_staff_id": {
      "type": "string",
      "description": "The Lead Driller Staff record linked to this crew. For subcontractor 2-man crews, this is the Lead Driller whose name appears on the rota sub-line."
    },
    "second_man_staff_id": {
      "type": "string",
      "description": "The Second Man Staff record linked to this crew. For subcontractor 2-man crews, this is the Second Man whose name appears on the rota sub-line."
    },
    "parent_staff_id": {
      "type": "string",
      "description": "The parent subcontractor Staff record this crew belongs to. Multiple crews can share the same parent_staff_id \u2014 one per 2-man pairing. This is how crews are grouped under a subcontractor in the Contacts tab."
    },
    "parent_contractor_id": {
      "type": "string",
      "description": "Alternative parent: the Contractor record this crew belongs to (when the subcontractor is tracked as a Contractor entity rather than a Staff record). Blank when parent_staff_id is used."
    },
    "division_id": {
      "type": "string",
      "description": "The division this crew belongs to (inherited from the parent subcontractor). Drives division-scoped filtering."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "True when this crew is active and available for rota assignment. Set to false when a crew is disbanded or no longer working."
    },
    "lead_driller_name": {
      "type": "string",
      "description": "Lead Driller name (denormalised from the linked Staff record for quick display without a join). Kept in sync when the crew is created or updated."
    },
    "lead_driller_phone": {
      "type": "string",
      "description": "Lead Driller phone number (denormalised from the linked Staff record for quick display)."
    },
    "second_man_name": {
      "type": "string",
      "description": "Second Man name (denormalised from the linked Staff record for quick display)."
    },
    "second_man_phone": {
      "type": "string",
      "description": "Second Man phone number (denormalised from the linked Staff record for quick display)."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}