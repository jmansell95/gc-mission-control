{
  "name": "SiteAsset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Asset name (e.g. 'Truck-mounted Rig 1', 'Trailer T-03', 'Excavator CAT 320', '110V Transformer T-12')"
    },
    "division_id": {
      "type": "string",
      "description": "The division this asset belongs to. Set automatically from the active division when the asset is created. Drives division-scoped filtering \u2014 a division only sees its own assets and equipment. Blank = unassigned (visible to enterprise admins only)."
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "rig",
        "machinery",
        "trailer",
        "vehicle",
        "lifting",
        "portable_appliance"
      ],
      "description": "Type of asset \u2014 'lifting' covers lifting gear (shackles, slings, chains, hooks) linked to rigs; 'portable_appliance' covers portable electrical equipment (110V transformers, power tools, leads, RCDs) requiring PAT testing."
    },
    "equipment_type": {
      "type": "string",
      "description": "Equipment type (e.g. 'Overshot Tool', 'Sling', 'Shackle', '110V Transformer'). More specific than asset_type."
    },
    "compliance_category": {
      "type": "string",
      "description": "Raw category label (e.g. 'Lifting Gear', 'Plant', 'Vehicle', 'Portable Appliance'). Stored alongside the derived asset_type enum so the original grouping is always reflected exactly."
    },
    "rig_type": {
      "type": "string",
      "enum": [
        "cp",
        "rotary",
        "n/a"
      ],
      "default": "n/a",
      "description": "Drilling rig type \u2014 CP (cable percussion) or Rotary. Only set when asset_type is 'rig'."
    },
    "is_rig": {
      "type": "boolean",
      "default": false,
      "description": "True when this asset is a drilling rig (CP or Rotary). Used to decouple rig assignment (handled via the dedicated rig flow) from general owned-equipment selection on jobs. Set automatically based on the asset type."
    },
    "serial_number": {
      "type": "string",
      "description": "Manufacturer serial number, asset tag or registration. Pulled from Asset Panda 'Serial No' (field_260)."
    },
    "barcode": {
      "type": "string",
      "description": "Asset Panda barcode value \u2014 the dedicated 'Barcode'/'Asset Tag' field encoded in the Asset Panda barcode labels. Used by the scanner (resolveAssetByQR) to match a scanned Asset Panda barcode to this asset, and pushed back to Asset Panda on bidirectional sync. Auto-detected from group field labels ('barcode', 'asset tag', 'tag id') or via the configured field map."
    },
    "qr_code": {
      "type": "string",
      "description": "System-generated QR code value (e.g. 'GC-<uuid>') for this asset. Generated automatically on Asset Panda sync for every asset that doesn't already have one. Encoded into printable QR labels and resolved by the scanner (resolveAssetByQR) so the asset can be booked in/out by scanning its printed label. Idempotent \u2014 once set, never overwritten by sync."
    },
    "fleet_number": {
      "type": "string",
      "description": "FAA / Fleet Number \u2014 the primary fleet reference number from Asset Panda (field_1 'Fleet Number'). This is the prominent reference shown on asset cards and the detail hero. Distinct from serial_number which is the manufacturer's serial."
    },
    "make": {
      "type": "string",
      "description": "Manufacturer / make of the asset (e.g. 'Caterpillar', 'Toyota', 'Honda', 'Bosch'). Pulled from Asset Panda 'Make' (field_6)."
    },
    "model": {
      "type": "string",
      "description": "Model of the asset (e.g. '320', 'Hilux', 'GX'). Pulled from Asset Panda 'Model' (field_8)."
    },
    "length": {
      "type": "number",
      "description": "Length in metres \u2014 primarily for casing items but stored for any asset where Asset Panda provides a length value. Shown as a badge on casing items in the asset grid."
    },
    "fuel_type": {
      "type": "string",
      "description": "Fuel type (e.g. 'Diesel', 'Petrol', 'Electric', 'Hybrid'). Pulled from Asset Panda 'Fuel Type' (field_242)."
    },
    "condition": {
      "type": "string",
      "description": "Physical condition reported by Asset Panda (field_254 'Condition' \u2014 e.g. 'Good', 'Fair', 'Poor', 'Needs Repair'). Colour-coded in the UI: green = good, amber = fair, red = poor."
    },
    "hours_used": {
      "type": "number",
      "description": "Hours used / engine hours as reported by Asset Panda (field_256 'Hours Used'). This is the Panda-reported figure, distinct from the calculated operating_hours field which is derived from drilling-duration logs."
    },
    "colour": {
      "type": "string",
      "description": "Identifying colour of the asset (e.g. rig painted red, blue). Pulled from GC Compliance Manager. Used for quick visual identification on site and in the yard."
    },
    "external_compliance_id": {
      "type": "string",
      "description": "ID of this asset in the GC Compliance Manager app \u2014 used to cross-reference compliance records during the one-time import."
    },
    "panda_asset_id": {
      "type": "string",
      "description": "ID of this asset in Asset Panda \u2014 used by the scheduled sync to match inventory records and pull live stock levels and warehouse locations."
    },
    "panda_group_label": {
      "type": "string",
      "description": "Label of the Asset Panda group this asset was synced from (e.g. 'Rigs', 'Lifting Gear'). Set during multi-group sync so the Assets Hub can filter assets by their source group. Blank for manually-created assets and legacy single-group syncs."
    },
    "panda_image_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Direct S3 URL to the full-size image (the Asset Panda 'large' / 'url' field)."
          },
          "thumb": {
            "type": "string",
            "description": "Direct S3 URL to the thumbnail-sized image."
          },
          "medium": {
            "type": "string",
            "description": "Direct S3 URL to the medium-sized image."
          },
          "large": {
            "type": "string",
            "description": "Direct S3 URL to the large-sized image."
          },
          "name": {
            "type": "string",
            "description": "Original filename of the image in Asset Panda."
          }
        },
        "required": [
          "url"
        ]
      },
      "default": [],
      "description": "Cached image attachments pulled from Asset Panda for this asset (GET /v3/attachments?entity_object_id=<panda_asset_id>&type=Image). Refreshed on demand by the getAssetPandaImages backend function so the asset detail page gallery loads instantly without re-hitting the Asset Panda API on every view."
    },
    "panda_images_cached_at": {
      "type": "string",
      "description": "ISO timestamp of the last successful Asset Panda image fetch cached on this record."
    },
    "panda_raw_fields": {
      "type": "object",
      "description": "All raw Asset Panda field values pulled from the source object during sync, stored as a label \u2192 value map so no data is lost. Every field on the Asset Panda object (excluding system/id keys) is captured here, even if it doesn't map to a named SiteAsset field. Visible to admins in the asset detail drawer's 'Raw Asset Panda Data' collapsible section.",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "daily_billing_rate": {
      "type": "number",
      "description": "DEPRECATED \u2014 do not use for billing. Asset Panda is for inventory stock levels and warehouse locations only, not pricing. All rig, crew, plant and labour prices come from the Master Price List (RateCardItem) via the rate card matcher. This field is retained for backward compatibility only."
    },
    "cost_price": {
      "type": "number",
      "description": "Internal cost price for this asset in GBP, pulled from Asset Panda via the mapped 'cost_price' field. Used as the fallback price in the billable-items catalogue when no rate card item is linked. The rate card (Master Price List) always takes precedence over this value when a link is confirmed."
    },
    "charge_out_price": {
      "type": "number",
      "description": "Optional charge-out (sell) price for this asset in GBP, pulled from Asset Panda. When set and no rate card item is linked, this is shown as the charge-out in the billable-items catalogue. Most pricing should come from the rate card; this is a fallback for assets with no rate card match."
    },
    "rate_card_item_id": {
      "type": "string",
      "description": "Linked RateCardItem from the Master Price List. Auto-confirmed during sync via fuzzy name match (rate_card_link_status='confirmed'), so the rate card price takes precedence over the Asset Panda cost_price in the billable-items catalogue. Blank for assets with no rate card match."
    },
    "rate_card_link_status": {
      "type": "string",
      "enum": [
        "unmatched",
        "proposed",
        "confirmed",
        "skipped"
      ],
      "default": "unmatched",
      "description": "Status of the rate-card link for this asset. 'unmatched' = no match found, 'proposed' = auto-match awaiting admin confirmation (legacy), 'confirmed' = auto-confirmed link (rate card price wins), 'skipped' = admin chose to skip the match and use the Asset Panda cost as the fallback."
    },
    "stock_level": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock",
        "needs_service",
        "unknown"
      ],
      "default": "unknown",
      "description": "Live stock/condition quality from Asset Panda. 'needs_service' or 'out_of_stock' items are auto-deactivated and cannot be added to jobs."
    },
    "quantity_owned": {
      "type": "number",
      "description": "Total quantity of this asset that Ground Control owns, pulled from Asset Panda's 'Quantity Owned' field. For single-unit assets typically 1; for stock-pool items (slings, consumables) it's the total held. Used as the ceiling when incrementing Quantity Available on book-in."
    },
    "quantity_available": {
      "type": "number",
      "description": "Quantity currently available in the yard (not out on a job), pulled from Asset Panda's 'Quantity Available' field. Decremented by the signed-out qty on book-out (floored at 0) and incremented by the returned qty on book-in (capped at quantity_owned), with the new value pushed back to Asset Panda. Shown on asset cards as 'available / owned'."
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "failed",
        "never"
      ],
      "default": "never",
      "description": "Last Asset Panda sync outcome. 'synced' = latest data pulled, 'pending' = queued, 'failed' = last sync errored, 'never' = not yet synced."
    },
    "last_sync_timestamp": {
      "type": "string",
      "description": "ISO timestamp of the last successful Asset Panda sync for this asset."
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "expiring",
        "expired",
        "unknown"
      ],
      "default": "unknown",
      "description": "Current compliance status. Auto-derived by the Asset Panda sync from pulled inspection/expiry dates (compliant >30d, expiring \u226430d, expired past), and also updated when a LOLER, PUWER or PAT inspection is logged via the service history."
    },
    "compliance_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Date the asset's compliance expires (next LOLER/PUWER/PAT test due). Auto-detected from Asset Panda fields labelled 'Next Inspection', 'Expiry', 'LOLER', 'PAT', etc."
    },
    "compliance_last_checked": {
      "type": "string",
      "description": "ISO timestamp of when the compliance status was last updated."
    },
    "last_service_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the last service / inspection carried out on this asset. Auto-detected from Asset Panda fields labelled 'Last Service', 'Last Inspected', etc. Shown on the Asset Passport maintenance timeline."
    },
    "next_service_date": {
      "type": "string",
      "format": "date",
      "description": "Date the next service is due. Auto-detected from Asset Panda fields labelled 'Next Service', 'Service Due', etc. Drives the maintenance_status indicator on the Asset Passport."
    },
    "service_notes": {
      "type": "string",
      "description": "Free-text notes from the last service/inspection carried out on this asset."
    },
    "repair_notes": {
      "type": "string",
      "description": "Free-text notes describing repair history or faults recorded for this asset."
    },
    "maintenance_status": {
      "type": "string",
      "enum": [
        "ok",
        "due_soon",
        "overdue",
        "unknown"
      ],
      "default": "unknown",
      "description": "Derived maintenance status. Auto-derived by the Asset Panda sync from pulled next-service dates (ok >30d, due_soon \u226430d, overdue past). Also driven by operating hours for rigs/plant via the recalculateUsageMaintenance function. 'unknown' = no service data recorded."
    },
    "operating_hours": {
      "type": "number",
      "default": 0,
      "description": "Total accumulated engine operating hours for this asset (rigs and plant). Calculated by the recalculateUsageMaintenance function from drilling-duration minutes logged against jobs this asset is assigned to. Reset to 0 when a service is logged. Also feeds units-of-production depreciation as the units_produced_to_date."
    },
    "hours_since_last_service": {
      "type": "number",
      "default": 0,
      "description": "Engine hours accumulated since the last service. Calculated as operating_hours minus the hours recorded at the last service. When this exceeds service_interval_hours, the asset is flagged 'due_soon' for a usage-based service."
    },
    "service_interval_hours": {
      "type": "number",
      "description": "Usage-based service interval in engine hours. When hours_since_last_service exceeds this value, the asset is flagged for service. Default 250h for rigs, 500h for heavy machinery. Blank for assets that use date-based maintenance (vehicles, trailers, lifting gear, PAT)."
    },
    "hours_at_last_service": {
      "type": "number",
      "default": 0,
      "description": "Operating hours reading at the time of the last service. Used to calculate hours_since_last_service = operating_hours - hours_at_last_service. Set when a service record is logged."
    },
    "last_usage_calc_at": {
      "type": "string",
      "description": "ISO timestamp of the last usage-hours recalculation run. Set by the recalculateUsageMaintenance function."
    },
    "responsible_person": {
      "type": "string",
      "description": "Person responsible for this asset \u2014 the lead driller who keeps it with them, or the yard manager for yard-held equipment."
    },
    "storage_location": {
      "type": "string",
      "description": "Where the asset lives when not on a job \u2014 e.g. 'Dartford Depot' (yard), a rig name, or a person. Pulled from GC Compliance Manager's location field. Used by the yard/assignment view to group yard-held equipment."
    },
    "weight_kg": {
      "type": "number",
      "description": "Weight of this asset in kilograms. Used for vehicle capacity checks when booking equipment onto a delivery vehicle. Optional \u2014 leave blank if unknown."
    },
    "volume_m3": {
      "type": "number",
      "description": "Volume of this asset in cubic metres. Used for vehicle capacity checks when booking equipment onto a delivery vehicle. Optional \u2014 leave blank if unknown."
    },
    "tooling_notes": {
      "type": "string",
      "description": "Associated tooling for this rig/equipment (e.g. casing sizes, augers, core barrels)."
    },
    "linked_equipment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of SiteAsset equipment (lifting gear, machinery, trailers) linked to this rig \u2014 shown when assigning the rig to a job for quick bulk assignment."
    },
    "child_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of child SiteAsset records manually linked to this asset for the rig certificate drill-down view. Each linked child appears as a mini-card with its own compliance status in the rig's certificate hero. Managed via the 'Link Child Assets' panel in the asset detail drawer."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is available for job assignment. Automatically set to false when Asset Panda reports it out of stock or needing service."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this asset."
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false,
      "description": "True when this asset was created by the Demo Data Manager for showcase purposes. Sync functions (Asset Panda, GC Compliance Manager) skip demo assets so they are never pushed to or purged from external systems."
    },
    "acquisition_date": {
      "type": "string",
      "format": "date",
      "description": "Date the asset was purchased or acquired. Used as the start of the depreciation schedule and to calculate asset age."
    },
    "acquisition_cost": {
      "type": "number",
      "description": "Original purchase cost in GBP. Used as the baseline for depreciation calculations across all three methods."
    },
    "depreciation_years": {
      "type": "number",
      "description": "Useful life of the asset in years for depreciation purposes (e.g. 10 for a rig, 5 for a trailer, 3 for portable equipment). Used by straight-line and reducing-balance methods."
    },
    "current_book_value": {
      "type": "number",
      "description": "Calculated current book value after depreciation from acquisition_date. Auto-calculated by the recalculateDepreciation function based on the selected depreciation_method. Updated whenever the method, rate, units, or acquisition details change."
    },
    "depreciation_method": {
      "type": "string",
      "enum": [
        "straight_line",
        "reducing_balance",
        "units_of_production"
      ],
      "default": "straight_line",
      "description": "Depreciation method for this asset. 'straight_line' = equal annual charge (cost - salvage) / useful_life_years; 'reducing_balance' = fixed depreciation_rate % applied to remaining book value each year; 'units_of_production' = charge per unit of usage (operating hours) against units_estimated_total. Auto-set from the matching DepreciationProfile on creation; overridable per-asset."
    },
    "depreciation_rate": {
      "type": "number",
      "description": "Annual depreciation rate % for the reducing-balance method (e.g. 25 = 25% of remaining book value per year). Ignored for straight-line and units-of-production."
    },
    "units_estimated_total": {
      "type": "number",
      "description": "Total estimated production units over the asset's life (units-of-production method only). E.g. 10000 hours for a rig. The per-unit depreciation = (acquisition_cost - salvage_value) / units_estimated_total."
    },
    "units_produced_to_date": {
      "type": "number",
      "description": "Production units consumed to date (units-of-production method only). Auto-synced from operating_hours by the recalculateUsageMaintenance function. Accumulated depreciation = units_produced_to_date \u00d7 cost_per_unit."
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Depreciation charge per production unit (units-of-production method only). Auto-calculated as (acquisition_cost - salvage_value) / units_estimated_total."
    },
    "annual_depreciation": {
      "type": "number",
      "description": "Current annual depreciation charge for this asset. Auto-calculated by recalculateDepreciation. For straight-line = (cost - salvage) / years; for reducing-balance = book_value \u00d7 rate%; for units-of-production = cost_per_unit \u00d7 units produced this year."
    },
    "accumulated_depreciation": {
      "type": "number",
      "description": "Total depreciation accumulated to date. Auto-calculated by recalculateDepreciation. Equals acquisition_cost - current_book_value."
    },
    "depreciation_profile_id": {
      "type": "string",
      "description": "The DepreciationProfile that seeded this asset's depreciation settings. Set on creation; cleared if the admin manually overrides the method or parameters."
    },
    "salvage_value": {
      "type": "number",
      "description": "Estimated residual/salvage value at end of useful life (GBP). The asset won't depreciate below this value."
    },
    "replacement_date": {
      "type": "string",
      "format": "date",
      "description": "Planned replacement date for this asset. Drives replacement planning alerts when the date is within 90 days."
    },
    "replacement_cost_estimate": {
      "type": "number",
      "description": "Estimated cost to replace this asset with an equivalent new model (GBP). Used for capital expenditure planning."
    },
    "disposal_date": {
      "type": "string",
      "format": "date",
      "description": "Date the asset was disposed of (sold, scrapped, or traded in). Set when lifecycle_status moves to 'disposed'."
    },
    "disposal_value": {
      "type": "number",
      "description": "Amount received (GBP) when the asset was sold or traded in. Negative if disposal cost money (scrapping)."
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "aging",
        "due_for_replacement",
        "disposed"
      ],
      "default": "active",
      "description": "Asset lifecycle stage. 'active' = in service and within useful life, 'aging' = past useful life but still operational, 'due_for_replacement' = replacement date within 90 days or past useful life with high maintenance costs, 'disposed' = sold/scrapped/traded in (asset deactivated)."
    }
  },
  "required": [
    "name",
    "asset_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}