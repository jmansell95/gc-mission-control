{
  "name": "Contractor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sub-contractor company or individual name"
    },
    "division_id": {
      "type": "string",
      "description": "The division this contractor belongs to. Set automatically from the active division when the contractor is created. Drives division-scoped filtering \u2014 a division only sees its own contractors. Blank = unassigned (visible to enterprise admins only)."
    },
    "contractor_type": {
      "type": "string",
      "enum": [
        "subcontractor",
        "agency"
      ],
      "default": "subcontractor",
      "description": "Type of external entity. 'subcontractor' = a company or individual that carries out work directly (drilling, groundworks, etc.). 'agency' = a labour supply company that provides workers to us on a temporary basis \u2014 we direct the labourer's daily work but pay the agency, not the individual."
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person (legacy single-contact field, kept for backward compatibility). Prefer the 'contacts' array for multiple contacts."
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email address (legacy single-contact field)."
    },
    "contact_phone": {
      "type": "string",
      "description": "Contact phone number (legacy single-contact field)."
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Contact person name"
          },
          "role": {
            "type": "string",
            "description": "Contact role/job title (e.g. Operations Director, Site Agent)"
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number"
          },
          "email": {
            "type": "string",
            "description": "Contact email address"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about this contact"
          }
        },
        "required": [
          "name"
        ]
      },
      "default": [],
      "description": "All contacts for this sub-contractor/agency \u2014 unlimited, no primary designation. Each entry has name, role, phone, email, notes. Used for comms and onboarding portal recipient selection."
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending",
        "documents_requested",
        "under_review",
        "approved",
        "rejected",
        "suspended"
      ],
      "default": "pending",
      "description": "Onboarding lifecycle. 'pending' = new lead not yet contacted; 'documents_requested' = onboarding link sent; 'under_review' = documents returned, awaiting approval; 'approved' = cleared to work on jobs; 'rejected' = failed checks; 'suspended' = previously approved but stopped (insurance lapsed, performance, etc.)."
    },
    "services_offered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Work this sub-contractor carries out (e.g. ['drilling','groundworks','enabling','coring','trial_pit','depot']). Used to match them to jobs needing that skill."
    },
    "company_reg_number": {
      "type": "string",
      "description": "Companies House registration number"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number"
    },
    "hse_registration": {
      "type": "string",
      "description": "HSE / UKAS / other regulatory registration reference"
    },
    "accreditations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "chas",
          "constructionline",
          "smas",
          "safecontractor",
          "iso9001",
          "iso14001",
          "iso45001",
          "achilles",
          "other"
        ]
      },
      "default": [],
      "description": "Pre-qualification & accreditation schemes the sub-contractor holds (CHAS, Constructionline, SMAS, SafeContractor, ISO 9001/14001/45001, Achilles)."
    },
    "insurance_provider": {
      "type": "string",
      "description": "Name of the insurer providing public liability & professional indemnity cover"
    },
    "insurance_policy_number": {
      "type": "string",
      "description": "Public liability / combined liability policy number"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "description": "Expiry date of the public liability insurance policy. A safety alert flags any approved sub-contractor whose insurance has expired."
    },
    "public_liability_limit": {
      "type": "number",
      "description": "Public liability cover limit in GBP (e.g. 5000000 = \u00a35m)"
    },
    "employers_liability_limit": {
      "type": "number",
      "description": "Employers liability cover limit in GBP (e.g. 10000000 = \u00a310m)"
    },
    "professional_indemnity_limit": {
      "type": "number",
      "description": "Professional indemnity cover limit in GBP"
    },
    "safetyculture_email": {
      "type": "string",
      "description": "SafetyCulture (iAuditor) account email for this sub-contractor. Audits submitted from this email are auto-linked to this contractor record."
    },
    "safetyculture_user_id": {
      "type": "string",
      "description": "SafetyCulture user ID, auto-captured when an audit webhook matches this contractor by email."
    },
    "onboarding_token": {
      "type": "string",
      "description": "Unique token for the sub-contractor onboarding portal link. Generated when an onboarding request is sent."
    },
    "onboarding_sent_at": {
      "type": "string",
      "description": "ISO timestamp when the onboarding request link was last sent to the sub-contractor."
    },
    "onboarding_completed_at": {
      "type": "string",
      "description": "ISO timestamp when the sub-contractor submitted their onboarding details via the portal link."
    },
    "approved_by_name": {
      "type": "string",
      "description": "Name of the manager who approved this sub-contractor's onboarding"
    },
    "approved_at": {
      "type": "string",
      "description": "ISO timestamp when the sub-contractor was approved"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason recorded when a sub-contractor is rejected or suspended"
    },
    "default_daily_rate": {
      "type": "number",
      "description": "Default daily charge rate for this sub-contractor's crew (used as a fallback when billing a job they worked on)"
    },
    "utr": {
      "type": "string",
      "description": "Unique Taxpayer Reference (UTR) \u2014 10-digit HMRC reference required for CIS verification."
    },
    "nino": {
      "type": "string",
      "description": "National Insurance Number (required for individual CIS verification, not partnerships/companies)."
    },
    "cis_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified_net",
        "verified_gross",
        "unknown",
        "failed"
      ],
      "default": "pending",
      "description": "HMRC CIS verification result. 'verified_net' = 30% deduction applies, 'verified_gross' = paid gross (0% deduction), 'unknown' = subcontractor not found in HMRC records, 'failed' = verification error, 'pending' = not yet verified."
    },
    "cis_tax_rate": {
      "type": "number",
      "description": "CIS deduction tax rate (%) determined by HMRC verification. 30 = net payer (30% deducted), 20 = gross payer at higher rate, 0 = gross payer (no deduction)."
    },
    "cis_verification_number": {
      "type": "string",
      "description": "HMRC CIS verification reference number returned when verification succeeds."
    },
    "cis_verified_at": {
      "type": "string",
      "description": "ISO timestamp of the last HMRC CIS verification."
    },
    "cis_verified_by": {
      "type": "string",
      "description": "Name of the user who last ran CIS verification for this sub-contractor."
    },
    "portal_user_id": {
      "type": "string",
      "description": "The platform user ID linked to this contractor's contact for secure portal login. Set when the contractor is invited via the secure-login mode in the job Links tab. When set, the user can log in and see all jobs where they are the contractor."
    },
    "portal_invited_at": {
      "type": "string",
      "description": "ISO timestamp of when the secure portal login invite was last sent to this contractor's contact."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.division_id": "{{user.data.division_id}}"
        },
        {
          "data.division_id": null
        },
        {
          "data.division_id": {
            "$in": "{{user.data.managed_division_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "is_enterprise_admin": true
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}